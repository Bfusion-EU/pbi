          },
          {
            "name": "Finance | Cumulative Actual Cost",
            "description": "Subject area: Finance.",
            "expression": [
              "VAR MaxDate = MAX('Calendar'[Date])  //  'Costs'[Date]) ",
              "RETURN",
              "    CALCULATE (",
              "        [Finance | Actual Cost],         ",
              "        'Calendar'[Date] <= MaxDate,  ",
              "        ALL ( 'Calendar'[Date] )         ",
              "    )"
            ],
            "displayFolder": "Finance",
            "lineageTag": "d03be9eb-35d1-4273-beeb-cd484e291048",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Finance | Cumulative Budget Cost",
            "description": "Subject area: Finance.",
            "expression": [
              "",
              "VAR MaxDate = MAX('Calendar'[Date])  //  'Costs'[Date]) ",
              "RETURN",
              "    CALCULATE (",
              "        [Finance | Budget Cost],           ",
              "        'Calendar'[Date] <= MaxDate,  ",
