        "partitions": [
          {
            "name": "Plan_Portfolio",
            "mode": "import",
            "queryGroup": "Plans",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    Plan_Portfolio_table = Source{[Name=\"Plan_Portfolio\",Signature=\"table\"]}[Data],",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Plan_Portfolio_table,{\"Id\", \"Name\", \"ProcessStep\", \"ProcessStepStart\", \"ProcessStepIndex\", \"PlanId\", \"State_Value\", \"Budget\", \"EstimatedStart\", \"EstimatedEnd\", \"Manager_Value\", \"ProjectType_Value\", \"BusinessUnit_Value\", \"Forecast\", \"RemainingBudget\", \"BudgetVariance\", \"Benefits\", \"ROI\", \"CommittedEffort\", \"ScheduledEffort\", \"RemainingEffort\", \"EffortVariance\", \"OverallHealth_Value\", \"ScheduleHealth_Value\", \"FinancialHealth_Value\", \"EffortHealth_Value\", \"IssueHealth_Value\", \"PrioritizationScore\", \"Actuals\", \"Goals_Value\", \"ProgramBudget\", \"RemainingBudgetAllocation\", \"ActiveRisks\", \"ActiveIssues\", \"ActiveChanges\", \"CostofDelay\", \"ActiveIssuesTrend\", \"ActiveChangesTrend\", \"TargetMargin\", \"InvoicedAmount\", \"ScopeHealth_Value\", \"OverallHealthStatus\", \"ScopeHealthStatus\",  \"IssueHealthStatus\", \"EffortHealthStatus\", \"ScheduleHealthStatus\", \"EstimatedCost\", \"ActualCost\", \"EstimatedRevenue\", \"EstimatedRevenueTrend\", \"EstimatedProfit\", \"EstimatedProfitTrend\", \"ActualRevenue\", \"BudgetUsed\", \"Margin\", \"ActualMargin\", \"MarginVariance\", \"PlansEstimatedCost\", \"PlansEstimatedProfit\", \"PlansEstimatedRevenue\", \"PlansEstimatedCostTrend\", \"PlansEstimatedProfitTrend\", \"PlansEstimatedRevenueTrend\" }),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Other Columns\",{ {\"ProcessStepStart\", type date}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "annotations": [
