        "partitions": [
          {
            "name": "New Calculated Table",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "    \"MenuItem\",   STRING,",
                "    \"Group\",      STRING,",
                "    \"PageId\",     STRING,",
                "    \"Icon\",       STRING,",
                "    \"SortOrder\",  INTEGER,",
                "    {",
                "        { \"Overview\",          \"MAIN\",       \"overview\",      \"home\",      1 },",
                "        { \"Portfolio Health\",  \"MAIN\",       \"health\",        \"dashboard\", 2 },",
                "        { \"Roadmap\",           \"MAIN\",       \"roadmap\",       \"chart\",     3 },",
                "        { \"Risk Matrix\",       \"ANALYSIS\",   \"risk\",          \"risk\",      4 },",
                "        { \"Resource Forecast\", \"ANALYSIS\",   \"resources\",     \"users\",     5 },",
                "        { \"Financial S-Curve\", \"FINANCE\",    \"scurve\",        \"money\",     6 },",
                "        { \"Settings\",          \"\",           \"settings\",      \"settings\",  7 }",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
