                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Resource | KPI Strip HTML copy",
            "description": "Subject area: Resource.",
            "expression": [
              "VAR _capacity = FORMAT([Capacity | Resource Capacity], \"#,##0\")",
              "VAR _scheduled = FORMAT([Capacity | Total Hours Scheduled], \"#,##0\")",
              "VAR _gap = FORMAT([Capacity | Resource Demand-Supply Gap], \"#,##0\")",
              "VAR _util = FORMAT([Capacity | Avg Utilization Across Resources], \"0.0%\")",
              "VAR _bench = FORMAT([Capacity | Bench Count], \"0\")",
              "VAR _fte = FORMAT([Resource | Capacity FTE], \"0.0\")",
              "VAR _utilRaw = [Capacity | Avg Utilization Across Resources]",
              "",
              "VAR _needleAngle = -90 + (MIN(MAX(_utilRaw, 0), 1.5) / 1.5) * 180",
              "VAR _arcOffset = 251.2 - (MIN(MAX(_utilRaw, 0), 1.5) / 1.5) * 251.2",
              "VAR _arcColor = IF(_utilRaw > 1, \"#ef4444\", IF(_utilRaw >= 0.7, \"#10b981\", IF(_utilRaw >= 0.3, \"#f59e0b\", \"#ef4444\")))",
              "",
              "VAR _lt = \"<\"",
              "VAR _gt = \">\"",
              "VAR _q = \"\"\"\"",
              "VAR _nl = \"",
              "\"",
              "",
              "-- UPDATED CSS: Font sizes increased in .kpi-label, .kpi-value, .kpi-sub, .g-lbl, .g-val, and .s-title",
              "VAR _css = _lt & \"style\" & _gt & \"* {margin:0;padding:0;box-sizing:border-box;} .wrap {font-family:'Segoe UI',sans-serif;background:transparent;color:#111827;padding:12px;display:flex;flex-direction:column;gap:12px;min-height:100%;} .kpi-strip {display:flex;gap:10px;flex-wrap:wrap;} .kpi-card {background:transparent;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;flex:1;min-width:120px;position:relative;overflow:hidden;} .kpi-card::before {content:'';position:absolute;top:0;left:0;width:4px;height:100%;border-radius:8px 0 0 8px;} .c-blue::before{background:#3b82f6} .c-green::before{background:#10b981} .c-amber::before{background:#f59e0b} .c-red::before{background:#ef4444} .c-purple::before{background:#8b5cf6} .kpi-label {font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#6b7280;margin-bottom:4px;} .kpi-value {font-size:22px;font-weight:700;letter-spacing:-0.5px;} .kpi-sub {font-size:11px;color:#6b7280;margin-top:4px;} .gauge-box {background:transparent;border:1px solid #e5e7eb;border-radius:8px;padding:16px;display:flex;align-items:center;gap:20px;} .g-legend {display:flex;flex-direction:column;gap:6px;margin-top:6px;} .g-row {display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:#f9fafb;border-radius:4px;} .g-lbl {display:flex;align-items:center;gap:8px;font-size:12px;color:#4b5563;} .g-dot {width:8px;height:8px;border-radius:50%;display:inline-block;} .g-val {font-size:14px;font-weight:600;} .s-title {font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#4b5563;margin-bottom:4px;}\" & _lt & \"/style\" & _gt",
              "",
              "VAR _kpiStrip = _lt & \"div class=\" & _q & \"wrap\" & _q & _gt & _lt & \"div class=\" & _q & \"s-title\" & _q & _gt & \"Executive Capacity Overview\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-strip\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-card c-blue\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-label\" & _q & _gt & \"Total Capacity\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-value\" & _q & \" style=\" & _q & \"color:#3b82f6\" & _q & _gt & _capacity & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-sub\" & _q & _gt & \"hours available\" & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-card c-green\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-label\" & _q & _gt & \"Scheduled Hours\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-value\" & _q & \" style=\" & _q & \"color:#10b981\" & _q & _gt & _scheduled & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-sub\" & _q & _gt & \"hours allocated\" & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-card c-amber\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-label\" & _q & _gt & \"Demand-Supply Gap\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-value\" & _q & \" style=\" & _q & \"color:#f59e0b\" & _q & _gt & _gap & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-sub\" & _q & _gt & \"surplus / deficit\" & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-card c-purple\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-label\" & _q & _gt & \"Avg Utilization\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-value\" & _q & \" style=\" & _q & \"color:#8b5cf6\" & _q & _gt & _util & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-sub\" & _q & _gt & \"across resources\" & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-card c-red\" & _q & _gt & _lt & \"div class=\" & _q & \"kpi-label\" & _q & _gt & \"Bench Count\" & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-value\" & _q & \" style=\" & _q & \"color:#ef4444\" & _q & _gt & _bench & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"kpi-sub\" & _q & _gt & \"of \" & _fte & \" FTEs\" & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt",
              "",
              "-- UPDATED GAUGE: Increased SVG text font-size to 12 and utilization display to 28px",
              "VAR _gauge = _lt & \"div class=\" & _q & \"gauge-box\" & _q & _gt & ",
              "    _lt & \"svg width=\" & _q & \"160\" & _q & \" height=\" & _q & \"96\" & _q & \" viewBox=\" & _q & \"0 0 200 120\" & _q & _gt & ",
              "    _lt & \"path d=\" & _q & \"M 20 100 A 80 80 0 0 1 180 100\" & _q & \" fill=\" & _q & \"none\" & _q & \" stroke=\" & _q & \"#f3f4f6\" & _q & \" stroke-width=\" & _q & \"14\" & _q & \" stroke-linecap=\" & _q & \"round\" & _q & \"/\" & _gt & ",
              "    _lt & \"path d=\" & _q & \"M 20 100 A 80 80 0 0 1 180 100\" & _q & \" fill=\" & _q & \"none\" & _q & \" stroke=\" & _q & _arcColor & _q & \" stroke-width=\" & _q & \"14\" & _q & \" stroke-linecap=\" & _q & \"round\" & _q & \" stroke-dasharray=\" & _q & \"251.2\" & _q & \" stroke-dashoffset=\" & _q & FORMAT(_arcOffset, \"0.0\") & _q & \"/\" & _gt & ",
              "    ",
              "    _lt & \"line x1=\" & _q & \"100\" & _q & \" y1=\" & _q & \"20\" & _q & \" x2=\" & _q & \"100\" & _q & \" y2=\" & _q & \"12\" & _q & \" stroke=\" & _q & \"#d1d5db\" & _q & \" stroke-width=\" & _q & \"2\" & _q & \" transform=\" & _q & \"rotate(-90,100,100)\" & _q & \"/\" & _gt & ",
              "    _lt & \"line x1=\" & _q & \"100\" & _q & \" y1=\" & _q & \"20\" & _q & \" x2=\" & _q & \"100\" & _q & \" y2=\" & _q & \"12\" & _q & \" stroke=\" & _q & \"#d1d5db\" & _q & \" stroke-width=\" & _q & \"2\" & _q & \" transform=\" & _q & \"rotate(-30,100,100)\" & _q & \"/\" & _gt & ",
              "    _lt & \"line x1=\" & _q & \"100\" & _q & \" y1=\" & _q & \"20\" & _q & \" x2=\" & _q & \"100\" & _q & \" y2=\" & _q & \"12\" & _q & \" stroke=\" & _q & \"#9ca3af\" & _q & \" stroke-width=\" & _q & \"3\" & _q & \" transform=\" & _q & \"rotate(30,100,100)\" & _q & \"/\" & _gt & ",
              "    _lt & \"line x1=\" & _q & \"100\" & _q & \" y1=\" & _q & \"20\" & _q & \" x2=\" & _q & \"100\" & _q & \" y2=\" & _q & \"12\" & _q & \" stroke=\" & _q & \"#d1d5db\" & _q & \" stroke-width=\" & _q & \"2\" & _q & \" transform=\" & _q & \"rotate(90,100,100)\" & _q & \"/\" & _gt & ",
              "",
              "    _lt & \"line x1=\" & _q & \"100\" & _q & \" y1=\" & _q & \"100\" & _q & \" x2=\" & _q & \"100\" & _q & \" y2=\" & _q & \"30\" & _q & \" stroke=\" & _q & \"#4b5563\" & _q & \" stroke-width=\" & _q & \"2\" & _q & \" transform=\" & _q & \"rotate(\" & FORMAT(_needleAngle, \"0.0\") & \",100,100)\" & _q & \"/\" & _gt & ",
              "    _lt & \"circle cx=\" & _q & \"100\" & _q & \" cy=\" & _q & \"100\" & _q & \" r=\" & _q & \"5\" & _q & \" fill=\" & _q & \"#4b5563\" & _q & \"/\" & _gt & ",
              "    ",
              "    _lt & \"text x=\" & _q & \"20\" & _q & \" y=\" & _q & \"116\" & _q & \" fill=\" & _q & \"#6b7280\" & _q & \" font-size=\" & _q & \"12\" & _q & \" text-anchor=\" & _q & \"middle\" & _q & _gt & \"0%\" & _lt & \"/text\" & _gt & ",
              "    _lt & \"text x=\" & _q & \"50\" & _q & \" y=\" & _q & \"16\" & _q & \" fill=\" & _q & \"#6b7280\" & _q & \" font-size=\" & _q & \"12\" & _q & \" text-anchor=\" & _q & \"middle\" & _q & _gt & \"50%\" & _lt & \"/text\" & _gt & ",
              "    _lt & \"text x=\" & _q & \"150\" & _q & \" y=\" & _q & \"16\" & _q & \" fill=\" & _q & \"#374151\" & _q & \" font-size=\" & _q & \"12\" & _q & \" font-weight=\" & _q & \"bold\" & _q & \" text-anchor=\" & _q & \"middle\" & _q & _gt & \"100%\" & _lt & \"/text\" & _gt & ",
              "    _lt & \"text x=\" & _q & \"180\" & _q & \" y=\" & _q & \"116\" & _q & \" fill=\" & _q & \"#6b7280\" & _q & \" font-size=\" & _q & \"12\" & _q & \" text-anchor=\" & _q & \"middle\" & _q & _gt & \"150%\" & _lt & \"/text\" & _gt & ",
              "    _lt & \"/svg\" & _gt & _lt & \"div style=\" & _q & \"flex:1\" & _q & _gt & _lt & \"div style=\" & _q & \"font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:1px\" & _q & _gt & \"Utilization Gauge\" & _lt & \"/div\" & _gt & _lt & \"div style=\" & _q & \"font-size:28px;font-weight:700;color:#3b82f6;margin:2px 0\" & _q & _gt & _util & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"g-legend\" & _q & _gt & _lt & \"div class=\" & _q & \"g-row\" & _q & _gt & _lt & \"span class=\" & _q & \"g-lbl\" & _q & _gt & _lt & \"span class=\" & _q & \"g-dot\" & _q & \" style=\" & _q & \"background:#3b82f6\" & _q & _gt & _lt & \"/span\" & _gt & \"Capacity\" & _lt & \"/span\" & _gt & _lt & \"span class=\" & _q & \"g-val\" & _q & \" style=\" & _q & \"color:#3b82f6\" & _q & _gt & _capacity & _lt & \"/span\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"g-row\" & _q & _gt & _lt & \"span class=\" & _q & \"g-lbl\" & _q & _gt & _lt & \"span class=\" & _q & \"g-dot\" & _q & \" style=\" & _q & \"background:#10b981\" & _q & _gt & _lt & \"/span\" & _gt & \"Scheduled\" & _lt & \"/span\" & _gt & _lt & \"span class=\" & _q & \"g-val\" & _q & \" style=\" & _q & \"color:#10b981\" & _q & _gt & _scheduled & _lt & \"/span\" & _gt & _lt & \"/div\" & _gt & _lt & \"div class=\" & _q & \"g-row\" & _q & _gt & _lt & \"span class=\" & _q & \"g-lbl\" & _q & _gt & _lt & \"span class=\" & _q & \"g-dot\" & _q & \" style=\" & _q & \"background:#f59e0b\" & _q & _gt & _lt & \"/span\" & _gt & \"Gap\" & _lt & \"/span\" & _gt & _lt & \"span class=\" & _q & \"g-val\" & _q & \" style=\" & _q & \"color:#f59e0b\" & _q & _gt & _gap & _lt & \"/span\" & _gt & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt & _lt & \"/div\" & _gt",
              "",
              "RETURN _css & _kpiStrip & _gauge"
            ],
