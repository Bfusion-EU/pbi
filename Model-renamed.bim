        "partitions": [
          {
            "name": "Plan_Programs",
            "mode": "import",
            "queryGroup": "Plans",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    Plan_Program_table = Source{[Name=\"Plan_Program\",Signature=\"table\"]}[Data],",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Plan_Program_table,{\"Id\", \"Name\", \"ProcessStep\", \"ProcessStepStart\", \"PlanId\", \"PortfolioPriority\", \"State_Value\", \"Priority_Value\", \"Budget\", \"EstimatedStart\", \"EstimatedEnd\", \"ExecutiveSponsor_Value\", \"Manager_Value\", \"BusinessUnit_Value\", \"Forecast\", \"RemainingBudget\", \"BudgetVariance\", \"Benefits\", \"ROI\", \"CommittedEffort\", \"ScheduledEffort\", \"RemainingEffort\", \"OverallHealth_Value\", \"ScheduleHealth_Value\", \"FinancialHealth_Value\", \"EffortHealth_Value\", \"IssueHealth_Value\", \"StrategicAlignment_Value\", \"LowerCost_Value\", \"ImproveEmployeeRetention_Value\", \"Risk_Value\", \"Actuals\", \"Goals_Value\", \"PlanType_EnterpriseProject_Id\", \"PlanType_EnterpriseProject_Value\", \"PlanType_Program_Id\", \"PlanType_Program_Value\", \"ProgramBudget\", \"RemainingBudgetAllocation\", \"ActiveRisks\", \"ActiveIssues\", \"ActiveChanges\", \"TasksinProgress\", \"TasksAtRisks\", \"TasksOffTrack\", \"BusinessValue_Value\", \"RiskReduction_Value\", \"TimeCriticality_Value\", \"CostofDelay\", \"PlanType_Objective_Value\", \"Status_Value\", \"RequestedBy_Value\", \"AssociatedPortfolio_Value\", \"AssociatedPrograms_Value\", \"ApprovalStatus_Value\", \"ActiveIssuesTrend\", \"ActiveChangesTrend\", \"AssociatedInitiatives_Value\", \"AccountExecutive_Value\", \"ContractAmount\", \"ContractVariance\", \"TargetMargin\", \"ContractHours\", \"InvoicedAmount\", \"ScopeHealth_Value\", \"OverallHealthStatus\", \"ScopeHealthStatus\", \"IssueHealthStatus\", \"EffortHealthStatus\", \"ScheduleHealthStatus\", \"ContractAmountTrend\", \"EstimatedCost\", \"ActualCost\", \"EstimatedRevenue\", \"EstimatedRevenueTrend\", \"EstimatedProfit\", \"EstimatedProfitTrend\", \"ActualRevenue\", \"BudgetUsed\", \"Margin\", \"ActualMargin\", \"MarginVariance\", \"PlansEstimatedCost\", \"PlansEstimatedProfit\", \"PlansEstimatedRevenue\", \"PlansEstimatedCostTrend\", \"PlansEstimatedProfitTrend\", \"PlansEstimatedRevenueTrend\",    \"Summary_PercentDone\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Other Columns\",{ {\"ProcessStepStart\", type date}, {\"EstimatedStart\", type date}, {\"EstimatedEnd\", type date}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Exception"
          }
        ]
      },
      {
        "name": "_Modeler_Metrics",
        "description": "Metric dimension for Scenario Radar visual — each row is one radar axis.",
        "lineageTag": "e410437e-f460-4941-a0c2-4c945f5d83ce",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "MetricName",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[MetricName]",
            "displayFolder": "Attributes\\Misc",
            "lineageTag": "3dccb88e-7385-4a79-a92b-89de7262e5ae"
          },
          {
            "type": "calculatedTableColumn",
            "name": "SortOrder",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[SortOrder]",
            "displayFolder": "Attributes\\Misc",
            "lineageTag": "c22ad60d-2a58-4b96-b5fe-8f79e5ad72ea"
          }
        ],
        "partitions": [
          {
            "name": "_Modeler_Metrics",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "    \"MetricName\", STRING,",
                "    \"SortOrder\", INTEGER,",
                "    {",
                "        {\"Budget\",            1},",
                "        {\"Benefits\",          2},",
                "        {\"Committed Effort\",  3},",
                "        {\"Selected Plans\",    4},",
                "        {\"Budget Utilization %\", 5}",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
