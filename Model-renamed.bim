          {
            "name": "Task | Active Late Tasks",
            "description": "Source: Tasks[Id].",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNT(Tasks[Id]),",
              "    Tasks[WorkType] = \"Tasks\",",
              "    Tasks[Status] = \"In Progress\",",
              "    Tasks[BaselineEndDate] < TODAY(),",
              "    CROSSFILTER(Assignments[TaskId], Tasks[Id], Both)",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Task",
            "lineageTag": "78d778ba-17a4-47b8-92aa-10211a35252b",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Task | In Progress",
            "description": "Source: Tasks[Id].",
            "expression": [
              "CALCULATE(",
              "    COUNT(Tasks[Id]),",
              "    Tasks[WorkType] = \"Tasks\",",
              "    Tasks[Status] = \"In Progress\",",
              "    CROSSFILTER(Assignments[TaskId], Tasks[Id], Both)",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Task",
            "lineageTag": "f95a41fe-59d0-4e5c-add6-872f0eed7e1a",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Task | Off Track Tasks",
            "description": "Source: TASKS[ID].",
            "expression": "CALCULATE(COUNT(TASKS[ID]),Tasks[TaskStatus] = \"(3) Off Track\", Tasks[Status] <>\"Completed\")",
            "formatString": "0",
            "displayFolder": "Task",
            "lineageTag": "bf4acab0-82db-4d76-8826-110c766cc511",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Resource | Overdue Tasks per Resource",
            "description": "Source: Tasks[Overdue Tasks].",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS(Assignments),",
              "    FILTER(",
              "        Assignments,",
              "        NOT ISBLANK(RELATED(Tasks[Overdue Tasks]))",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Resource",
            "lineageTag": "7f9bc847-47fb-45cd-a4ad-0e7576e0bbcc",
            "changedProperties": [
