            "queryGroup": "General",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [App = _t, Url = _t, Index = _t]),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(Source,{\"Index\", \"App\", \"Url\"}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Reordered Columns\",{{\"Index\", Order.Ascending}})",
                "in",
                "    #\"Sorted Rows\""
              ]
            }
          }
        ],
