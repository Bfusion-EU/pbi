            "name": "Resources",
            "mode": "import",
            "queryGroup": "Resource Mgmt",
            "source": {
              "type": "m",
              "expression": [
                "/*",
                "    Creator: BFusion",
                "    Version: 1.3",
                "    Date: 2025-03-07",
                "*/",
                "",
                "let",
                "    // Fetch data from OData source",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "",
                "    // Extract the \"Resources\" table from the OData feed",
                "    Resources_table = Source{[Name=\"Resources\", Signature=\"table\"]}[Data],",
                "",
                "    #\"Removed Columns\" = Table.RemoveColumns(Resources_table,{\"Department_Id\", \"Role_Id\"})",
                "in",
                "    #\"Removed Columns\""
              ]
            }
          }
        ],
