        "partitions": [
          {
            "name": "Plan_Projects",
            "mode": "import",
            "queryGroup": "Plans",
            "source": {
              "type": "m",
              "expression": [
                "/*",
                "    Creator: BFusion",
                "    Optimized Version: 1.2",
                "    Date: 2025-04-20",
                "*/",
                "",
                "let",
                "    // Step 1: Load OData feed and extract Plans table",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    Plans_table = Source{[Name = \"Plans\", Signature = \"table\"]}[Data],",
                "",
                "    // ✅ Updated PlanType filtering (case- and trim-safe)",
                "    #\"Filtered Rows\" = Table.SelectRows(Plans_table, each ",
                "        let pt = Text.Upper(Text.Trim([PlanType] ?? \"\"))",
                "        in pt <> \"PORTFOLIO\" and pt <> \"PROGRAM\"",
                "    ),",
                "",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Filtered Rows\",{\"Id\", \"Name\", \"Created\", \"Modified\", \"Creator\", \"ProcessStep\", \"ProcessStepStart\", \"ProcessStepIndex\", \"Archived\", \"PlanType\", \"PortfolioPriority\", \"State_Value\", \"Priority_Value\", \"Budget\", \"EstimatedStart\", \"EstimatedEnd\", \"ExecutiveSponsor\", \"ExecutiveSponsor_Value\", \"Manager\", \"Manager_Value\", \"ProjectType_Id\", \"ProjectType_Value\", \"BusinessUnit_Value\", \"Forecast\", \"RemainingBudget\", \"BudgetVariance\", \"Benefits\", \"ROI\", \"FundingAvailable\", \"FundingSource_Value\", \"CommittedEffort\", \"ScheduledEffort\", \"RemainingEffort\", \"EffortVariance\", \"OverallHealth_Value\", \"ScheduleHealth_Value\", \"FinancialHealth_Value\", \"EffortHealth_Value\", \"IssueHealth_Value\", \"NeedsStaffing\", \"StrategicAlignment_Value\", \"LowerCost_Value\", \"Risk_Value\", \"PrioritizationScore\", \"Actuals\", \"Goals_Value\", \"Description\", \"BusinessCase\", \"ValueStatement\", \"Accomplishments\", \"PlannedActivities\", \"AdditionalComments\", \"PlanType_EnterpriseProject_Value\", \"PlanType_Program_Id\", \"PlanType_Program_Value\", \"ProgramBudget\", \"RemainingBudgetAllocation\", \"ActiveRisks\", \"ActiveIssues\", \"ActiveChanges\", \"TasksinProgress\", \"TasksAtRisks\", \"TasksOffTrack\", \"ofBacklogTasks\", \"ofFeatures\", \"ofUserStories\", \"BacklogPoints\", \"BusinessValue_Value\", \"RiskReduction_Value\", \"TimeCriticality_Value\", \"CostofDelay\", \"WSJF\", \"ValueArea_Value\", \"EpicPoints\", \"RemainingPoints\", \"Lead\", \"Lead_Value\", \"Metric_Value\", \"CurrentNumber\", \"TargetNumber\", \"CurrentMetric\", \"Status_Value\", \"RequestedBy_Value\", \"AssociatedPortfolio_Value\", \"AssociatedPrograms_Value\", \"NoofNotStartedTasks\", \"Insights_Compliance\", \"Insights_Problems\", \"Insights_Warnings\", \"NoofLateTasks\", \"ApprovalStatus_Value\", \"AssociatedResults_Value\", \"BudgetTrend\", \"ComplianceTrend\", \"ActiveIssuesTrend\", \"ActiveChangesTrend\", \"StateTrend\", \"MetricTrend\", \"CurrentMetricTrend\", \"Vision\", \"Mission\", \"Strengths\", \"Weaknesses\", \"Opportunity\", \"Threats\", \"StatusTrend\", \"AccountExecutive_Value\", \"CustomerManager\", \"CustomerSponsor\", \"PO\", \"SOWProvided\", \"BillingMethod_Value\", \"Closed\", \"ContractAmount\", \"ContractVariance\", \"TargetMargin\", \"ContractHours\", \"InvoicedAmount\", \"ScopeHealth_Value\", \"OverallHealthStatus\", \"ScopeHealthStatus\", \"IssueHealthStatus\", \"EffortHealthStatus\", \"ScheduleHealthStatus\", \"ContractAmountTrend\", \"KeyAccomplishmentsThisReportingPeriod\", \"UpcomingTasksforNext2Weeks\", \"EstimatedCost\", \"ActualCost\", \"EstimatedRevenue\", \"EstimatedRevenueTrend\", \"EstimatedProfit\", \"EstimatedProfitTrend\", \"ActualRevenue\", \"BudgetUsed\", \"Margin\", \"ActualMargin\", \"MarginVariance\", \"PlansEstimatedCost\", \"PlansEstimatedProfit\", \"PlansEstimatedRevenue\", \"PlansEstimatedCostTrend\", \"PlansEstimatedProfitTrend\", \"PlansEstimatedRevenueTrend\", \"Summary_Duration\", \"Summary_PercentDone\", \"VoteAmount\"})",
                "in",
                "    #\"Removed Other Columns\""
              ]
            }
          }
        ],
