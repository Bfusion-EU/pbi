        "partitions": [
          {
            "name": "Assignments",
            "mode": "import",
            "queryGroup": "Scheduling",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    Assignments_table = Source{[Name=\"Assignments\",Signature=\"table\"]}[Data],",
                "    #\"Merged Queries\" = Table.NestedJoin(Assignments_table, {\"UserId\"}, Resources, {\"UserId\"}, \"Resources\", JoinKind.LeftOuter),",
                "    #\"Expanded Resources\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Resources\", {\"Name\", \"Department_Value\", \"Role_Value\"}, {\"Resources.Name\", \"Resources.Department_Value\", \"Resources.Role_Value\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Expanded Resources\",{{\"Resources.Name\", \"AssignedResource\"}, {\"Resources.Department_Value\", \"Department_Value\"}, {\"Resources.Role_Value\", \"Role_Value\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
