        "partitions": [
          {
            "name": "ModelerScenarioPlan",
            "mode": "import",
            "queryGroup": "Portfolio Modeler",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    ModelerScenarioPlan_table = Source{[Name=\"ModelerScenarioPlan\",Signature=\"table\"]}[Data]",
                "in",
                "    ModelerScenarioPlan_table"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Modeler | Membership 1",
            "description": "Returns 1 if the current project (Plans[Name] context) is part of the current scenario (ModelerScenario[Name] context), else 0. Bind to the Scenario Membership data role on the Efficient Frontier visual (project-mode).",
            "expression": "VAR _proj = SELECTEDVALUE ( Plans[Name] ) VAR _scn  = SELECTEDVALUE ( ModelerScenario[Name] ) RETURN     IF (         NOT ISBLANK ( _proj ) && NOT ISBLANK ( _scn )             && CALCULATE (                 COUNTROWS ( ModelerScenarioPlan ),                 ModelerScenarioPlan[Name] = _proj,                 ModelerScenarioPlan[Checked] = TRUE ()             ) > 0,         1, 0     )",
            "formatString": "0",
            "displayFolder": "Modeler | Efficient Frontier",
            "lineageTag": "c079312d-c6d2-4a41-87f2-22d0efd92919"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
