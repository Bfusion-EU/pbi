              "RETURN",
              "    COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] >= 0.75 && [@MaxAlloc] <= 1))"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "99b2299e-d959-41f6-aa7d-3513d5d6c645"
          },
          {
            "name": "Resource KPI | Alloc Bucket Over",
            "description": "Source: Resources[UserId].",
            "expression": [
              "VAR _ResAllocTable =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES(Resources[UserId]),",
              "            CALCULATE(COUNTROWS(Capacity)) > 0",
              "        ),",
              "        \"@MaxAlloc\",",
              "            CALCULATE(",
              "                MAXX(",
              "                    SUMMARIZE(Calendar, Calendar[Period]),",
              "                    CALCULATE([Capacity | Resource Utilization%])",
              "                )",
              "            )",
              "    )",
              "RETURN",
              "    COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 1))"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "142dde57-b6e7-425c-826b-98650a5da1c7"
          },
          {
            "name": "Resource KPI | Top Overalloc Name",
            "description": "Source: Resources[UserId].",
            "expression": [
              "VAR _ResAllocTable =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES(Resources[UserId]),",
              "            CALCULATE(COUNTROWS(Capacity)) > 0",
              "        ),",
              "        \"@MaxAlloc\",",
              "            CALCULATE(",
              "                MAXX(",
              "                    SUMMARIZE(Calendar, Calendar[Period]),",
              "                    CALCULATE([Capacity | Resource Utilization%])",
              "                )",
              "            )",
              "    )",
              "VAR _TopRow =",
              "    TOPN(1, FILTER(_ResAllocTable, [@MaxAlloc] > 1), [@MaxAlloc], DESC)",
              "RETURN",
              "    MAXX(_TopRow, CALCULATE(SELECTEDVALUE(Resources[Name])))"
            ],
            "displayFolder": "Resource KPI",
            "lineageTag": "85bec1e1-d29a-4d12-a3a8-fb6aee661445"
          },
          {
            "name": "Resource KPI | Top Overalloc Peak",
            "description": "Source: Resources[UserId].",
            "expression": [
              "VAR _ResAllocTable =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES(Resources[UserId]),",
              "            CALCULATE(COUNTROWS(Capacity)) > 0",
              "        ),",
              "        \"@MaxAlloc\",",
              "            CALCULATE(",
              "                MAXX(",
              "                    SUMMARIZE(Calendar, Calendar[Period]),",
              "                    CALCULATE([Capacity | Resource Utilization%])",
              "                )",
              "            )",
              "    )",
              "VAR _TopRow =",
              "    TOPN(1, FILTER(_ResAllocTable, [@MaxAlloc] > 1), [@MaxAlloc], DESC)",
              "RETURN",
              "    MAXX(_TopRow, [@MaxAlloc])"
            ],
            "formatString": "0.00",
            "displayFolder": "Resource KPI",
            "lineageTag": "76cad9e5-367c-4f22-a8aa-c510056b421b"
          },
          {
            "name": "Capacity | Demand",
            "description": "Source: ResPlan[Hours].",
            "expression": "SUM( ResPlan[Hours] )",
            "formatString": "#,##0",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "7b8101c0-0cbb-4439-bc5b-c92d6e8319ee"
          },
          {
            "name": "Capacity | Committed",
            "description": "Source: ResPlan[Hours].",
            "expression": [
              "CALCULATE(",
              "    SUM( ResPlan[Hours] ),",
              "    ResPlan[CostType] = \"Committed\"",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity\\Committed",
            "lineageTag": "33f75806-d58d-438e-9b81-58997268449a"
          },
          {
            "name": "Capacity | Forecast",
            "description": "Source: ResPlan[Hours].",
            "expression": [
              "CALCULATE(",
              "    SUM( ResPlan[Hours] ),",
              "    ResPlan[CostType] = \"Forecast\"",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity\\Forecast",
            "lineageTag": "706ceeda-2e46-485b-b01e-f968fb838339"
          },
          {
            "name": "Resource | Scheduled",
            "description": "Source: ResPlan[Hours].",
            "expression": [
              "CALCULATE(",
              "    SUM( ResPlan[Hours] ),",
              "    ResPlan[CostType] = \"Scheduled\"",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource",
            "lineageTag": "6b7d8888-f586-46af-8a73-e0bd28e59680"
          },
          {
            "name": "Resource | Utilization",
            "description": "Source: Capacity[Capacity].",
            "expression": [
              "VAR _Cap = SUM( Capacity[Capacity] )",
              "VAR _Dem = SUM( ResPlan[Hours] )",
              "RETURN",
              "    IF( _Cap > 0, DIVIDE( _Dem, _Cap ) * 100, BLANK() )"
            ],
            "formatString": "0.0",
            "displayFolder": "Resource",
            "lineageTag": "81a0fa95-2875-4c5d-b385-260c043f609c"
          },
          {
            "name": "Capacity | Available Capacity",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Avail = [Capacity | Resource Capacity] - [Capacity | Committed] - [Resource | Scheduled]",
              "RETURN",
              "    MAX( _Avail, 0 )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity",
            "lineageTag": "f6efe924-2a0c-458d-b5a0-9c6a6c8e3fb6"
          },
          {
            "name": "Capacity | Demand Coverage %",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Dem = [Capacity | Demand]",
              "VAR _Covered = [Capacity | Committed] + [Resource | Scheduled]",
              "RETURN",
              "    IF( _Dem > 0, MIN( DIVIDE( _Covered, _Dem ) * 100, 100 ), BLANK() )"
            ],
            "formatString": "0.0\"%\"",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "7aca6207-fc66-49b1-9994-4a46c6ee6d8f"
          },
          {
            "name": "Resource | Supply-Demand Ratio",
            "description": "Subject area: Resource.",
            "expression": [
              "VAR _Dem = [Capacity | Demand]",
              "RETURN",
              "    IF( _Dem > 0, DIVIDE( [Capacity | Resource Capacity], _Dem ), BLANK() )"
            ],
            "formatString": "0.00",
            "displayFolder": "Resource",
            "lineageTag": "50768ab1-50f9-4d2e-b11f-68433fb9a50c"
          },
          {
            "name": "Capacity | Demand Firmness %",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Total = [Capacity | Committed] + [Capacity | Forecast] + [Resource | Scheduled]",
              "RETURN",
              "    IF( _Total > 0, DIVIDE( [Capacity | Committed], _Total ) * 100, BLANK() )"
            ],
            "formatString": "0.0\"%\"",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "4a8d89bf-00dd-41be-be39-45fac4b0cf4f"
          },
          {
            "name": "Resource | Slack %",
            "description": "Subject area: Resource.",
            "expression": [
              "VAR _Cap = [Capacity | Resource Capacity]",
              "RETURN",
              "    IF( _Cap > 0, DIVIDE( [Capacity | Available Capacity], _Cap ) * 100, BLANK() )"
            ],
            "formatString": "0.0\"%\"",
            "displayFolder": "Resource",
            "lineageTag": "1899e209-b789-4ed1-84ed-da572eac313a"
          },
          {
            "name": "Capacity | Forecast Exposure %",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Dem = [Capacity | Demand]",
              "RETURN",
              "    IF( _Dem > 0, DIVIDE( [Capacity | Forecast], _Dem ) * 100, BLANK() )"
            ],
            "formatString": "0.0\"%\"",
            "displayFolder": "Capacity\\Forecast",
            "lineageTag": "dfbd3611-44ac-4ca3-bdd0-d5645127af88"
          },
          {
            "name": "Resource | Pipeline Health Score",
            "description": "Subject area: Resource.",
            "expression": [
              "VAR _Firmness  = [Capacity | Demand Firmness %]",
              "VAR _Coverage  = [Capacity | Demand Coverage %]",
              "VAR _FctExp    = [Capacity | Forecast Exposure %]",
              "VAR _Score = _Firmness * 0.4 + _Coverage * 0.3 + ( 100 - _FctExp ) * 0.3",
              "RETURN",
              "    IF( NOT ISBLANK( _Firmness ), MIN( ROUND( _Score, 0 ), 100 ), BLANK() )"
            ],
            "formatString": "0",
            "displayFolder": "Resource",
            "lineageTag": "b284289b-f162-4f49-9c52-7328551f8797"
          },
          {
            "name": "Resource | Utilization Band",
            "description": "Subject area: Resource.",
            "expression": [
              "VAR _Util = [Resource | Utilization]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK( _Util ),  \"N/A\",",
              "        _Util >= 120,      \"Critical (120%+)\",",
              "        _Util >= 100,      \"Over-allocated (100-120%)\",",
              "        _Util >= 80,       \"Optimal (80-100%)\",",
              "        _Util >= 50,       \"Under-utilized (50-80%)\",",
              "                           \"Low (<50%)\"",
              "    )"
            ],
            "displayFolder": "Resource",
            "lineageTag": "9b199c52-b0f1-4fe9-9bec-65fdd719658f"
          },
          {
            "name": "Resource | Headcount",
            "description": "Source: Resources[Quantity].",
            "expression": "SUM( Resources[Quantity] )",
            "formatString": "#,##0.0",
            "displayFolder": "Resource",
            "lineageTag": "dc96d42e-53d7-48b7-b07c-d74f9f4ad20d"
          },
          {
            "name": "Capacity | Capacity per FTE",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _HC = [Resource | Headcount]",
              "RETURN",
              "    IF( _HC > 0, DIVIDE( [Capacity | Resource Capacity], _HC ), BLANK() )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity",
            "lineageTag": "949951c5-8351-4f2f-9313-de1632b31106"
          },
          {
            "name": "Capacity | Demand per FTE",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _HC = [Resource | Headcount]",
              "RETURN",
              "    IF( _HC > 0, DIVIDE( [Capacity | Demand], _HC ), BLANK() )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "6ba22122-fff3-4f8c-ba8c-b86c72cfeb9d"
          },
          {
            "name": "Capacity | Prev Capacity",
            "description": "Source: Calendar[Year].",
            "expression": [
              "VAR _CurYear  = SELECTEDVALUE( Calendar[Year] )",
              "VAR _CurMonth = SELECTEDVALUE( Calendar[Month] )",
              "VAR _PrevYear  = IF( _CurMonth = 1, _CurYear - 1, _CurYear )",
              "VAR _PrevMonth = IF( _CurMonth = 1, 12, _CurMonth - 1 )",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK( _CurYear ) && NOT ISBLANK( _CurMonth ),",
              "        CALCULATE(",
              "            SUM( Capacity[Capacity] ),",
              "            REMOVEFILTERS( Calendar ),",
              "            Calendar[Year]  = _PrevYear,",
              "            Calendar[Month] = _PrevMonth",
              "        ),",
              "        // Multi-month context: shift each date back ~30 days",
              "        CALCULATE(",
              "            SUM( Capacity[Capacity] ),",
              "            DATEADD( Calendar[Date], -1, MONTH )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity",
            "lineageTag": "40d1d949-ef39-4862-b885-855275e22888"
          },
          {
            "name": "Capacity | Prev Demand",
            "description": "Source: Calendar[Year].",
            "expression": [
              "VAR _CurYear  = SELECTEDVALUE( Calendar[Year] )",
              "VAR _CurMonth = SELECTEDVALUE( Calendar[Month] )",
              "VAR _PrevYear  = IF( _CurMonth = 1, _CurYear - 1, _CurYear )",
              "VAR _PrevMonth = IF( _CurMonth = 1, 12, _CurMonth - 1 )",
              "RETURN",
              "    IF(",
              "        NOT ISBLANK( _CurYear ) && NOT ISBLANK( _CurMonth ),",
              "        CALCULATE(",
              "            SUM( ResPlan[Hours] ),",
              "            REMOVEFILTERS( Calendar ),",
              "            Calendar[Year]  = _PrevYear,",
              "            Calendar[Month] = _PrevMonth",
              "        ),",
              "        CALCULATE(",
              "            SUM( ResPlan[Hours] ),",
              "            DATEADD( Calendar[Date], -1, MONTH )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "f7ed37be-345a-4a2a-995c-d4f600d90e19"
          },
          {
            "name": "Capacity | Capacity Change %",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Prev = [Capacity | Prev Capacity]",
              "RETURN",
              "    IF( _Prev > 0, DIVIDE( [Capacity | Resource Capacity] - _Prev, _Prev ) * 100, BLANK() )"
            ],
            "formatString": "+0.0\"%\";-0.0\"%\";\"0.0%\"",
            "displayFolder": "Capacity",
            "lineageTag": "0dd5e036-d24e-4cf9-9c9e-ca983e45cc16"
          },
          {
            "name": "Capacity | Demand Change %",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _Prev = [Capacity | Prev Demand]",
              "RETURN",
              "    IF( _Prev > 0, DIVIDE( [Capacity | Demand] - _Prev, _Prev ) * 100, BLANK() )"
            ],
            "formatString": "+0.0\"%\";-0.0\"%\";\"0.0%\"",
            "displayFolder": "Capacity\\Demand",
            "lineageTag": "fe9366a0-718f-4790-b805-b9bce37ccaec"
          },
          {
            "name": "Capacity | Gap Trend",
            "description": "Subject area: Capacity.",
            "expression": [
              "VAR _CurrGap = [Capacity | Availability]",
              "VAR _PrevGap = [Capacity | Prev Capacity] - [Capacity | Prev Demand]",
              "RETURN",
              "    _CurrGap - _PrevGap"
            ],
            "formatString": "+#,##0;-#,##0;0",
            "displayFolder": "Capacity",
            "lineageTag": "5b626b2a-8f04-4ffa-a9d2-8721a0a04d6b"
          },
          {
            "name": "Lifecycle | Approval",
            "description": "Source: ProcessSteps[Name].",
            "expression": [
              "VAR _name = SELECTEDVALUE(ProcessSteps[Name])",
              "RETURN CALCULATE(",
              "    MAX(PlanProcessSteps[ApprovalState]),",
              "    ALL(ProcessSteps),",
              "    PlanProcessSteps[StepName] = _name",
              ")"
            ],
            "displayFolder": "Lifecycle",
            "lineageTag": "4af91e1e-b49d-4d89-bcf9-f1ec3e66e81d",
            "annotations": [
              {
                "name": "BFusion.Visual",
                "value": "ProjectLifecycle"
              },
              {
                "name": "BFusion.SortOrder",
                "value": "2"
              }
            ]
          },
          {
            "name": "Lifecycle | Comments",
            "description": "Source: ProcessSteps[Name].",
            "expression": [
              "VAR _name = SELECTEDVALUE(ProcessSteps[Name])",
              "RETURN CALCULATE(",
              "    MAX(PlanProcessSteps[Comments]),",
              "    ALL(ProcessSteps),",
              "    PlanProcessSteps[StepName] = _name",
              ")"
            ],
            "displayFolder": "Lifecycle",
            "lineageTag": "2916b41d-e28b-45fd-bb6e-3c90c05862c7",
            "annotations": [
              {
                "name": "BFusion.Visual",
                "value": "ProjectLifecycle"
              },
              {
                "name": "BFusion.SortOrder",
                "value": "5"
              }
            ]
          },
          {
            "name": "Lifecycle | End",
            "description": "Source: ProcessSteps[Name].",
            "expression": [
              "VAR _name = SELECTEDVALUE(ProcessSteps[Name])",
              "RETURN CALCULATE(",
              "    MAX(PlanProcessSteps[End]),",
              "    ALL(ProcessSteps),",
              "    PlanProcessSteps[StepName] = _name",
              ")"
            ],
            "formatString": "dd/mm/yyyy hh:nn",
            "displayFolder": "Lifecycle",
            "lineageTag": "1bfd16bd-084e-4509-bb13-58be20bb141b",
            "annotations": [
              {
                "name": "BFusion.Visual",
                "value": "ProjectLifecycle"
              },
              {
                "name": "BFusion.SortOrder",
                "value": "4"
              }
            ]
          },
          {
            "name": "Lifecycle | Start",
            "description": "Source: ProcessSteps[Name].",
            "expression": [
              "VAR _name = SELECTEDVALUE(ProcessSteps[Name])",
              "RETURN CALCULATE(",
              "    MIN(PlanProcessSteps[Start]),",
              "    ALL(ProcessSteps),",
              "    PlanProcessSteps[StepName] = _name",
              ")"
            ],
            "formatString": "dd/mm/yyyy hh:nn",
            "displayFolder": "Lifecycle",
            "lineageTag": "c74114fa-8976-4254-9cfe-43bd6027bbc9",
            "annotations": [
              {
                "name": "BFusion.Visual",
                "value": "ProjectLifecycle"
              },
              {
                "name": "BFusion.SortOrder",
                "value": "3"
              }
            ]
          },
          {
            "name": "Lifecycle | Step State",
            "description": "Source: ProcessSteps[Name].",
            "expression": [
              "VAR _name = SELECTEDVALUE(ProcessSteps[Name])",
              "// Actual state for the SELECTED plan",
              "VAR _val = CALCULATE(",
              "    MAX(PlanProcessSteps[StepState]),",
              "    ALL(ProcessSteps),",
              "    PlanProcessSteps[StepName] = _name",
              ")",
              "// Does this step exist in ANY plan of the same PlanType?",
              "// ALLEXCEPT keeps PlanTypeName filter but removes the specific Plan selection",
              "VAR _existsInPlanType = CALCULATE(",
              "    COUNTROWS(PlanProcessSteps),",
              "    ALL(ProcessSteps),",
              "    ALLEXCEPT(Plans, Plans[PlanType]),",
              "    PlanProcessSteps[StepName] = _name",
              ") > 0",
              "RETURN",
              "    IF(",
              "        ISBLANK(_name), BLANK(),",
              "        IF(",
              "            NOT _existsInPlanType, BLANK(),",
              "            IF(ISBLANK(_val), \"Upcoming\", _val)",
              "        )",
              "    )"
            ],
            "displayFolder": "Lifecycle",
            "lineageTag": "3e7a64a9-01bf-408b-ae48-4c89c8cfd1d6",
            "annotations": [
              {
                "name": "BFusion.Visual",
                "value": "ProjectLifecycle"
              },
              {
                "name": "BFusion.SortOrder",
                "value": "1"
              }
            ]
          },
          {
            "name": "Risk & Issue | Avg Probability",
            "description": "Source: Tasks[Probability].",
            "expression": "AVERAGE( Tasks[Probability] )",
            "displayFolder": "Risk & Issue",
            "lineageTag": "f63b9165-c2c5-44a8-b656-d4309dae92a0"
          },
          {
            "name": "Risk & Issue | Likelihood Score",
            "description": "Source: Tasks[Probability].",
            "expression": [
              "",
              "VAR _avg = AVERAGE( Tasks[Probability] )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _avg >= 75, 5,",
              "        _avg >= 50, 4,",
              "        _avg >= 25, 3,",
              "        _avg >= 10, 2,",
              "        1",
              "    )",
              ""
            ],
            "displayFolder": "Risk & Issue",
            "lineageTag": "6c02cacb-2859-4018-b440-d8e119b11569"
          },
          {
            "name": "Risk & Issue | Risk Count",
            "description": "Subject area: Risk & Issue.",
            "expression": "CALCULATE(COUNTROWS( Tasks ), Tasks[WorkType] = \"Risks\")",
            "displayFolder": "Risk & Issue",
            "lineageTag": "9b3e96f3-2652-4668-ad72-febdd7ba4b08"
          },
          {
            "name": "Risk & Issue | Risk Rating",
            "description": "Source: Tasks[Impact].",
            "expression": [
              "",
              "VAR _impact =",
              "    AVERAGEX(",
              "        Tasks,",
              "        SWITCH(",
              "            TRUE(),",
              "            Tasks[Impact] = \"(1) Critical\", 5,",
              "            Tasks[Impact] = \"(2) High\",     4,",
              "            Tasks[Impact] = \"(3) Medium\",   3,",
              "            Tasks[Impact] = \"(4) Low\",      2,",
              "            3",
              "        )",
              "    )",
              "VAR _likelihood =",
              "    SWITCH(",
              "        TRUE(),",
              "        AVERAGE( Tasks[Probability] ) >= 75, 5,",
              "        AVERAGE( Tasks[Probability] ) >= 50, 4,",
              "        AVERAGE( Tasks[Probability] ) >= 25, 3,",
              "        AVERAGE( Tasks[Probability] ) >= 10, 2,",
              "        1",
              "    )",
              "RETURN",
              "    _impact * _likelihood",
              ""
            ],
            "displayFolder": "Risk & Issue",
            "lineageTag": "173aa1be-f077-4358-b131-27f69c45d2e7"
          },
          {
            "name": "Risk & Issue | Target",
            "description": "Subject area: Risk & Issue.",
            "expression": "5",
            "displayFolder": "Risk & Issue",
            "lineageTag": "b8eff8da-df19-49b8-8ad8-d7856e1f6801"
          },
          {
            "name": "Risk & Issue | Impact Score",
            "description": "Source: Tasks[Impact].",
            "expression": [
              "AVERAGEX(",
              "    Tasks,",
              "    SWITCH(",
              "        TRUE(),",
              "        Tasks[Impact] = \"(1) Critical\", 5,",
              "        Tasks[Impact] = \"(2) High\",     4,",
              "        Tasks[Impact] = \"(3) Medium\",   3,",
              "        Tasks[Impact] = \"(4) Low\",      2,",
              "        LEFT( Tasks[Impact], 1 ) = \"(\",",
              "            6 - VALUE( MID( Tasks[Impact], 2, 1 ) ),",
              "        3",
              "    )",
              ")",
              ""
            ],
            "displayFolder": "Risk & Issue",
            "lineageTag": "baaaf345-d553-4905-9732-adf93efc58d5"
          },
          {
            "name": "Modeler | Priority Score",
            "description": "Selection Waterfall. Source: Plan_Projects[PrioritizationScore].",
            "expression": [
              "",
              "// Cascading priority: PrioritizationScore → WSJF → CostofDelay → Strategic Alignment numeric",
              "VAR _ps   = MAX ( Plan_Projects[PrioritizationScore] )",
              "VAR _wsjf = MAX ( Plan_Projects[WSJF] )",
              "VAR _cod  = MAX ( Plan_Projects[CostofDelay] )",
              "VAR _sa   =",
              "    SWITCH (",
              "        MAX ( Plan_Projects[StrategicAlignment_Value] ),",
              "        \"Extreme\", 100,",
              "        \"Strong\",   80,",
              "        \"Moderate\",  60,",
              "        \"Low\",       40,",
              "        \"Not Rated\", 20,",
              "        0",
              "    )",
              "RETURN",
              "    IF ( _ps <> 0,   _ps,",
              "    IF ( _wsjf <> 0, _wsjf,",
              "    IF ( _cod <> 0,  _cod,",
              "        _sa",
              "    )))",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Selection Waterfall",
            "lineageTag": "c5c65d6a-ae4f-43b2-8647-652569fa0a0c"
          },
          {
            "name": "Modeler | Project Estimated Cost",
            "description": "Estimated cost per project — determines bar height in the waterfall.",
            "expression": [
              "",
              "SUM ( Plans[EstimatedCost] )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Selection Waterfall",
            "lineageTag": "9a855cdd-bc5d-4a45-a8f1-8f8a1d018a1c"
          },
          {
            "name": "Modeler | Portfolio Budget",
            "description": "Selection Waterfall. Source: ModelerScenario[TargetBudget].",
            "expression": [
              "",
              "// Uses Modeler scenario TargetBudget when a scenario is in context,",
              "// otherwise falls back to the sum of portfolio-level budgets.",
              "VAR _scenarioBudget  = SUM ( ModelerScenario[TargetBudget] )",
              "VAR _portfolioBudget = SUM ( Plan_Portfolio[Budget] )",
              "RETURN",
              "    IF ( _scenarioBudget <> 0, _scenarioBudget, _portfolioBudget )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Selection Waterfall",
            "lineageTag": "badb727d-7467-4c0c-8f99-9fc564c52733"
          },
          {
            "name": "Modeler | Strategic Alignment Score (Selection Waterfall)",
            "description": "Selection Waterfall. Source: Plan_Projects[StrategicAlignment_Value].",
            "expression": [
              "",
              "SWITCH (",
              "    MAX ( Plan_Projects[StrategicAlignment_Value] ),",
              "    \"Extreme\", 100,",
              "    \"Strong\",   80,",
              "    \"Moderate\",  60,",
              "    \"Low\",       40,",
              "    \"Not Rated\", 20,",
              "    0",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Selection Waterfall",
            "lineageTag": "8869355e-4d2a-4e13-91ab-3dfba6b350c8"
          },
          {
            "name": "Modeler | Scenario Metric Value",
            "description": "Scenario Radar. Source: ModelerScenario[TotalBudget].",
            "expression": [
              "",
              "VAR _metric = SELECTEDVALUE ( '_Modeler_Metrics'[MetricName] )",
              "RETURN",
              "    SWITCH (",
              "        _metric,",
              "        \"Budget\",              SUM ( ModelerScenario[TotalBudget] ),",
              "        \"Benefits\",            SUM ( ModelerScenario[TotalBenefits] ),",
              "        \"Committed Effort\",    SUM ( ModelerScenario[TotalCommittedEffort] ),",
              "        \"Selected Plans\",      SUM ( ModelerScenario[TotalCheckedPlans] ),",
              "        \"Budget Utilization %\",",
              "            DIVIDE (",
              "                SUM ( ModelerScenario[TotalBudget] ),",
              "                SUM ( ModelerScenario[TargetBudget] ),",
              "                0",
              "            ) * 100,",
              "        BLANK ()",
              "    )",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Scenario Radar",
            "lineageTag": "84f5a29a-9dbd-414b-9b6b-6a88f3f3e272"
          },
          {
            "name": "Modeler | Scenario Target Value",
            "description": "Scenario Radar. Source: ModelerScenario[TargetBudget].",
            "expression": [
              "",
              "VAR _metric = SELECTEDVALUE ( '_Modeler_Metrics'[MetricName] )",
              "RETURN",
              "    SWITCH (",
              "        _metric,",
              "        \"Budget\",              SUM ( ModelerScenario[TargetBudget] ),",
              "        \"Benefits\",            SUM ( ModelerScenario[TargetBenefits] ),",
              "        \"Committed Effort\",    SUM ( ModelerScenario[TargetCommittedEffort] ),",
              "        \"Selected Plans\",      SUM ( ModelerScenario[TotalPlans] ),",
              "        \"Budget Utilization %\", 100,",
              "        BLANK ()",
              "    )",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Scenario Radar",
            "lineageTag": "636c4155-c186-41c8-9343-06a7a895b97e"
          },
          {
            "name": "Modeler | Sensitivity Baseline",
            "description": "Sensitivity Tornado. Source: ModelerScenario[TotalBudget].",
            "expression": [
              "",
              "VAR _param = SELECTEDVALUE ( '_Modeler_SensitivityParams'[Parameter] )",
              "RETURN",
              "    SWITCH (",
              "        _param,",
              "        \"Budget Constraint\",      SUM ( ModelerScenario[TotalBudget] ),",
              "        \"Benefits Target\",        SUM ( ModelerScenario[TotalBenefits] ),",
              "        \"Committed Effort Limit\", SUM ( ModelerScenario[TotalCommittedEffort] ),",
              "        \"Selected Plan Count\",    SUM ( ModelerScenario[TotalCheckedPlans] ),",
              "        \"Budget Utilization\",",
              "            DIVIDE (",
              "                SUM ( ModelerScenario[TotalBudget] ),",
              "                SUM ( ModelerScenario[TargetBudget] ),",
              "                0",
              "            ) * 100,",
              "        BLANK ()",
              "    )",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Sensitivity Tornado",
            "lineageTag": "1668c84b-cba2-4fd7-ad20-166645e36973"
          },
          {
            "name": "Modeler | Sensitivity Low",
            "description": "Sensitivity Tornado.",
            "expression": [
              "",
              "[Modeler | Sensitivity Baseline]",
              "    * ( 1 - SELECTEDVALUE ( '_Modeler_SensitivityParams'[Variation], 0.20 ) )",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Sensitivity Tornado",
            "lineageTag": "9ad43932-8ca9-4ed6-8b9b-8828afe3d979"
          },
          {
            "name": "Modeler | Sensitivity High",
            "description": "Sensitivity Tornado.",
            "expression": [
              "",
              "[Modeler | Sensitivity Baseline]",
              "    * ( 1 + SELECTEDVALUE ( '_Modeler_SensitivityParams'[Variation], 0.20 ) )",
              ""
            ],
            "formatString": "#,##0.00",
            "displayFolder": "Modeler\\Sensitivity Tornado",
            "lineageTag": "05cb6567-206e-4b97-862d-3c9f90a3d4d3"
          },
          {
            "name": "Modeler | Alignment Score",
            "description": "Strategic Sunburst. Source: Plan_Projects[StrategicAlignment_Value].",
            "expression": [
              "",
              "// Maps the text-based strategic alignment to a 0-100 numeric score.",
              "// Used for color intensity in the sunburst — higher = better aligned.",
              "SWITCH (",
              "    MAX ( Plan_Projects[StrategicAlignment_Value] ),",
              "    \"Extreme\", 100,",
              "    \"Strong\",   80,",
              "    \"Moderate\",  60,",
              "    \"Low\",       40,",
              "    \"Not Rated\", 20,",
              "    0",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Strategic Sunburst",
            "lineageTag": "90a7973e-038e-492f-b19a-28bf31b1e46b"
          },
          {
            "name": "License | BFusionLicenseKey",
            "description": "Subject area: License.",
            "expression": [
              "",
              "IF (",
              "    ISEMPTY('Tasks'),",
              "    BLANK(),",
              "    SELECTEDVALUE('BFusionLicense'[Key])",
              ")"
            ],
            "displayFolder": "License",
            "lineageTag": "40352f90-e7b2-4944-ae8f-974601f30236"
          },
          {
            "name": "Modeler | Is Misaligned Drag",
            "description": "Resource Alignment.",
            "expression": [
              "VAR _fte = [Modeler | Plan FTE Demand]",
              "VAR _aln = [Modeler | Strategic Alignment Score (Resource Alignment)]",
              "RETURN IF( NOT ISBLANK( _fte ) && NOT ISBLANK( _aln ) && _fte >= 8 && _aln <= 50, 1, 0 )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "cf3550af-70b5-4c08-8cb4-2379054d4c5a"
          },
          {
            "name": "Modeler | Misaligned FTE Share %",
            "description": "Resource Alignment. Source: Plans[Id].",
            "expression": "DIVIDE( [Modeler | Misaligned FTE Total], CALCULATE( SUMX( VALUES( Plans[Id] ), [Modeler | Plan FTE Demand] ), ALL( Plans ) ) )",
            "formatString": "0.0%",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "4eb2847a-1d58-4a23-b964-ff8ae2df060c"
          },
          {
            "name": "Modeler | Misaligned FTE Total",
            "description": "Resource Alignment. Source: Plans[Id].",
            "expression": "CALCULATE( SUMX( VALUES( Plans[Id] ), [Modeler | Plan FTE Demand] ), FILTER( VALUES( Plans[Id] ), [Modeler | Is Misaligned Drag] = 1 ) )",
            "formatString": "0.0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "da68b2b6-d65b-4a8e-9f4e-e8d2dbc28b5c"
          },
          {
            "name": "Modeler | Misaligned Plan Count",
            "description": "Resource Alignment.",
            "expression": "CALCULATE( COUNTROWS( Plans ), FILTER( Plans, [Modeler | Is Misaligned Drag] = 1 ) )",
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "5223e5e1-9ccb-4b55-adf0-e60833bed569"
          },
          {
            "name": "Modeler | Plan FTE Demand",
            "description": "Resource Alignment.",
            "expression": "DIVIDE( [Capacity | Demand], 1720 )",
            "formatString": "0.0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "a9f974a1-0d5e-425d-b33f-78cc7792c9ce"
          },
          {
            "name": "Modeler | Strategic Alignment Score (Resource Alignment)",
            "description": "Resource Alignment. Source: Plans[StrategicAlignment_Value].",
            "expression": [
              "VAR _v = SELECTEDVALUE( Plans[StrategicAlignment_Value] )",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _v IN { \"Extreme\", \"Very High\", \"Critical\", \"Strategic\" }, 100,",
              "        _v IN { \"Strong\", \"High\" },                                    80,",
              "        _v IN { \"Moderate\", \"Medium\" },                                60,",
              "        _v IN { \"Low\" },                                                40,",
              "        _v IN { \"Very Low\", \"None\" },                                  20,",
              "        _v = \"Not Rated\", BLANK(),",
              "        BLANK()",
              "    )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "e1b26f19-f410-4839-99da-b4ef34a5b2b1"
          },
          {
            "name": "Modeler | Strategic Alignment Score (Composite)",
            "description": "Resource Alignment. Source: Plans[StrategicAlignment_Value].",
            "expression": [
              "VAR _alignment = SELECTEDVALUE( Plans[StrategicAlignment_Value] )",
              "VAR _fit       = SELECTEDVALUE( Plans[StrategicFit_Value] )",
              "VAR _value     = SELECTEDVALUE( Plans[BusinessValue_Value] )",
              "VAR _mapHigh = SWITCH( TRUE(),",
              "    _alignment IN { \"Extreme\", \"Very High\", \"Critical\", \"Strategic\" }, 100,",
              "    _alignment IN { \"Strong\", \"High\" }, 80,",
              "    _alignment IN { \"Moderate\", \"Medium\" }, 60,",
              "    _alignment IN { \"Low\" }, 40,",
              "    _alignment IN { \"Very Low\", \"None\" }, 20,",
              "    50 )",
              "VAR _mapFit = SWITCH( TRUE(),",
              "    _fit IN { \"Extreme\", \"Very High\", \"Critical\", \"Strategic\" }, 100,",
              "    _fit IN { \"Strong\", \"High\" }, 80,",
              "    _fit IN { \"Moderate\", \"Medium\" }, 60,",
              "    _fit IN { \"Low\" }, 40,",
              "    _fit IN { \"Very Low\", \"None\" }, 20,",
              "    50 )",
              "VAR _mapValue = SWITCH( TRUE(),",
              "    _value IN { \"Extreme\", \"Very High\", \"Critical\", \"Strategic\" }, 100,",
              "    _value IN { \"Strong\", \"High\" }, 80,",
              "    _value IN { \"Moderate\", \"Medium\" }, 60,",
              "    _value IN { \"Low\" }, 40,",
              "    _value IN { \"Very Low\", \"None\" }, 20,",
              "    50 )",
              "RETURN ROUND( 0.5 * _mapHigh + 0.3 * _mapFit + 0.2 * _mapValue, 0 )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "6e2a885e-0428-490d-ad04-66ecf3312794"
          },
          {
            "name": "Modeler | Strategic Alignment Score (Prioritization)",
            "description": "Resource Alignment. Source: Plans[PrioritizationScore].",
            "expression": [
              "VAR _v   = SUM( Plans[PrioritizationScore] )",
              "VAR _max = CALCULATE( MAX( Plans[PrioritizationScore] ), ALL( Plans ) )",
              "RETURN IF( _max > 0, DIVIDE( _v, _max ) * 100, BLANK() )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Resource Alignment",
            "lineageTag": "fbfc6784-1b73-40fe-b810-165491e33acb"
          },
          {
            "name": "EVM | BAC (Budget at Completion)",
            "description": "Source: Plans[Budget].",
            "expression": "SUM ( Plans[Budget] )",
            "formatString": "#,##0",
            "displayFolder": "EVM",
            "lineageTag": "927f0ed2-97b3-45b9-8819-165274030b0b"
          },
          {
            "name": "EVM | EAC (Estimate at Completion)",
            "description": "Source: Plans[EAC].",
            "expression": "SUM ( Plans[EAC] )",
            "formatString": "#,##0",
            "displayFolder": "EVM",
            "lineageTag": "370bd8a9-5ed6-418e-b734-18f1d5a6303f"
          },
          {
            "name": "EVM | CPI (Cost Performance Index)",
            "description": "Subject area: EVM.",
            "expression": [
              "",
              "// CPI proxy used when the model carries no time-phased Earned Value.",
              "// CPI < 1.0 = forecast to overrun budget; > 1.0 = forecast under budget.",
              "DIVIDE (",
              "    [EVM | BAC (Budget at Completion)],",
              "    [EVM | EAC (Estimate at Completion)]",
              ")",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "EVM",
            "lineageTag": "da727e3d-d4cc-438b-be21-5a5bfef4576d"
          },
          {
            "name": "EVM | Baseline Duration (days)",
            "description": "Source: Plans[Summary_BaselineStartDate].",
            "expression": [
              "",
              "SUMX (",
              "    Plans,",
              "    DATEDIFF (",
              "        Plans[Summary_BaselineStartDate],",
              "        Plans[Summary_BaselineEndDate],",
              "        DAY",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "EVM",
            "lineageTag": "bb9667c3-8801-40a9-83c3-dfd06594f8a6"
          },
          {
            "name": "EVM | Forecast Duration (days)",
            "description": "Source: Plans[Summary_StartDate].",
            "expression": [
              "",
              "SUMX (",
              "    Plans,",
              "    DATEDIFF (",
              "        COALESCE ( Plans[Summary_StartDate], Plans[EstimatedStart] ),",
              "        COALESCE ( Plans[Summary_EndDate],   Plans[EstimatedEnd]   ),",
              "        DAY",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "EVM",
            "lineageTag": "4e665253-e2f7-45bf-aedf-5714d02851f5"
          },
          {
            "name": "EVM | SPI (Schedule Performance Index)",
            "description": "Subject area: EVM.",
            "expression": [
              "",
              "// Primary: Baseline Duration / Forecast Duration  (time-phased proxy).",
              "// Fallback: ScheduleHealth_Value mapping            (categorical proxy).",
              "// Both blank: BLANK — the visual will then assume SPI = 1.0 and warn the user.",
              "VAR _dateBased = DIVIDE (",
              "    [EVM | Baseline Duration (days)],",
              "    [EVM | Forecast Duration (days)]",
              ")",
              "VAR _healthBased = [EVM | SPI from Health]",
              "RETURN",
              "    COALESCE ( _dateBased, _healthBased )",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "EVM",
            "lineageTag": "afbb20a1-846f-4b6a-aefe-eb72dbe96eb1"
          },
          {
            "name": "EVM | Forecast Overrun",
            "description": "Subject area: EVM.",
            "expression": [
              "",
              "VAR _eac = [EVM | EAC (Estimate at Completion)]",
              "VAR _bac = [EVM | BAC (Budget at Completion)]",
              "RETURN",
              "    IF ( _eac > _bac, _eac - _bac, 0 )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "EVM",
            "lineageTag": "71e6831d-5f90-460c-9625-1f1e19aec287"
          },
          {
            "name": "EVM | SPI from Health",
            "description": "Source: Plans[ScheduleHealth_Value].",
            "expression": [
              "",
              "VAR _h = LOWER ( SELECTEDVALUE ( Plans[ScheduleHealth_Value] ) )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        _h IN { \"on track\", \"green\", \"ontrack\" },                   1.00,",
              "        _h IN { \"at risk\", \"yellow\", \"caution\", \"cautious\" },     0.85,",
              "        _h IN { \"late\", \"behind\", \"red\", \"behind schedule\" },     0.70,",
              "        BLANK ()",
              "    )",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "EVM",
            "lineageTag": "900afaec-d053-4cfa-b7d3-53abdc81cd4d"
          },
          {
            "name": "Portfolio 360 | Active Projects",
            "description": "Source: Plans[State_Value].",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( Plans ),",
              "    NOT ( Plans[State_Value] IN { \"Closed\", \"Cancelled\", \"On Hold\" } )",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "69b282b9-329e-4310-b274-a48bc49632cf"
          },
          {
            "name": "Portfolio 360 | On-Time Flag",
            "description": "Source: Plans[ScheduleHealth_Value].",
            "expression": [
              "",
              "// 1 when the current row's ScheduleHealth is healthy, 0 otherwise.",
              "// The visual averages this to derive On-Time % per Segment / Period.",
              "VAR _h = LOWER ( SELECTEDVALUE ( Plans[ScheduleHealth_Value] ) )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        _h IN { \"on track\", \"green\", \"ontrack\" },               1,",
              "        _h IN { \"at risk\", \"yellow\", \"caution\", \"cautious\" }, 0,",
              "        _h IN { \"late\", \"behind\", \"red\", \"behind schedule\" }, 0,",
              "        BLANK ()",
              "    )",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "1a958efb-c240-44a0-95ff-8e76c183b7d5"
          },
          {
            "name": "Portfolio 360 | On-Time Delivery %",
            "description": "Source: Plans[ScheduleHealth_Value].",
            "expression": [
              "",
              "VAR _total = CALCULATE ( COUNTROWS ( Plans ), NOT ISBLANK ( Plans[ScheduleHealth_Value] ) )",
              "VAR _ok    = CALCULATE (",
              "        COUNTROWS ( Plans ),",
              "        LOWER ( Plans[ScheduleHealth_Value] ) IN { \"on track\", \"green\", \"ontrack\" }",
              "    )",
              "RETURN",
              "    DIVIDE ( _ok, _total )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "7f580460-16d3-4d79-bb71-3498909aed0a"
          },
          {
            "name": "Portfolio 360 | Budget MoM %",
            "description": "Source: Calendar[Date].",
            "expression": [
              "",
              "// Uses the Calendar[Date] date table. Falls back to BLANK when no period",
              "// column is in context.",
              "VAR _cur  = [Finance | Total Budget]",
              "VAR _prev = CALCULATE ( [Finance | Total Budget], DATEADD ( Calendar[Date], -1, MONTH ) )",
              "RETURN",
              "    DIVIDE ( _cur - _prev, _prev )",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "b72c5c4e-372a-48a4-bfbb-43c62f0d7eae"
          },
          {
            "name": "Portfolio 360 | On-Time Delivery MoM (pts)",
            "description": "Source: Calendar[Date].",
            "expression": [
              "",
              "VAR _cur  = [Portfolio 360 | On-Time Delivery %]",
              "VAR _prev = CALCULATE ( [Portfolio 360 | On-Time Delivery %], DATEADD ( Calendar[Date], -1, MONTH ) )",
              "RETURN",
              "    ( _cur - _prev ) * 100",
              ""
            ],
            "formatString": "+0.0;-0.0;0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "816d6ddd-025c-45dd-a813-a6ae0c587551"
          },
          {
            "name": "Portfolio 360 | Budget Target",
            "description": "Source: ModelerScenario[TargetBudget].",
            "expression": [
              "",
              "// Default target = current Total Budget. Override by binding your own target",
              "// measure (e.g. ModelerScenario[TargetBudget]) to the visual's Budget Target",
              "// role.",
              "[Finance | Total Budget]",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "78c81df8-cacb-4a34-895e-feacef35e161"
          },
          {
            "name": "Portfolio 360 | On-Time Target %",
            "description": "Subject area: Portfolio 360.",
            "expression": "0.95",
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "d634f51d-6b6e-4177-aace-a981b045e0ee"
          },
          {
            "name": "Portfolio 360 | Variance Threshold %",
            "description": "Subject area: Portfolio 360.",
            "expression": "0.05",
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "55060c83-c0b9-46b4-95b4-06902f8b607a"
          },
          {
            "name": "Portfolio 360 | Top Segment Name",
            "description": "Source: Plans[BusinessUnit_Value].",
            "expression": [
              "",
              "// Picks the highest-budget Business Unit in the current filter context.",
              "VAR _top =",
              "    TOPN (",
              "        1,",
              "        ADDCOLUMNS (",
              "            VALUES ( Plans[BusinessUnit_Value] ),",
              "            \"@b\", CALCULATE ( [Finance | Total Budget] )",
              "        ),",
              "        [@b], DESC",
              "    )",
              "RETURN",
              "    CONCATENATEX ( _top, Plans[BusinessUnit_Value], \", \" )",
              ""
            ],
            "displayFolder": "Portfolio 360",
            "lineageTag": "75daebb4-8dc9-49e6-bde3-e7d4be3b6013"
          },
          {
            "name": "Portfolio 360 | Top Segment Budget",
            "description": "Source: Plans[BusinessUnit_Value].",
            "expression": [
              "",
              "VAR _vals = ADDCOLUMNS (",
              "        VALUES ( Plans[BusinessUnit_Value] ),",
              "        \"@b\", CALCULATE ( [Finance | Total Budget] )",
              "    )",
              "RETURN",
              "    MAXX ( _vals, [@b] )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "fb1e7f2b-f0ec-4293-9d22-236a0f2826f7"
          },
          {
            "name": "Portfolio 360 | Top Segment % of Total",
            "description": "Source: Plans[BusinessUnit_Value].",
            "expression": [
              "",
              "DIVIDE (",
              "    [Portfolio 360 | Top Segment Budget],",
              "    CALCULATE ( [Finance | Total Budget], ALL ( Plans[BusinessUnit_Value] ) )",
              ")",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "aedf2062-b042-43be-92a9-a7e694b4e339"
          },
          {
            "name": "Portfolio 360 | Top Project Name",
            "description": "Source: Plans[Name].",
            "expression": [
              "",
              "VAR _top =",
              "    TOPN (",
              "        1,",
              "        ADDCOLUMNS (",
              "            VALUES ( Plans[Name] ),",
              "            \"@b\", CALCULATE ( [Finance | Total Budget] )",
              "        ),",
              "        [@b], DESC",
              "    )",
              "RETURN",
              "    CONCATENATEX ( _top, Plans[Name], \", \" )",
              ""
            ],
            "displayFolder": "Portfolio 360",
            "lineageTag": "a2babc6d-bb70-4959-b8a5-de41ca8ffe5a"
          },
          {
            "name": "Portfolio 360 | Top Project Budget",
            "description": "Source: Plans[Name].",
            "expression": [
              "",
              "VAR _vals = ADDCOLUMNS (",
              "        VALUES ( Plans[Name] ),",
              "        \"@b\", CALCULATE ( [Finance | Total Budget] )",
              "    )",
              "RETURN",
              "    MAXX ( _vals, [@b] )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "0ed28626-9b56-415b-b84f-bf325ee5aa2e"
          },
          {
            "name": "Portfolio 360 | Top Project % of Total",
            "description": "Source: Plans[Name].",
            "expression": [
              "",
              "DIVIDE (",
              "    [Portfolio 360 | Top Project Budget],",
              "    CALCULATE ( [Finance | Total Budget], ALL ( Plans[Name] ) )",
              ")",
              ""
            ],
            "formatString": "0.0%",
            "displayFolder": "Portfolio 360",
            "lineageTag": "d6c2a4db-cf7c-4f64-a954-eed9d4aa20d6"
          },
          {
            "name": "Portfolio 360 | At-Risk Count",
            "description": "Source: Plans[ScheduleHealth_Value].",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( Plans ),",
              "    LOWER ( Plans[ScheduleHealth_Value] ) IN { \"at risk\", \"yellow\", \"caution\", \"cautious\" }",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "c315a172-cfaa-4116-8558-a713047bb62b"
          },
          {
            "name": "Portfolio 360 | Slipping Count",
            "description": "Source: Plans[ScheduleHealth_Value].",
            "expression": [
              "",
              "CALCULATE (",
              "    COUNTROWS ( Plans ),",
              "    LOWER ( Plans[ScheduleHealth_Value] ) IN { \"late\", \"behind\", \"red\", \"behind schedule\" }",
              ")",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "d4f18783-a070-4c07-a90a-c4d83804b45d"
          },
          {
            "name": "Portfolio 360 | Avg Budget per Project",
            "description": "Subject area: Portfolio 360.",
            "expression": [
              "",
              "DIVIDE ( [Finance | Total Budget], [Portfolio 360 | Active Projects] )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "78ab37c7-dfae-40d1-b8b8-29565b26be11"
          },
          {
            "name": "Portfolio 360 | Avg Forecast Overrun per Project",
            "description": "Source: Plans[Forecast].",
            "expression": [
              "",
              "VAR _overrun = SUMX ( Plans, MAX ( Plans[Forecast] - Plans[Budget], 0 ) )",
              "VAR _n       = [Portfolio 360 | Active Projects]",
              "RETURN",
              "    DIVIDE ( _overrun, _n )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "0ff67c28-36fc-4bef-85f9-dd65f92299e4"
          },
          {
            "name": "Task | #Activities",
            "description": "Subject area: Task.",
            "expression": [
              "",
              "IF(",
              "    NOT ISEMPTY('Tasks'), ",
              "    COALESCE(COUNTROWS('Activities'), 0)",
              ")"
            ],
            "displayFolder": "Task",
            "lineageTag": "4a491d33-889b-4b2c-98c5-2b17e7737d01"
          },
          {
            "name": "Portfolio 360 | Utilization MoM (pts)",
            "description": "Source: Calendar[Date].",
            "expression": [
              "",
              "VAR _cur = [Capacity | Resource Utilization%]",
              "VAR _prv = CALCULATE ( [Capacity | Resource Utilization%], DATEADD ( Calendar[Date], -1, MONTH ) )",
              "RETURN",
              "    ( _cur - _prv ) * 100",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "35096322-d8e0-4062-bdeb-bf4144d9b43f"
          },
          {
            "name": "Portfolio 360 | Risks MoM",
            "description": "Source: Calendar[Date].",
            "expression": [
              "",
              "VAR _cur = [Portfolio | Portfolio - Total ActiveRisks]",
              "VAR _prv = CALCULATE ( [Portfolio | Portfolio - Total ActiveRisks], DATEADD ( Calendar[Date], -1, MONTH ) )",
              "RETURN",
              "    _cur - _prv",
              ""
            ],
            "formatString": "+#,##0;-#,##0;0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "5a73ea6a-fc64-450b-8683-b2ddc786da08"
          },
          {
            "name": "Portfolio 360 | Forecast Variance MoM (pts)",
            "description": "Source: Calendar[Date].",
            "expression": [
              "",
              "VAR _curVar = DIVIDE ( [Finance | Cost - Forecast] - [Finance | Total Budget], [Finance | Total Budget] )",
              "VAR _prvVar =",
              "    CALCULATE (",
              "        DIVIDE ( [Finance | Cost - Forecast] - [Finance | Total Budget], [Finance | Total Budget] ),",
              "        DATEADD ( Calendar[Date], -1, MONTH )",
              "    )",
              "RETURN",
              "    ( _curVar - _prvVar ) * 100",
              ""
            ],
            "formatString": "0.0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "78d32341-b956-42a6-b624-9b1df701930e"
          },
          {
            "name": "Portfolio 360 | Over-Allocated Departments",
            "description": "Source: Resources[Department_Value].",
            "expression": [
              "",
              "VAR _byDept =",
              "    ADDCOLUMNS (",
              "        VALUES ( Resources[Department_Value] ),",
              "        \"@Cap\", [Capacity | Resource Capacity],",
              "        \"@Dem\", [Capacity | Total Hours Scheduled]",
              "    )",
              "RETURN",
              "    COUNTROWS ( FILTER ( _byDept, [@Dem] > [@Cap] && [@Cap] > 0 ) )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "Portfolio 360",
            "lineageTag": "c7e7c6c1-60b7-4a5a-a399-e65545b18a22"
          },
          {
            "name": "SunkCost | Budget Consumed %",
            "description": "Budget Consumed as a ratio of Budget. X-axis of the Sunk Cost Decision Board. 0 = nothing spent; 1.0 = fully consumed; >1.0 = overspent.",
            "expression": [
              "",
              "VAR _spent = [Finance | Actual Cost]",
              "",
              "VAR _budget = [Finance | Budget Cost]",
              "",
              "RETURN",
              "    DIVIDE ( _spent, _budget )",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "SunkCost",
            "lineageTag": "67705456-f679-4737-a2eb-f73b2bc97ce8"
          },
          {
            "name": "SunkCost | Value Confidence Score",
            "description": "Project Health / Value Confidence score (0..1). Y-axis of the Sunk Cost Decision Board. 0 = failing; 1.0 = on track. Mapped from OverallHealth_Value (fallback ScheduleHealth_Value).",
            "expression": [
              "",
              "VAR _h = LOWER (",
              "    COALESCE (",
              "        SELECTEDVALUE ( Plans[OverallHealth_Value] ),",
              "        SELECTEDVALUE ( Plans[ScheduleHealth_Value] )",
              "    )",
              ")",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        CONTAINSSTRING ( _h, \"on track\" ),  1.00,",
              "        CONTAINSSTRING ( _h, \"green\" ),     1.00,",
              "        CONTAINSSTRING ( _h, \"(1)\" ),       1.00,",
              "        CONTAINSSTRING ( _h, \"at risk\" ),   0.55,",
              "        CONTAINSSTRING ( _h, \"yellow\" ),    0.55,",
              "        CONTAINSSTRING ( _h, \"caution\" ),   0.55,",
              "        CONTAINSSTRING ( _h, \"(2)\" ),       0.55,",
              "        CONTAINSSTRING ( _h, \"off track\" ), 0.20,",
              "        CONTAINSSTRING ( _h, \"late\" ),      0.20,",
              "        CONTAINSSTRING ( _h, \"behind\" ),    0.20,",
              "        CONTAINSSTRING ( _h, \"red\" ),       0.20,",
              "        CONTAINSSTRING ( _h, \"(3)\" ),       0.20,",
              "        0.50",
              "    )",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "SunkCost",
            "lineageTag": "455bd895-3625-43d9-9a15-b43e54e1ea20"
          },
          {
            "name": "SunkCost | Recoverable Budget",
            "description": "Recoverable Budget if the project is terminated now (Budget − Consumed, floored at zero). Drives the bubble area and the 'recovers $X' narrative in the Recommended Action card.",
            "expression": [
              "",
              "VAR _spent = [Finance | Actual Cost]",
              "",
              "VAR _budget = [Finance | Budget Cost]",
              "",
              "VAR _remain = _budget - _spent",
              "RETURN",
              "    IF ( _remain > 0, _remain, 0 )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "SunkCost",
            "lineageTag": "dee90fd6-63d6-4f7b-8e7e-8f753da8161c"
          },
          {
            "name": "SunkCost | Sunk Cost",
            "description": "Sunk Cost — money already consumed and not recoverable. Shown in the bubble tooltip and the 'has consumed $X of its budget' narrative.",
            "expression": [
              "",
              "VAR _spent = [Finance | Actual Cost]",
              "",
              "Return",
              "_spent"
            ],
            "formatString": "#,##0",
            "displayFolder": "SunkCost",
            "lineageTag": "9299f8b5-e95f-4146-bf73-cacd4c3d3af1"
          },
          {
            "name": "SunkCost | Overspend",
            "description": "Overspend ($) — amount consumed beyond Budget. Zero when the project is still within budget.",
            "expression": [
              "",
              "VAR _spent = [Finance | Actual Cost]",
              "",
              "VAR _budget = [Finance | Budget Cost]",
              "",
              "RETURN",
              "    IF ( _spent > _budget, _spent - _budget, 0 )",
              ""
            ],
            "formatString": "#,##0",
            "displayFolder": "SunkCost",
            "lineageTag": "1ba65de0-bd37-4fef-a503-0b16a51b6a2c"
          },
          {
            "name": "Benefits | Planned Benefits",
            "description": "Sum of the Benefits column on Plans — the expected/business-case value committed at plan approval. Denominator for Realization Rate.",
            "expression": "SUM ( Plans[Benefits] )",
            "formatString": "#,##0",
            "displayFolder": "Benefits",
            "lineageTag": "d805edbf-1208-4e85-a665-664e5d9421e3"
          },
          {
            "name": "Benefits | Realized Benefits",
            "description": "Realized portion of Planned Benefits, computed as Benefits × Summary_PercentDone / 100 per plan. Proxy until a true 'benefit realized to date' column lands on Plans.",
            "expression": [
              "",
              "SUMX (",
              "    Plans,",
              "    Plans[Benefits] * DIVIDE ( Plans[Summary_PercentDone], 100 )",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Benefits",
            "lineageTag": "0f21f969-0727-482d-84a1-2fc0e317e12c"
          },
          {
            "name": "Benefits | Realization Rate (%)",
            "description": "Realized ÷ Planned. Drives the per-project progress bar and the portfolio realization KPI.",
            "expression": [
              "",
              "DIVIDE (",
              "    [Benefits | Realized Benefits],",
              "    [Benefits | Planned Benefits]",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Benefits",
            "lineageTag": "1f7619f2-86e6-45bc-8b21-938f063e5f8d"
          },
          {
            "name": "Benefits | Budget",
            "description": "Sum of the Budget column on Plans — denominator for Cost-Benefit Ratio.",
            "expression": "SUM ( Plans[Budget] )",
            "formatString": "#,##0",
            "displayFolder": "Benefits",
            "lineageTag": "a7316aff-d3ac-4c08-872f-f2f16fb5cd19"
          },
          {
            "name": "Benefits | Actuals",
            "description": "Sum of the Actuals column on Plans — cost spent to date. Pairs with Budget for the Cost-Benefit Ratio toggle.",
            "expression": "SUM ( Plans[Actuals] )",
            "formatString": "#,##0",
            "displayFolder": "Benefits",
            "lineageTag": "eb816262-c9b7-4eba-b693-01c7480f2c2d"
          },
          {
            "name": "Benefits | % Done",
            "description": "Benefits-weighted Summary_PercentDone across the visible plans. Bound to the visual's % Done role.",
            "expression": [
              "",
              "DIVIDE (",
              "    SUMX ( Plans, Plans[Summary_PercentDone] * Plans[Benefits] ),",
              "    SUMX ( Plans, Plans[Benefits] )",
              ") / 100"
            ],
            "formatString": "0.0%",
            "displayFolder": "Benefits",
            "lineageTag": "2e8813df-1a2e-4656-b268-79cb6fd08096"
          },
          {
            "name": "Benefits | Cost-Benefit Ratio",
            "description": "Planned Benefits ÷ Budget. >1 means each $ of budget returns more than $1 of expected benefit.",
            "expression": [
              "",
              "DIVIDE (",
              "    [Benefits | Planned Benefits],",
              "    [Benefits | Budget]",
              ")"
            ],
            "formatString": "0.00",
            "displayFolder": "Benefits",
            "lineageTag": "93cfc0ac-9247-472c-82f1-13e716b54478"
          },
          {
            "name": "SunkCost | Budget Consumed % — Prior",
            "description": "Prior-period Budget Consumed %. Drives the trajectory arrow tail in the Sunk Cost Decision Board. Adjust the DATEADD shift to match your model's snapshot cadence. Returns BLANK() when no prior period exists (visual then skips the arrow).",
            "expression": [
              "",
              "VAR _shift = -1   -- months back; change to -7 for prior week, etc.",
              "RETURN",
              "    CALCULATE (",
              "        [SunkCost | Budget Consumed %],",
              "        DATEADD ( calendar[Date], _shift, MONTH )",
              "    )",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "SunkCost",
            "lineageTag": "3e23dc82-ad21-478b-b184-76b291b63758"
          },
          {
            "name": "SunkCost | Value Confidence Score — Prior",
            "description": "Prior-period Project Health / Value Confidence score. Drives the trajectory arrow tail (Y) in the Sunk Cost Decision Board. Adjust DATEADD shift to match the model snapshot cadence. Returns BLANK() when no prior period exists.",
            "expression": [
              "",
              "VAR _shift = -1   -- months back; mirror the shift used in 'Budget Consumed % — Prior'",
              "RETURN",
              "    CALCULATE (",
              "        [SunkCost | Value Confidence Score],",
              "        DATEADD ( calendar[Date], _shift, MONTH )",
              "    )",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "SunkCost",
            "lineageTag": "f5e54caf-2e3a-42b2-bd60-4cc4d2a3ce7a"
          },
          {
            "name": "SunkCost | Sunk Cost Index",
            "description": "Sunk Cost Index — composite ranking. Higher = bigger-$ bleeder. Formula: (1 − health) × budgetConsumed × LN(budget + 1). Optional — the visual computes SCI internally; bind this only when you want to expose the ranking elsewhere.",
            "expression": [
              "",
              "VAR _health  = [SunkCost | Value Confidence Score]",
              "VAR _budget  = [Finance | Budget Cost]",
              "VAR _consPct = [SunkCost | Budget Consumed %]",
              "VAR _gap     = MAX ( 0, 1 - _health )",
              "RETURN",
              "    _gap * _consPct * LN ( _budget + 1 )",
              "    ",
              "    ",
              "    ",
              ""
            ],
            "formatString": "0.00",
            "displayFolder": "SunkCost",
            "lineageTag": "d51393d8-a99e-47ea-a49b-5ec7b74c93e8"
          },
          {
            "name": "Modeler | Baseline Return",
            "description": "TotalBenefits of the Baseline scenario, exposed as a constant for incremental calculations.",
            "expression": "CALCULATE ( [Modeler | Scenario Return], ALL ( ModelerScenario ), ModelerScenario[Name] = \"Baseline\" )",
            "formatString": "#,0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "69e29556-50ae-493c-b773-9b9ca34ed198"
          },
          {
            "name": "Modeler | Incremental Return",
            "description": "Benefit delta vs Baseline. Bind to the Expected Return data role. Baseline scenario = 0; positive = adds value; negative = destroys value vs do-nothing.",
            "expression": "[Modeler | Scenario Return] - [Modeler | Baseline Return]",
            "formatString": "#,0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "0289bf62-d40c-46c7-ab04-609501ebc7b0"
          },
          {
            "name": "Modeler | IsFrontierPoint",
            "description": "Efficient Frontier. Source: ModelerScenario[TotalBudget].",
            "expression": "VAR _name = SELECTEDVALUE ( ModelerScenario[Name] ) VAR _risk = [Modeler | Scenario Risk] VAR _ret  = [Modeler | Incremental Return] VAR _portfolios =     ADDCOLUMNS (         FILTER ( ALL ( ModelerScenario[Name] ), ModelerScenario[Name] <> \"Baseline\" ),         \"R\", [Modeler | Scenario Risk],         \"E\", [Modeler | Incremental Return]     ) RETURN     IF (         _name = \"Baseline\", 0,         IF (             _risk > 0 && _ret > 0                 && COUNTROWS ( FILTER ( _portfolios, [R] <= _risk && [E] > _ret ) ) = 0,             1, 0         )     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "7f02ece9-4687-4a20-afcc-6b1b551d2498"
          },
          {
            "name": "Modeler | IsOptimalPoint",
            "description": "Efficient Frontier. Source: ModelerScenario[TotalBudget].",
            "expression": "VAR _name = SELECTEDVALUE ( ModelerScenario[Name] ) VAR _risk = [Modeler | Scenario Risk] VAR _ret  = [Modeler | Incremental Return] VAR _sharpe = DIVIDE ( _ret, _risk ) VAR _allSharpes =     ADDCOLUMNS (         FILTER ( ALL ( ModelerScenario[Name] ), ModelerScenario[Name] <> \"Baseline\" ),         \"S\", DIVIDE ( [Modeler | Incremental Return], [Modeler | Scenario Risk] )     ) VAR _maxS = MAXX ( _allSharpes, [S] ) RETURN     IF ( _name <> \"Baseline\" && _risk > 0 && _ret > 0 && _sharpe = _maxS, 1, 0 )",
            "formatString": "0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "ba8e5588-d3de-4312-a4cf-68ba88aa316c"
          },
          {
            "name": "Modeler | Rf Return",
            "description": "Risk-free return = 0 in the incremental framing (Baseline anchors at origin). Used as CAL anchor and Sharpe denominator.",
            "expression": "0",
            "formatString": "#,0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "6abe1a77-196d-4bd2-b8af-9c0f11601f63"
          },
          {
            "name": "Modeler | Scenario Return",
            "description": "Efficient Frontier. Source: ModelerScenario[TotalBenefits].",
            "expression": "SUM ( ModelerScenario[TotalBenefits] )",
            "formatString": "#,0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "0d609c88-80e8-44dd-9935-20b2239ff968"
          },
          {
            "name": "Modeler | Scenario Risk",
            "description": "Efficient Frontier. Source: ModelerScenario[TotalBudget].",
            "expression": [
              "VAR _total =",
              "    SUM ( ModelerScenario[TotalBudget] )",
              "VAR _target =",
              "    SUM ( ModelerScenario[TargetBudget] )",
              "RETURN",
              "    IF ( _target <> 0, ABS ( _total - _target ) / _target * 100, 0 )"
            ],
            "formatString": "0.00",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "c70fcfa9-ec83-4e5c-af04-9252715c2065"
          },
          {
            "name": "Modeler | Sharpe Ratio",
            "description": "Incremental Return / Risk. Higher = better risk-adjusted return. Negative = plan destroys value vs Baseline.",
            "expression": "DIVIDE ( [Modeler | Incremental Return], [Modeler | Scenario Risk] )",
            "formatString": "0.0000",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "44b69d8d-c315-43ce-a46c-feec2037335b"
          },
          {
            "name": "Modeler | Membership",
            "description": "Returns 1 if the current project (Plans[Name] context) is part of the current scenario (ModelerScenario[Name] context), else 0. Bind to the Scenario Membership data role on the Efficient Frontier visual (project-mode).",
            "expression": [
              "VAR _proj = MAX ( Plans[Name] )",
              "VAR _scn  =",
              "    CALCULATE (",
              "        MAX ( ModelerScenario[Name] ),",
              "        ALLEXCEPT ( ModelerScenario, ModelerScenario[Name] )    -- strips Plans→ModelerModel→ModelerScenario propagation",
              "    )",
              "VAR _hits =",
              "    CALCULATE (",
              "        COUNTROWS ( ModelerScenarioPlan ),",
              "        ALL ( ModelerScenarioPlan ),",
              "        ModelerScenarioPlan[Name] = _proj,",
              "        ModelerScenarioPlan[ParentScenarioName] = _scn,",
              "        ModelerScenarioPlan[Checked] = TRUE ()",
              "    )",
              "RETURN",
              "    IF ( NOT ISBLANK ( _proj ) && NOT ISBLANK ( _scn ) && _hits > 0, 1, 0 )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "e1fe2076-9a34-4616-b579-cb4a72954463"
          },
          {
            "name": "Modeler | Project Value",
            "description": "Per-project value / benefit. Bind to the Project Value data role.",
            "expression": "SUM ( Plans[Benefits] )",
            "formatString": "#,0",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "22fcb128-c80d-4edd-8a69-602bb929ad7e"
          },
          {
            "name": "Modeler | Target Budget",
            "expression": "MAX(ModelerScenario[TargetBudget])",
            "displayFolder": "Modeler\\Efficient Frontier",
            "lineageTag": "6543c491-62f6-4c8d-bb8d-5d07642b1251"
          },
          {
            "name": "Modeler | Budget Fit Chip",
            "description": "Text chip for the Budget Fit constraint. Pair with conditional background colour by Score.",
            "expression": "VAR _s = [Modeler | Budget Fit Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● On budget\",         _s =  0, \"● Stretch\",         _s = -1, \"● Over budget\"     )",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "09e9b9b2-ddad-47e2-bca8-b5bb6e07f140"
          },
          {
            "name": "Modeler | Budget Fit Score",
            "description": "+1 pass / 0 watch / -1 fail. Pass if TotalBudget <= 1.05x Target; watch <= 1.10x.",
            "expression": "VAR _total  = SUM ( ModelerScenario[TotalBudget] ) VAR _target = SUM ( ModelerScenario[TargetBudget] ) VAR _ratio  = DIVIDE ( _total, _target ) RETURN     SWITCH ( TRUE (),         _target = 0, BLANK (),         _ratio <= 1.05, 1,         _ratio <= 1.10, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "39933087-ca0e-40da-83c6-80682c2b0fe5"
          },
          {
            "name": "Modeler | Resource Fit Chip",
            "description": "Text chip for the Resource Fit constraint.",
            "expression": "VAR _s = [Modeler | Resource Fit Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● Within capacity\",         _s =  0, \"● Tight\",         _s = -1, \"● Over capacity\"     )",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "990366d7-08db-4cda-9145-b38590c6a355"
          },
          {
            "name": "Modeler | Resource Fit Score",
            "description": "+1 pass (effort <= 0.90x ceiling) / 0 watch / -1 fail (>100% ceiling). Edit capacityCeiling constant for your org.",
            "expression": "VAR _effort   = SUM ( ModelerScenario[TotalCommittedEffort] ) VAR _ceiling  = 25000 VAR _ratio    = DIVIDE ( _effort, _ceiling ) RETURN     SWITCH ( TRUE (),         _ceiling = 0, BLANK (),         _ratio <= 0.90, 1,         _ratio <= 1, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "ed84f39f-dde3-40bf-8027-a2e5a89709a2"
          },
          {
            "name": "Modeler | Risk Tol Chip",
            "description": "Text chip for Risk Tolerance.",
            "expression": "VAR _s = [Modeler | Risk Tol Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● Low risk\",         _s =  0, \"● Elevated\",         _s = -1, \"● High risk\"     )",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "3a9fe41b-e97a-45c1-b836-3f17df4d3d71"
          },
          {
            "name": "Modeler | Risk Tol Score",
            "description": "+1 if Scenario Risk <= 20; 0 if <= 35; else -1.",
            "expression": "VAR _risk = [Modeler | Scenario Risk] RETURN     SWITCH ( TRUE (),         ISBLANK ( _risk ), BLANK (),         _risk <= 20, 1,         _risk <= 35, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips",
            "lineageTag": "c03ea9f5-c814-430d-b994-30553b583f2f"
          },
          {
            "name": "Modeler | Budget Fit Chip (Absolute)",
            "description": "Filter-immune Budget Fit chip — use in governance / printed views where the verdict must not shift with cross-filter context.",
            "expression": "VAR _s = [Modeler | Budget Fit Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● On budget\",         _s =  0, \"● Stretch\",         _s = -1, \"● Over budget\"     )",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "476c8aef-6810-426a-8f86-9a7a76277325"
          },
          {
            "name": "Modeler | Budget Fit Score (Absolute)",
            "description": "Filter-immune Budget Fit Score. Always evaluates against the row's own scenario, ignoring cross-filter on ModelerScenario[Name] from other visuals.",
            "expression": "VAR _total  = CALCULATE ( SUM ( ModelerScenario[TotalBudget] ), ALLEXCEPT ( ModelerScenario, ModelerScenario[Name] ) ) VAR _target = CALCULATE ( SUM ( ModelerScenario[TargetBudget] ), ALLEXCEPT ( ModelerScenario, ModelerScenario[Name] ) ) VAR _ratio  = DIVIDE ( _total, _target ) RETURN     SWITCH ( TRUE (),         _target = 0, BLANK (),         _ratio <= 1.05, 1,         _ratio <= 1.10, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "3a0cdbe2-6d68-44a9-b64b-985d5dc0e9d6"
          },
          {
            "name": "Modeler | Resource Fit Chip (Absolute)",
            "description": "Filter-immune Resource Fit chip.",
            "expression": "VAR _s = [Modeler | Resource Fit Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● Within capacity\",         _s =  0, \"● Tight\",         _s = -1, \"● Over capacity\"     )",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "5995aa76-8afd-47d5-acc4-657f21578bf3"
          },
          {
            "name": "Modeler | Resource Fit Score (Absolute)",
            "description": "Filter-immune Resource Fit Score.",
            "expression": "VAR _effort   = CALCULATE ( SUM ( ModelerScenario[TotalCommittedEffort] ), ALLEXCEPT ( ModelerScenario, ModelerScenario[Name] ) ) VAR _ceiling  = 25000 VAR _ratio    = DIVIDE ( _effort, _ceiling ) RETURN     SWITCH ( TRUE (),         _ceiling = 0, BLANK (),         _ratio <= 0.90, 1,         _ratio <= 1, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "9aa6fde9-5e77-4976-a1c8-42660d1d6bf6"
          },
          {
            "name": "Modeler | Risk Tol Chip (Absolute)",
            "description": "Filter-immune Risk Tolerance chip.",
            "expression": "VAR _s = [Modeler | Risk Tol Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), \"—\",         _s =  1, \"● Low risk\",         _s =  0, \"● Elevated\",         _s = -1, \"● High risk\"     )",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "b7cded97-46b4-41dd-a8ef-22c53712ae1a"
          },
          {
            "name": "Modeler | Risk Tol Score (Absolute)",
            "description": "Filter-immune Risk Tolerance Score. Pins [Modeler | Scenario Risk] to the row's scenario.",
            "expression": "VAR _risk = CALCULATE ( [Modeler | Scenario Risk], ALLEXCEPT ( ModelerScenario, ModelerScenario[Name] ) ) RETURN     SWITCH ( TRUE (),         ISBLANK ( _risk ), BLANK (),         _risk <= 20, 1,         _risk <= 35, 0,         -1     )",
            "formatString": "0",
            "displayFolder": "Modeler\\Constraint Chips (Absolute)",
            "lineageTag": "f87f721e-9ce9-4792-9fb8-b302fdd53645"
          },
          {
            "name": "ScenarioCompare | Membership (A)",
            "description": "Project membership flag for the scenario picked via the ModelerScenario_A slicer. Returns 1 when the current Plan_Projects[Name] is checked in that scenario; falls back to the page filter context when no pick.",
            "expression": [
              "VAR _s    = SELECTEDVALUE ( ModelerScenario_A[Name] )",
              "VAR _proj = COALESCE ( SELECTEDVALUE ( Plan_Projects[Name] ), SELECTEDVALUE ( Plans[Name] ) )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _proj ),",
              "        0,",
              "        IF (",
              "            ISBLANK ( _s ),",
              "            CALCULATE (",
              "                IF ( COUNTROWS ( ModelerScenarioPlan ) > 0, 1, 0 ),",
              "                ModelerScenarioPlan[Name]    = _proj,",
              "                ModelerScenarioPlan[Checked] = TRUE ()",
              "            ),",
              "            CALCULATE (",
              "                IF ( COUNTROWS ( ModelerScenarioPlan ) > 0, 1, 0 ),",
              "                ModelerScenarioPlan[Name]               = _proj,",
              "                ModelerScenarioPlan[ParentScenarioName] = _s,",
              "                ModelerScenarioPlan[Checked]            = TRUE ()",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "418e5e5d-6978-4069-a544-8f67171ca4e1"
          },
          {
            "name": "ScenarioCompare | Membership (B)",
            "description": "Project membership flag for the scenario picked via the ModelerScenario_B slicer.",
            "expression": [
              "VAR _s    = SELECTEDVALUE ( ModelerScenario_B[Name] )",
              "VAR _proj = COALESCE ( SELECTEDVALUE ( Plan_Projects[Name] ), SELECTEDVALUE ( Plans[Name] ) )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _proj ),",
              "        0,",
              "        IF (",
              "            ISBLANK ( _s ),",
              "            CALCULATE (",
              "                IF ( COUNTROWS ( ModelerScenarioPlan ) > 0, 1, 0 ),",
              "                ModelerScenarioPlan[Name]    = _proj,",
              "                ModelerScenarioPlan[Checked] = TRUE ()",
              "            ),",
              "            CALCULATE (",
              "                IF ( COUNTROWS ( ModelerScenarioPlan ) > 0, 1, 0 ),",
              "                ModelerScenarioPlan[Name]               = _proj,",
              "                ModelerScenarioPlan[ParentScenarioName] = _s,",
              "                ModelerScenarioPlan[Checked]            = TRUE ()",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "09aa2724-4172-45c2-b9e3-9a0f29ea33c0"
          },
          {
            "name": "ScenarioCompare | Committed (A)",
            "description": "Committed demand hours for the scenario picked via ModelerScenario_A. Restricts ResPlan to plans checked in that scenario.",
            "expression": [
              "VAR _s = SELECTEDVALUE ( ModelerScenario_A[Name] )",
              "VAR _checkedNames =",
              "    CALCULATETABLE (",
              "        VALUES ( ModelerScenarioPlan[Name] ),",
              "        ModelerScenarioPlan[ParentScenarioName] = _s,",
              "        ModelerScenarioPlan[Checked]            = TRUE ()",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _s ),",
              "        [Capacity | Committed],",
              "        CALCULATE (",
              "            [Capacity | Committed],",
              "            TREATAS ( _checkedNames, Plans[Name] )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "90171d99-fd30-4a48-8c0f-ba002f80ecd5"
          },
          {
            "name": "ScenarioCompare | Committed (B)",
            "description": "Committed demand hours for the scenario picked via ModelerScenario_B.",
            "expression": [
              "VAR _s = SELECTEDVALUE ( ModelerScenario_B[Name] )",
              "VAR _checkedNames =",
              "    CALCULATETABLE (",
              "        VALUES ( ModelerScenarioPlan[Name] ),",
              "        ModelerScenarioPlan[ParentScenarioName] = _s,",
              "        ModelerScenarioPlan[Checked]            = TRUE ()",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _s ),",
              "        [Capacity | Committed],",
              "        CALCULATE (",
              "            [Capacity | Committed],",
              "            TREATAS ( _checkedNames, Plans[Name] )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "44932ba3-0555-492c-b384-29b945de7a95"
          },
          {
            "name": "ScenarioCompare | Committed Effort (A)",
            "description": "Committed effort hours for the scenario picked via ModelerScenario_A. Filters Plan_Projects to checked plans.",
            "expression": [
              "VAR _s = SELECTEDVALUE ( ModelerScenario_A[Name] )",
              "VAR _checkedNames =",
              "    CALCULATETABLE (",
              "        VALUES ( ModelerScenarioPlan[Name] ),",
              "        ModelerScenarioPlan[ParentScenarioName] = _s,",
              "        ModelerScenarioPlan[Checked]            = TRUE ()",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _s ),",
              "        [Task | Committed Effort],",
              "        CALCULATE (",
              "            [Task | Committed Effort],",
              "            TREATAS ( _checkedNames, Plan_Projects[Name] )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "83ee0438-1457-4803-9f16-edd35df90bfe"
          },
          {
            "name": "ScenarioCompare | Committed Effort (B)",
            "description": "Committed effort hours for the scenario picked via ModelerScenario_B.",
            "expression": [
              "VAR _s = SELECTEDVALUE ( ModelerScenario_B[Name] )",
              "VAR _checkedNames =",
              "    CALCULATETABLE (",
              "        VALUES ( ModelerScenarioPlan[Name] ),",
              "        ModelerScenarioPlan[ParentScenarioName] = _s,",
              "        ModelerScenarioPlan[Checked]            = TRUE ()",
              "    )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _s ),",
              "        [Task | Committed Effort],",
              "        CALCULATE (",
              "            [Task | Committed Effort],",
              "            TREATAS ( _checkedNames, Plan_Projects[Name] )",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Modeler\\Scenario Comparison",
            "lineageTag": "cbfe6304-16a0-4926-99ee-761a491ccb3a"
          }
