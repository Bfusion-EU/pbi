          {
            "type": "calculated",
            "name": "Probability Category",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH(",
              "    TRUE(),",
              "    Tasks[Probability] >= 75, \"(1) Critical\",",
              "    Tasks[Probability] >= 50, \"(2) High\",",
              "    Tasks[Probability] >= 25, \"(3) Medium\",",
              "    \"(4) Low\"",
              ")",
              "",
              ""
            ],
            "lineageTag": "189ff560-f324-45dc-b0a3-132fdaa62e30",
            "summarizeBy": "none",
            "changedProperties": [
              {
                "property": "IsHidden"
