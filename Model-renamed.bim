          {
            "name": "Resource KPI | Total Resources",
            "description": "Source: Resources[UserId].",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT(Resources[UserId]),",
              "    Resources[Inactive] = FALSE()",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "6b8818fb-559c-4504-9bcd-8421a28cc4de"
          },
          {
            "name": "Resource KPI | Allocated Resources",
            "description": "Source: ResPlan[ResourceId].",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT(ResPlan[ResourceId]),",
              "    ResPlan[CostType] = \"Scheduled\"",
              ")"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "1293aecd-f8a1-46e8-b975-916b5af73d23"
          },
          {
            "name": "Resource KPI | Under-utilized Resources",
            "description": "Source: Resources[UserId].",
            "expression": [
              "VAR _ResAllocTable =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES(Resources[UserId]),",
              "            CALCULATE(COUNTROWS(Capacity)) > 0",
              "        ),",
              "        \"@MaxAlloc\",",
              "            CALCULATE(",
              "                MAXX(",
              "                    SUMMARIZE(Calendar, Calendar[Period]),",
              "                    CALCULATE([Capacity | Resource Utilization%])",
              "                )",
              "            ),",
              "        \"@HasAnyAlloc\",",
              "            CALCULATE(",
              "                COUNTROWS(",
              "                    FILTER(",
              "                        SUMMARIZE(Calendar, Calendar[Period]),",
              "                        CALCULATE([Capacity | Resource Utilization%]) > 0",
              "                    )",
              "                )",
              "            )",
              "    )",
              "RETURN",
              "    COUNTROWS(",
              "        FILTER(",
              "            _ResAllocTable,",
              "            [@HasAnyAlloc] > 0 && [@MaxAlloc] < 0.25",
              "        )",
              "    )"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "c5417bb3-05b7-49c4-bb91-144f5ca5e37a"
          },
          {
            "name": "Resource KPI | Alloc Bucket 0",
            "description": "Source: Resources[UserId].",
            "expression": [
              "VAR _ResAllocTable =",
              "    ADDCOLUMNS(",
              "        FILTER(",
              "            VALUES(Resources[UserId]),",
              "            CALCULATE(COUNTROWS(Capacity)) > 0",
              "        ),",
              "        \"@MaxAlloc\",",
              "            CALCULATE(",
              "                MAXX(",
              "                    SUMMARIZE(Calendar, Calendar[Period]),",
              "                    CALCULATE([Capacity | Resource Utilization%])",
              "                )",
              "            )",
              "    )",
              "RETURN",
              "    COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] = 0))"
            ],
            "formatString": "#,##0",
            "displayFolder": "Resource KPI",
            "lineageTag": "a8486591-7d70-4b23-b0d5-d313b3f77cc7"
          },
          {
