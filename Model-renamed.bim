        "partitions": [
          {
            "name": "_Modeler_SensitivityParams",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "    \"Parameter\",  STRING,",
                "    \"Variation\",  DOUBLE,",
                "    \"SortOrder\",  INTEGER,",
                "    {",
                "        {\"Budget Constraint\",      0.20, 1},",
                "        {\"Benefits Target\",        0.20, 2},",
                "        {\"Committed Effort Limit\", 0.15, 3},",
                "        {\"Selected Plan Count\",    0.25, 4},",
                "        {\"Budget Utilization\",     0.20, 5}",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
