                "let",
                "    Source = OData.Feed(OnePlanURL, null, [Implementation=\"2.0\"]),",
                "    Tasks_table = Source{[Name=\"Tasks\",Signature=\"table\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Tasks_table,{{\"Created\", type date}, {\"Modified\", type date}, {\"StartDate\", type date}, {\"EndDate\", type date}}),",
