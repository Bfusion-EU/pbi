	partition FactAssignment = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="Assignments", Signature="table"]}[Data],
				    DimT = DimTask, DimR = DimResource,
				    J1 = Table.NestedJoin(Raw, {"TaskId"}, DimT, {"TaskBK"}, "_T", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "_T", {"TaskKey", "ProjectKey"}, {"TaskKey", "ProjectKey"}),
				    J2 = Table.NestedJoin(E1, {"UserId"}, DimR, {"ResourceBK"}, "_R", JoinKind.LeftOuter),
				    E2 = Table.ExpandTableColumn(J2, "_R",
				        {"ResourceKey", "Name", "Department_Value", "Role_Value"},
				        {"ResourceKey", "AssignedResource", "Department_Value", "Role_Value"})
				in
				    E2

