/// Disconnected picker for scenario comparison. Bind a slicer to ModelerScenario_B[Name] and use ScenarioCompare measures.
table ModelerScenario_B
	lineageTag: 0856f08b-17c5-415b-b72d-7a7249112bda

	column Name
		lineageTag: a4f539ed-e44f-42a1-9c73-3130457a7deb
		isNameInferred
		sourceColumn: [Name]

	partition ModelerScenario_B = calculated
		mode: import
		source = DISTINCT ( SELECTCOLUMNS ( DimScenario, "Name", DimScenario[Name] ) )

