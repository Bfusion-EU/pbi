	partition BridgePlanDependency = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="PlanDependency", Signature="table"]}[Data],
				    DimP = DimProject,
				    J1 = Table.NestedJoin(Raw, {"FromPlan"}, DimP, {"ProjectBK"}, "_F", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "_F", {"ProjectKey"}, {"FromProjectKey"}),
				    J2 = Table.NestedJoin(E1, {"ToPlan"}, DimP, {"ProjectBK"}, "_T", JoinKind.LeftOuter),
				    E2 = Table.ExpandTableColumn(J2, "_T", {"ProjectKey"}, {"ToProjectKey"})
				in
				    E2

