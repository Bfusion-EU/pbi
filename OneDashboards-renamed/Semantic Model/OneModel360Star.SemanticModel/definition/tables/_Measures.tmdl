	/// Source: Calendar[Date].
	measure 'Portfolio 360 | Forecast Variance MoM (pts)' = ```
			
			VAR _curVar = DIVIDE ( [Finance | Cost - Forecast] - [Finance | Total Budget], [Finance | Total Budget] )
			VAR _prvVar =
			    CALCULATE (
			        DIVIDE ( [Finance | Cost - Forecast] - [Finance | Total Budget], [Finance | Total Budget] ),
			        DATEADD ( DimDate[Date], -1, MONTH )
			    )
			RETURN
			    ( _curVar - _prvVar ) * 100
			
			```
		formatString: 0.0
		displayFolder: Portfolio 360
		lineageTag: 78d32341-b956-42a6-b624-9b1df701930e

	/// Source: Resources[Department_Value].
	measure 'Portfolio 360 | Over-Allocated Departments' = ```
			
			VAR _byDept =
			    ADDCOLUMNS (
			        VALUES ( DimResource[Department_Value] ),
			        "@Cap", [Capacity | Resource Capacity],
			        "@Dem", [Capacity | Total Hours Scheduled]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _byDept, [@Dem] > [@Cap] && [@Cap] > 0 ) )
			
			```
		formatString: #,##0
		displayFolder: Portfolio 360
		lineageTag: c7e7c6c1-60b7-4a5a-a399-e65545b18a22

	/// Budget Consumed as a ratio of Budget. X-axis of the Sunk Cost Decision Board. 0 = nothing spent; 1.0 = fully consumed; >1.0 = overspent.
	measure 'SunkCost | Budget Consumed %' = ```
			
			VAR _spent = [Finance | Actual Cost]
			
			VAR _budget = [Finance | Budget Cost]
			
			RETURN
			    DIVIDE ( _spent, _budget )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SunkCost
		lineageTag: 67705456-f679-4737-a2eb-f73b2bc97ce8

	/// Project Health / Value Confidence score (0..1). Y-axis of the Sunk Cost Decision Board. 0 = failing; 1.0 = on track. Mapped from OverallHealth_Value (fallback ScheduleHealth_Value).
	measure 'SunkCost | Value Confidence Score' = ```
			
			VAR _h = LOWER (
			    COALESCE (
			        SELECTEDVALUE ( DimProject[OverallHealth_Value] ),
			        SELECTEDVALUE ( DimProject[ScheduleHealth_Value] )
			    )
			)
			RETURN
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( _h, "on track" ),  1.00,
			        CONTAINSSTRING ( _h, "green" ),     1.00,
			        CONTAINSSTRING ( _h, "(1)" ),       1.00,
			        CONTAINSSTRING ( _h, "at risk" ),   0.55,
			        CONTAINSSTRING ( _h, "yellow" ),    0.55,
			        CONTAINSSTRING ( _h, "caution" ),   0.55,
			        CONTAINSSTRING ( _h, "(2)" ),       0.55,
			        CONTAINSSTRING ( _h, "off track" ), 0.20,
			        CONTAINSSTRING ( _h, "late" ),      0.20,
			        CONTAINSSTRING ( _h, "behind" ),    0.20,
			        CONTAINSSTRING ( _h, "red" ),       0.20,
			        CONTAINSSTRING ( _h, "(3)" ),       0.20,
			        0.50
			    )
			
			```
		formatString: 0.00
		displayFolder: SunkCost
		lineageTag: 455bd895-3625-43d9-9a15-b43e54e1ea20

	/// Recoverable Budget if the project is terminated now (Budget − Consumed, floored at zero). Drives the bubble area and the 'recovers $X' narrative in the Recommended Action card.
	measure 'SunkCost | Recoverable Budget' = ```
			
			VAR _spent = [Finance | Actual Cost]
			
			VAR _budget = [Finance | Budget Cost]
			
			VAR _remain = _budget - _spent
			RETURN
			    IF ( _remain > 0, _remain, 0 )
			
			```
		formatString: #,##0
		displayFolder: SunkCost
		lineageTag: dee90fd6-63d6-4f7b-8e7e-8f753da8161c

	/// Sunk Cost — money already consumed and not recoverable. Shown in the bubble tooltip and the 'has consumed $X of its budget' narrative.
	measure 'SunkCost | Sunk Cost' =
			
			VAR _spent = [Finance | Actual Cost]
			
			Return
			_spent
		formatString: #,##0
		displayFolder: SunkCost
		lineageTag: 9299f8b5-e95f-4146-bf73-cacd4c3d3af1

	/// Overspend ($) — amount consumed beyond Budget. Zero when the project is still within budget.
	measure 'SunkCost | Overspend' = ```
			
			VAR _spent = [Finance | Actual Cost]
			
			VAR _budget = [Finance | Budget Cost]
			
			RETURN
			    IF ( _spent > _budget, _spent - _budget, 0 )
			
			```
		formatString: #,##0
		displayFolder: SunkCost
		lineageTag: 1ba65de0-bd37-4fef-a503-0b16a51b6a2c

	/// Sum of the Benefits column on Plans — the expected/business-case value committed at plan approval. Denominator for Realization Rate.
	measure 'Benefits | Planned Benefits' = SUM ( DimProject[Benefits] )
		formatString: #,##0
		displayFolder: Benefits
		lineageTag: d805edbf-1208-4e85-a665-664e5d9421e3

	/// Realized portion of Planned Benefits, computed as Benefits × Summary_PercentDone / 100 per plan. Proxy until a true 'benefit realized to date' column lands on Plans.
	measure 'Benefits | Realized Benefits' =
			
			SUMX (
			    DimProject,
			    DimProject[Benefits] * DIVIDE ( DimProject[Summary_PercentDone], 100 )
			)
		formatString: #,##0
		displayFolder: Benefits
		lineageTag: 0f21f969-0727-482d-84a1-2fc0e317e12c

	/// Realized ÷ Planned. Drives the per-project progress bar and the portfolio realization KPI.
	measure 'Benefits | Realization Rate (%)' =
			
			DIVIDE (
			    [Benefits | Realized Benefits],
			    [Benefits | Planned Benefits]
			)
		formatString: 0.0%
		displayFolder: Benefits
		lineageTag: 1f7619f2-86e6-45bc-8b21-938f063e5f8d

	/// Sum of the Budget column on Plans — denominator for Cost-Benefit Ratio.
	measure 'Benefits | Budget' = SUM ( DimProject[Budget] )
		formatString: #,##0
		displayFolder: Benefits
		lineageTag: a7316aff-d3ac-4c08-872f-f2f16fb5cd19

	/// Sum of the Actuals column on Plans — cost spent to date. Pairs with Budget for the Cost-Benefit Ratio toggle.
	measure 'Benefits | Actuals' = SUM ( DimProject[Actuals] )
		formatString: #,##0
		displayFolder: Benefits
		lineageTag: eb816262-c9b7-4eba-b693-01c7480f2c2d

	/// Benefits-weighted Summary_PercentDone across the visible plans. Bound to the visual's % Done role.
	measure 'Benefits | % Done' =
			
			DIVIDE (
			    SUMX ( DimProject, DimProject[Summary_PercentDone] * DimProject[Benefits] ),
			    SUMX ( DimProject, DimProject[Benefits] )
			) / 100
		formatString: 0.0%
		displayFolder: Benefits
		lineageTag: 2e8813df-1a2e-4656-b268-79cb6fd08096

	/// Planned Benefits ÷ Budget. >1 means each $ of budget returns more than $1 of expected benefit.
	measure 'Benefits | Cost-Benefit Ratio' =
			
			DIVIDE (
			    [Benefits | Planned Benefits],
			    [Benefits | Budget]
			)
		formatString: 0.00
		displayFolder: Benefits
		lineageTag: 93cfc0ac-9247-472c-82f1-13e716b54478

	/// Prior-period Budget Consumed %. Drives the trajectory arrow tail in the Sunk Cost Decision Board. Adjust the DATEADD shift to match your model's snapshot cadence. Returns BLANK() when no prior period exists (visual then skips the arrow).
	measure 'SunkCost | Budget Consumed % — Prior' = ```
			
			VAR _shift = -1   -- months back; change to -7 for prior week, etc.
			RETURN
			    CALCULATE (
			        [SunkCost | Budget Consumed %],
			        DATEADD ( DimDate[Date], _shift, MONTH )
			    )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: SunkCost
		lineageTag: 3e23dc82-ad21-478b-b184-76b291b63758

	/// Prior-period Project Health / Value Confidence score. Drives the trajectory arrow tail (Y) in the Sunk Cost Decision Board. Adjust DATEADD shift to match the model snapshot cadence. Returns BLANK() when no prior period exists.
	measure 'SunkCost | Value Confidence Score — Prior' = ```
			
			VAR _shift = -1   -- months back; mirror the shift used in 'Budget Consumed % — Prior'
			RETURN
			    CALCULATE (
			        [SunkCost | Value Confidence Score],
			        DATEADD ( DimDate[Date], _shift, MONTH )
			    )
			
			```
		formatString: 0.00
		displayFolder: SunkCost
		lineageTag: f5e54caf-2e3a-42b2-bd60-4cc4d2a3ce7a

	/// Sunk Cost Index — composite ranking. Higher = bigger-$ bleeder. Formula: (1 − health) × budgetConsumed × LN(budget + 1). Optional — the visual computes SCI internally; bind this only when you want to expose the ranking elsewhere.
	measure 'SunkCost | Sunk Cost Index' = ```
			
			VAR _health  = [SunkCost | Value Confidence Score]
			VAR _budget  = [Finance | Budget Cost]
			VAR _consPct = [SunkCost | Budget Consumed %]
			VAR _gap     = MAX ( 0, 1 - _health )
			RETURN
			    _gap * _consPct * LN ( _budget + 1 )
			    
			    
			    
			
			```
		formatString: 0.00
		displayFolder: SunkCost
		lineageTag: d51393d8-a99e-47ea-a49b-5ec7b74c93e8

	/// TotalBenefits of the Baseline scenario, exposed as a constant for incremental calculations.
	measure 'Modeler | Baseline Return' = CALCULATE ( [Modeler | Scenario Return], ALL ( DimScenario ), DimScenario[Name] = "Baseline" )
		formatString: #,0
		displayFolder: Modeler
		lineageTag: 69e29556-50ae-493c-b773-9b9ca34ed198

	/// Benefit delta vs Baseline. Bind to the Expected Return data role. Baseline scenario = 0; positive = adds value; negative = destroys value vs do-nothing.
	measure 'Modeler | Incremental Return' = [Modeler | Scenario Return] - [Modeler | Baseline Return]
		formatString: #,0
		displayFolder: Modeler
		lineageTag: 0289bf62-d40c-46c7-ab04-609501ebc7b0

	/// Efficient Frontier. Source: ModelerScenario[TotalBudget].
	measure 'Modeler | IsFrontierPoint' = VAR _name = SELECTEDVALUE ( DimScenario[Name] ) VAR _risk = [Modeler | Scenario Risk] VAR _ret  = [Modeler | Incremental Return] VAR _portfolios =     ADDCOLUMNS (         FILTER ( ALL ( DimScenario[Name] ), DimScenario[Name] <> "Baseline" ),         "R", [Modeler | Scenario Risk],         "E", [Modeler | Incremental Return]     ) RETURN     IF (         _name = "Baseline", 0,         IF (             _risk > 0 && _ret > 0                 && COUNTROWS ( FILTER ( _portfolios, [R] <= _risk && [E] > _ret ) ) = 0,             1, 0         )     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: 7f02ece9-4687-4a20-afcc-6b1b551d2498

	/// Efficient Frontier. Source: ModelerScenario[TotalBudget].
	measure 'Modeler | IsOptimalPoint' = VAR _name = SELECTEDVALUE ( DimScenario[Name] ) VAR _risk = [Modeler | Scenario Risk] VAR _ret  = [Modeler | Incremental Return] VAR _sharpe = DIVIDE ( _ret, _risk ) VAR _allSharpes =     ADDCOLUMNS (         FILTER ( ALL ( DimScenario[Name] ), DimScenario[Name] <> "Baseline" ),         "S", DIVIDE ( [Modeler | Incremental Return], [Modeler | Scenario Risk] )     ) VAR _maxS = MAXX ( _allSharpes, [S] ) RETURN     IF ( _name <> "Baseline" && _risk > 0 && _ret > 0 && _sharpe = _maxS, 1, 0 )
		formatString: 0
		displayFolder: Modeler
		lineageTag: ba8e5588-d3de-4312-a4cf-68ba88aa316c

	/// Risk-free return = 0 in the incremental framing (Baseline anchors at origin). Used as CAL anchor and Sharpe denominator.
	measure 'Modeler | Rf Return' = 0
		formatString: #,0
		displayFolder: Modeler
		lineageTag: 6abe1a77-196d-4bd2-b8af-9c0f11601f63

	/// Efficient Frontier. Source: ModelerScenario[TotalBenefits].
	measure 'Modeler | Scenario Return' = SUM ( DimScenario[TotalBenefits] )
		formatString: #,0
		displayFolder: Modeler
		lineageTag: 0d609c88-80e8-44dd-9935-20b2239ff968

	/// Efficient Frontier. Source: ModelerScenario[TotalBudget].
	measure 'Modeler | Scenario Risk' =
			VAR _total =
			    SUM ( DimScenario[TotalBudget] )
			VAR _target =
			    SUM ( DimScenario[TargetBudget] )
			RETURN
			    IF ( _target <> 0, ABS ( _total - _target ) / _target * 100, 0 )
		formatString: 0.00
		displayFolder: Modeler
		lineageTag: c70fcfa9-ec83-4e5c-af04-9252715c2065

	/// Incremental Return / Risk. Higher = better risk-adjusted return. Negative = plan destroys value vs Baseline.
	measure 'Modeler | Sharpe Ratio' = DIVIDE ( [Modeler | Incremental Return], [Modeler | Scenario Risk] )
		formatString: 0.0000
		displayFolder: Modeler
		lineageTag: 44b69d8d-c315-43ce-a46c-feec2037335b

	/// Returns 1 if the current project (Plans[Name] context) is part of the current scenario (ModelerScenario[Name] context), else 0. Bind to the Scenario Membership data role on the Efficient Frontier visual (project-mode).
	measure 'Modeler | Membership' =
			VAR _proj = MAX ( DimProject[Name] )
			VAR _scn  =
			    CALCULATE (
			        MAX ( DimScenario[Name] ),
			        ALLEXCEPT ( DimScenario, DimScenario[Name] )    -- strips DimProject→ModelerModel→DimScenario propagation
			    )
			VAR _hits =
			    CALCULATE (
			        COUNTROWS ( FactModelerScenarioPlan ),
			        ALL ( FactModelerScenarioPlan ),
			        FactModelerScenarioPlan[Name] = _proj,
			        FactModelerScenarioPlan[ParentScenarioName] = _scn,
			        FactModelerScenarioPlan[Checked] = TRUE ()
			    )
			RETURN
			    IF ( NOT ISBLANK ( _proj ) && NOT ISBLANK ( _scn ) && _hits > 0, 1, 0 )
		formatString: 0
		displayFolder: Modeler
		lineageTag: e1fe2076-9a34-4616-b579-cb4a72954463

	/// Per-project value / benefit. Bind to the Project Value data role.
	measure 'Modeler | Project Value' = SUM ( DimProject[Benefits] )
		formatString: #,0
		displayFolder: Modeler
		lineageTag: 22fcb128-c80d-4edd-8a69-602bb929ad7e

	measure 'Modeler | Target Budget' = MAX(DimScenario[TargetBudget])
		displayFolder: Modeler
		lineageTag: 6543c491-62f6-4c8d-bb8d-5d07642b1251

	/// Text chip for the Budget Fit constraint. Pair with conditional background colour by Score.
	measure 'Modeler | Budget Fit Chip' = VAR _s = [Modeler | Budget Fit Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● On budget",         _s =  0, "● Stretch",         _s = -1, "● Over budget"     )
		displayFolder: Modeler
		lineageTag: 09e9b9b2-ddad-47e2-bca8-b5bb6e07f140

	/// +1 pass / 0 watch / -1 fail. Pass if TotalBudget <= 1.05x Target; watch <= 1.10x.
	measure 'Modeler | Budget Fit Score' = VAR _total  = SUM ( DimScenario[TotalBudget] ) VAR _target = SUM ( DimScenario[TargetBudget] ) VAR _ratio  = DIVIDE ( _total, _target ) RETURN     SWITCH ( TRUE (),         _target = 0, BLANK (),         _ratio <= 1.05, 1,         _ratio <= 1.10, 0,         -1     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: 39933087-ca0e-40da-83c6-80682c2b0fe5

	/// Text chip for the Resource Fit constraint.
	measure 'Modeler | Resource Fit Chip' = VAR _s = [Modeler | Resource Fit Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● Within capacity",         _s =  0, "● Tight",         _s = -1, "● Over capacity"     )
		displayFolder: Modeler
		lineageTag: 990366d7-08db-4cda-9145-b38590c6a355

	/// +1 pass (effort <= 0.90x ceiling) / 0 watch / -1 fail (>100% ceiling). Edit capacityCeiling constant for your org.
	measure 'Modeler | Resource Fit Score' = VAR _effort   = SUM ( DimScenario[TotalCommittedEffort] ) VAR _ceiling  = 25000 VAR _ratio    = DIVIDE ( _effort, _ceiling ) RETURN     SWITCH ( TRUE (),         _ceiling = 0, BLANK (),         _ratio <= 0.90, 1,         _ratio <= 1, 0,         -1     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: ed84f39f-dde3-40bf-8027-a2e5a89709a2

	/// Text chip for Risk Tolerance.
	measure 'Modeler | Risk Tol Chip' = VAR _s = [Modeler | Risk Tol Score] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● Low risk",         _s =  0, "● Elevated",         _s = -1, "● High risk"     )
		displayFolder: Modeler
		lineageTag: 3a9fe41b-e97a-45c1-b836-3f17df4d3d71

	/// +1 if Scenario Risk <= 20; 0 if <= 35; else -1.
	measure 'Modeler | Risk Tol Score' = VAR _risk = [Modeler | Scenario Risk] RETURN     SWITCH ( TRUE (),         ISBLANK ( _risk ), BLANK (),         _risk <= 20, 1,         _risk <= 35, 0,         -1     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: c03ea9f5-c814-430d-b994-30553b583f2f

	/// Filter-immune Budget Fit chip — use in governance / printed views where the verdict must not shift with cross-filter context.
	measure 'Modeler | Budget Fit Chip (Absolute)' = VAR _s = [Modeler | Budget Fit Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● On budget",         _s =  0, "● Stretch",         _s = -1, "● Over budget"     )
		displayFolder: Modeler
		lineageTag: 476c8aef-6810-426a-8f86-9a7a76277325

	/// Filter-immune Budget Fit Score. Always evaluates against the row's own scenario, ignoring cross-filter on ModelerScenario[Name] from other visuals.
	measure 'Modeler | Budget Fit Score (Absolute)' = VAR _total  = CALCULATE ( SUM ( DimScenario[TotalBudget] ), ALLEXCEPT ( DimScenario, DimScenario[Name] ) ) VAR _target = CALCULATE ( SUM ( DimScenario[TargetBudget] ), ALLEXCEPT ( DimScenario, DimScenario[Name] ) ) VAR _ratio  = DIVIDE ( _total, _target ) RETURN     SWITCH ( TRUE (),         _target = 0, BLANK (),         _ratio <= 1.05, 1,         _ratio <= 1.10, 0,         -1     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: 3a0cdbe2-6d68-44a9-b64b-985d5dc0e9d6

	/// Filter-immune Resource Fit chip.
	measure 'Modeler | Resource Fit Chip (Absolute)' = VAR _s = [Modeler | Resource Fit Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● Within capacity",         _s =  0, "● Tight",         _s = -1, "● Over capacity"     )
		displayFolder: Modeler
		lineageTag: 5995aa76-8afd-47d5-acc4-657f21578bf3

	/// Filter-immune Resource Fit Score.
	measure 'Modeler | Resource Fit Score (Absolute)' = VAR _effort   = CALCULATE ( SUM ( DimScenario[TotalCommittedEffort] ), ALLEXCEPT ( DimScenario, DimScenario[Name] ) ) VAR _ceiling  = 25000 VAR _ratio    = DIVIDE ( _effort, _ceiling ) RETURN     SWITCH ( TRUE (),         _ceiling = 0, BLANK (),         _ratio <= 0.90, 1,         _ratio <= 1, 0,         -1     )
		formatString: 0
		displayFolder: Modeler
		lineageTag: 9aa6fde9-5e77-4976-a1c8-42660d1d6bf6

	/// Filter-immune Risk Tolerance chip.
	measure 'Modeler | Risk Tol Chip (Absolute)' = VAR _s = [Modeler | Risk Tol Score (Absolute)] RETURN     SWITCH ( TRUE (),         ISBLANK ( _s ), "—",         _s =  1, "● Low risk",         _s =  0, "● Elevated",         _s = -1, "● High risk"     )
		displayFolder: Modeler
		lineageTag: b7cded97-46b4-41dd-a8ef-22c53712ae1a

	/// Filter-immune Risk Tolerance Score. Pins [Modeler | Scenario Risk] to the row's scenario.
	measure 'Modeler | Risk Tol Score (Absolute)' = VAR _risk = CALCULATE ( [Modeler | Scenario Risk], ALLEXCEPT ( DimScenario, DimScenario[Name] ) ) RETURN     SWITCH ( TRUE (),         ISBLANK ( _risk ), BLANK (),         _risk <= 20, 1,         _risk <= 35, 0,         -1     )
		formatString: 0
