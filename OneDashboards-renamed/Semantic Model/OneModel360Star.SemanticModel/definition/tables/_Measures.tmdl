	/// Source: ProcessSteps[Name].
	measure 'Lifecycle | Start' =
			VAR _name = SELECTEDVALUE(DimProcessStep[Name])
			RETURN CALCULATE(
			    MIN(FactPlanProcessStep[Start]),
			    ALL(DimProcessStep),
			    FactPlanProcessStep[StepName] = _name
			)
		formatString: dd/mm/yyyy hh:nn
		displayFolder: Lifecycle
		lineageTag: c74114fa-8976-4254-9cfe-43bd6027bbc9

		annotation 'BFusion.Visual' = ProjectLifecycle

		annotation 'BFusion.SortOrder' = 3

	/// Source: ProcessSteps[Name].
	measure 'Lifecycle | Step State' =
			VAR _name = SELECTEDVALUE(DimProcessStep[Name])
			// Actual state for the SELECTED plan
			VAR _val = CALCULATE(
			    MAX(FactPlanProcessStep[StepState]),
			    ALL(DimProcessStep),
			    FactPlanProcessStep[StepName] = _name
			)
			// Does this step exist in ANY plan of the same PlanType?
			// ALLEXCEPT keeps PlanTypeName filter but removes the specific Plan selection
			VAR _existsInPlanType = CALCULATE(
			    COUNTROWS(FactPlanProcessStep),
			    ALL(DimProcessStep),
			    ALLEXCEPT(DimProject, DimProject[PlanType]),
			    FactPlanProcessStep[StepName] = _name
			) > 0
			RETURN
			    IF(
			        ISBLANK(_name), BLANK(),
			        IF(
			            NOT _existsInPlanType, BLANK(),
			            IF(ISBLANK(_val), "Upcoming", _val)
			        )
			    )
		displayFolder: Lifecycle
		lineageTag: 3e7a64a9-01bf-408b-ae48-4c89c8cfd1d6

		annotation 'BFusion.Visual' = ProjectLifecycle

		annotation 'BFusion.SortOrder' = 1

	/// Source: Tasks[Probability].
	measure 'Risk & Issue | Avg Probability' = AVERAGE( DimTask[Probability] )
