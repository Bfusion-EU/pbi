	/// Source: Plans[ScheduleHealth_Value].
	measure 'Portfolio 360 | At-Risk Count' = ```
			
			CALCULATE (
			    COUNTROWS ( DimProject ),
			    LOWER ( DimProject[ScheduleHealth_Value] ) IN { "at risk", "yellow", "caution", "cautious" }
			)
			
			```
