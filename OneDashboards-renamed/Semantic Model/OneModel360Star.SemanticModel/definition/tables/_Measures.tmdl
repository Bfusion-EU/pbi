	/// Resource Alignment. Source: Plans[StrategicAlignment_Value].
	measure 'Modeler | Strategic Alignment Score (Resource Alignment)' =
			VAR _v = SELECTEDVALUE( DimProject[StrategicAlignment_Value] )
			RETURN
			    SWITCH(
			        TRUE(),
			        _v IN { "Extreme", "Very High", "Critical", "Strategic" }, 100,
			        _v IN { "Strong", "High" },                                    80,
			        _v IN { "Moderate", "Medium" },                                60,
			        _v IN { "Low" },                                                40,
			        _v IN { "Very Low", "None" },                                  20,
			        _v = "Not Rated", BLANK(),
			        BLANK()
			    )
		formatString: 0
		displayFolder: Modeler
		lineageTag: e1b26f19-f410-4839-99da-b4ef34a5b2b1

	/// Resource Alignment. Source: Plans[StrategicAlignment_Value].
	measure 'Modeler | Strategic Alignment Score (Composite)' =
			VAR _alignment = SELECTEDVALUE( DimProject[StrategicAlignment_Value] )
			VAR _fit       = SELECTEDVALUE( DimProject[StrategicFit_Value] )
			VAR _value     = SELECTEDVALUE( DimProject[BusinessValue_Value] )
			VAR _mapHigh = SWITCH( TRUE(),
			    _alignment IN { "Extreme", "Very High", "Critical", "Strategic" }, 100,
			    _alignment IN { "Strong", "High" }, 80,
			    _alignment IN { "Moderate", "Medium" }, 60,
			    _alignment IN { "Low" }, 40,
			    _alignment IN { "Very Low", "None" }, 20,
			    50 )
			VAR _mapFit = SWITCH( TRUE(),
			    _fit IN { "Extreme", "Very High", "Critical", "Strategic" }, 100,
			    _fit IN { "Strong", "High" }, 80,
			    _fit IN { "Moderate", "Medium" }, 60,
			    _fit IN { "Low" }, 40,
			    _fit IN { "Very Low", "None" }, 20,
			    50 )
			VAR _mapValue = SWITCH( TRUE(),
			    _value IN { "Extreme", "Very High", "Critical", "Strategic" }, 100,
			    _value IN { "Strong", "High" }, 80,
			    _value IN { "Moderate", "Medium" }, 60,
			    _value IN { "Low" }, 40,
			    _value IN { "Very Low", "None" }, 20,
			    50 )
			RETURN ROUND( 0.5 * _mapHigh + 0.3 * _mapFit + 0.2 * _mapValue, 0 )
		formatString: 0
		displayFolder: Modeler
		lineageTag: 6e2a885e-0428-490d-ad04-66ecf3312794

	/// Resource Alignment. Source: Plans[PrioritizationScore].
	measure 'Modeler | Strategic Alignment Score (Prioritization)' =
			VAR _v   = SUM( DimProject[PrioritizationScore] )
			VAR _max = CALCULATE( MAX( DimProject[PrioritizationScore] ), ALL( DimProject ) )
			RETURN IF( _max > 0, DIVIDE( _v, _max ) * 100, BLANK() )
		formatString: 0
		displayFolder: Modeler
		lineageTag: fbfc6784-1b73-40fe-b810-165491e33acb

	/// Source: Plans[Budget].
	measure 'EVM | BAC (Budget at Completion)' = SUM ( DimProject[Budget] )
		formatString: #,##0
		displayFolder: EVM
		lineageTag: 927f0ed2-97b3-45b9-8819-165274030b0b

	/// Source: Plans[EAC].
	measure 'EVM | EAC (Estimate at Completion)' = SUM ( DimProject[EAC] )
		formatString: #,##0
		displayFolder: EVM
		lineageTag: 370bd8a9-5ed6-418e-b734-18f1d5a6303f

	/// Subject area: EVM.
	measure 'EVM | CPI (Cost Performance Index)' = ```
			
			// CPI proxy used when the model carries no time-phased Earned Value.
			// CPI < 1.0 = forecast to overrun budget; > 1.0 = forecast under budget.
			DIVIDE (
			    [EVM | BAC (Budget at Completion)],
			    [EVM | EAC (Estimate at Completion)]
			)
			
			```
		formatString: 0.00
		displayFolder: EVM
		lineageTag: da727e3d-d4cc-438b-be21-5a5bfef4576d

	/// Source: Plans[Summary_BaselineStartDate].
	measure 'EVM | Baseline Duration (days)' = ```
			
			SUMX (
			    DimProject,
			    DATEDIFF (
			        DimProject[Summary_BaselineStartDate],
			        DimProject[Summary_BaselineEndDate],
			        DAY
			    )
			)
			
			```
		formatString: #,##0
		displayFolder: EVM
		lineageTag: bb9667c3-8801-40a9-83c3-dfd06594f8a6

	/// Source: Plans[Summary_StartDate].
	measure 'EVM | Forecast Duration (days)' = ```
			
			SUMX (
			    DimProject,
			    DATEDIFF (
			        COALESCE ( DimProject[Summary_StartDate], DimProject[EstimatedStart] ),
			        COALESCE ( DimProject[Summary_EndDate],   DimProject[EstimatedEnd]   ),
			        DAY
			    )
			)
			
			```
		formatString: #,##0
		displayFolder: EVM
		lineageTag: 4e665253-e2f7-45bf-aedf-5714d02851f5

	/// Subject area: EVM.
	measure 'EVM | SPI (Schedule Performance Index)' = ```
			
			// Primary: Baseline Duration / Forecast Duration  (time-phased proxy).
			// Fallback: ScheduleHealth_Value mapping            (categorical proxy).
			// Both blank: BLANK — the visual will then assume SPI = 1.0 and warn the user.
			VAR _dateBased = DIVIDE (
			    [EVM | Baseline Duration (days)],
			    [EVM | Forecast Duration (days)]
			)
			VAR _healthBased = [EVM | SPI from Health]
			RETURN
			    COALESCE ( _dateBased, _healthBased )
			
			```
		formatString: 0.00
		displayFolder: EVM
		lineageTag: afbb20a1-846f-4b6a-aefe-eb72dbe96eb1

	/// Subject area: EVM.
	measure 'EVM | Forecast Overrun' = [EVM | EAC] - [EVM | BAC]
		formatString: #,0.00
		displayFolder: EVM
		lineageTag: 71e6831d-5f90-460c-9625-1f1e19aec287

	/// Source: Plans[ScheduleHealth_Value].
	measure 'EVM | SPI from Health' = ```
			
			VAR _h = LOWER ( SELECTEDVALUE ( DimProject[ScheduleHealth_Value] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        _h IN { "on track", "green", "ontrack" },                   1.00,
			        _h IN { "at risk", "yellow", "caution", "cautious" },     0.85,
			        _h IN { "late", "behind", "red", "behind schedule" },     0.70,
			        BLANK ()
			    )
			
			```
		formatString: 0.00
		displayFolder: EVM
		lineageTag: 900afaec-d053-4cfa-b7d3-53abdc81cd4d

	/// Source: Plans[State_Value].
	measure 'Portfolio 360 | Active Projects' = ```
			
			CALCULATE (
