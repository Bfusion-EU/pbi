	/// Subject area: Task.
	measure 'Task | #Activities' = ```
			
			IF(
			    NOT ISEMPTY('DimTask'), 
			    COALESCE(COUNTROWS('Activities'), 0)
			)
			```
		displayFolder: Task
		lineageTag: 4a491d33-889b-4b2c-98c5-2b17e7737d01

	/// Source: Calendar[Date].
	measure 'Portfolio 360 | Utilization MoM (pts)' = ```
			
			VAR _cur = [Capacity | Resource Utilization%]
			VAR _prv = CALCULATE ( [Capacity | Resource Utilization%], DATEADD ( DimDate[Date], -1, MONTH ) )
			RETURN
			    ( _cur - _prv ) * 100
			
			```
		formatString: 0.0
		displayFolder: Portfolio 360
		lineageTag: 35096322-d8e0-4062-bdeb-bf4144d9b43f

	/// Source: Calendar[Date].
	measure 'Portfolio 360 | Risks MoM' = ```
			
			VAR _cur = [Portfolio | Portfolio - Total ActiveRisks]
			VAR _prv = CALCULATE ( [Portfolio | Portfolio - Total ActiveRisks], DATEADD ( DimDate[Date], -1, MONTH ) )
			RETURN
			    _cur - _prv
			
			```
		formatString: +#,##0;-#,##0;0
		displayFolder: Portfolio 360
