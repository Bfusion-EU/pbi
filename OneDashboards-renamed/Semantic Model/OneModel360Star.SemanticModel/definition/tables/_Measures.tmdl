	/// Source: Tasks[Urgency].
	measure 'Risk & Issue | Portfolio Action State' =
			
			IF(
			    CONTAINSROW(VALUES(DimTask[Urgency]), "(1) Very Urgent"),
			    "⚠️ IMMEDIATE ESCALATION REQUIRED",
			    "✅ STATUS STABLE"
			)
		displayFolder: Risk & Issue
