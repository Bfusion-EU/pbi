	/// Source: Tasks[Impact].
	measure 'Risk & Issue | Risk Rating' = ```
			
			VAR _impact =
			    AVERAGEX(
			        DimTask,
			        SWITCH(
			            TRUE(),
			            DimTask[Impact] = "(1) Critical", 5,
			            DimTask[Impact] = "(2) High",     4,
			            DimTask[Impact] = "(3) Medium",   3,
			            DimTask[Impact] = "(4) Low",      2,
			            3
			        )
			    )
			VAR _likelihood =
			    SWITCH(
			        TRUE(),
			        AVERAGE( DimTask[Probability] ) >= 75, 5,
			        AVERAGE( DimTask[Probability] ) >= 50, 4,
			        AVERAGE( DimTask[Probability] ) >= 25, 3,
			        AVERAGE( DimTask[Probability] ) >= 10, 2,
			        1
			    )
			RETURN
			    _impact * _likelihood
			
			```
		displayFolder: Risk & Issue
		lineageTag: 173aa1be-f077-4358-b131-27f69c45d2e7

	/// Subject area: Risk & Issue.
	measure 'Risk & Issue | Target' = 5
