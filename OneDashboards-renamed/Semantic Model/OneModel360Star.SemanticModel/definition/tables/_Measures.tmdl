	/// Source: Resources[UserId].
	measure 'Resource KPI | Top Overalloc Name' =
			VAR _ResAllocTable =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(DimResource[UserId]),
			            CALCULATE(COUNTROWS(FactCapacity)) > 0
			        ),
			        "@MaxAlloc",
			            CALCULATE(
			                MAXX(
			                    SUMMARIZE(DimDate, DimDate[Period]),
			                    CALCULATE([Capacity | Resource Utilization%])
			                )
			            )
			    )
			VAR _TopRow =
			    TOPN(1, FILTER(_ResAllocTable, [@MaxAlloc] > 1), [@MaxAlloc], DESC)
			RETURN
			    MAXX(_TopRow, CALCULATE(SELECTEDVALUE(DimResource[Name])))
