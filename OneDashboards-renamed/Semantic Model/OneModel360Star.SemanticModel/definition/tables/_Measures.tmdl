	/// Source: Tasks[Probability].
	measure 'Risk & Issue | Likelihood Score' = ```
			
			VAR _avg = AVERAGE( DimTask[Probability] )
			RETURN
			    SWITCH(
			        TRUE(),
			        _avg >= 75, 5,
			        _avg >= 50, 4,
			        _avg >= 25, 3,
			        _avg >= 10, 2,
			        1
			    )
			
			```
		displayFolder: Risk & Issue
