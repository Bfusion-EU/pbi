	/// Source: ProcessSteps[Name].
	measure 'Lifecycle | End' =
			VAR _name = SELECTEDVALUE(DimProcessStep[Name])
			RETURN CALCULATE(
			    MAX(FactPlanProcessStep[End]),
			    ALL(DimProcessStep),
			    FactPlanProcessStep[StepName] = _name
			)
		formatString: dd/mm/yyyy hh:nn
		displayFolder: Lifecycle
