		changedProperty = IsHidden

	/// Source: Tasks[WorkType].
	measure 'Risk & Issue | Strategic Narrative Panel Html' = ```
			
			-- Base filtered rows and exposure for pure risks
			VAR TotalRisks = CALCULATE(COUNTROWS(DimTask), DimTask[WorkType] = "Risks")
			VAR TotalExposure = CALCULATE(SUM(DimTask[Exposure]), DimTask[WorkType] = "Risks")
			
			-- Global count of unique plans to evaluate portfolio density
			VAR TotalUniquePlans = CALCULATE(DISTINCTCOUNT(DimTask[PlanId]), DimTask[WorkType] = "Risks")
			
			-- 1. Critical Risk Concentration (High/Critical Zones)
			VAR HighZoneExposure = 
			    CALCULATE(
			        SUM(DimTask[Exposure]),
			        DimTask[WorkType] = "Risks",
			        DimTask[Probability Category] IN {"(1) Critical", "(2) High"}
			    )
			VAR ConcentrationShare = DIVIDE(HighZoneExposure, TotalExposure, 0)
			VAR ConcentrationStr = FORMAT(ConcentrationShare, "0%")
			
			-- 2. Threat Profile Density Breakdown
			VAR UrgentCount = 
			    CALCULATE(
			        COUNTROWS(DimTask), 
			        DimTask[WorkType] = "Risks",
			        DimTask[Urgency] IN {"(1) Very Urgent", "(2) Urgent"}
			    )
			VAR UrgentExposure = 
			    CALCULATE(
			        SUM(DimTask[Exposure]), 
			        DimTask[WorkType] = "Risks",
			        DimTask[Urgency] IN {"(1) Very Urgent", "(2) Urgent"}
			    )
			VAR NormalCount = TotalRisks - UrgentCount
			
			-- 3. Adaptive Metric: Triage Gap (Risks missing an Urgency tier assignment)
			VAR UnclassifiedCount = 
			    CALCULATE(
			        COUNTROWS(DimTask),
			        DimTask[WorkType] = "Risks",
			        ISBLANK(DimTask[Urgency]) || DimTask[Urgency] = ""
			    )
			VAR TriageGapRatio = DIVIDE(UnclassifiedCount, TotalRisks, 0)
			VAR TriageGapStr = FORMAT(TriageGapRatio, "0%")
			
			-- 4. Deep Project-Level (Plan) Insights & Ranking Engine
			VAR PlanSummaryTable = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            DimTask, 
			            DimProject[Name], 
			            "PlanExposure", SUM(DimTask[Exposure]),
			            "PlanRiskCount", COUNTROWS(DimTask)
			        ),
			        DimTask[WorkType] = "Risks"
			    )
			
			-- Extract Top 3 projects by exposure mathematically
			VAR Top1Table = TOPN(1, PlanSummaryTable, [PlanExposure], DESC)
			VAR Top1Name = SELECTCOLUMNS(Top1Table, "Name", DimProject[Name])
			VAR Top1Val = SELECTCOLUMNS(Top1Table, "Val", [PlanExposure])
			
			VAR Top2Table = TOPN(1, EXCEPT(PlanSummaryTable, Top1Table), [PlanExposure], DESC)
			VAR Top2Name = SELECTCOLUMNS(Top2Table, "Name", DimProject[Name])
			VAR Top2Val = SELECTCOLUMNS(Top2Table, "Val", [PlanExposure])
			
			VAR Top3Table = TOPN(1, EXCEPT(PlanSummaryTable, UNION(Top1Table, Top2Table)), [PlanExposure], DESC)
			VAR Top3Name = SELECTCOLUMNS(Top3Table, "Name", DimProject[Name])
			VAR Top3Val = SELECTCOLUMNS(Top3Table, "Val", [PlanExposure])
			
			-- Helper function for scaling ranking strings
			VAR Top1Str = IF(ISBLANK(Top1Name), "", "<li><strong>" & Top1Name & "</strong>: " & IF(Top1Val >= 1000000, "€" & FORMAT(Top1Val/1000000, "#,0.0") & "M", "€" & FORMAT(Top1Val/1000, "#,0.0") & "K") & "</li>")
			VAR Top2Str = IF(ISBLANK(Top2Name), "", "<li><strong>" & Top2Name & "</strong>: " & IF(Top2Val >= 1000000, "€" & FORMAT(Top2Val/1000000, "#,0.0") & "M", "€" & FORMAT(Top2Val/1000, "#,0.0") & "K") & "</li>")
			VAR Top3Str = IF(ISBLANK(Top3Name), "", "<li><strong>" & Top3Name & "</strong>: " & IF(Top3Val >= 1000000, "€" & FORMAT(Top3Val/1000000, "#,0.0") & "M", "€" & FORMAT(Top3Val/1000, "#,0.0") & "K") & "</li>")
			
			-- Calculate number of projects with disproportionate risk profiles (> 20% of total portfolio exposure)
			VAR VolatileProjectsCount = COUNTROWS(FILTER(PlanSummaryTable, [PlanExposure] > (TotalExposure * 0.2)))
			
			-- 5. Operational Action Call
			VAR HasVeryUrgent = 
			    CALCULATE(
			        COUNTROWS(DimTask),
			        DimTask[WorkType] = "Risks",
			        DimTask[Urgency] = "(1) Very Urgent"
			    ) > 0
			VAR ActionCallText = IF(HasVeryUrgent, "⚠️ IMMEDIATE ESCALATION REQUIRED", "✅ REVIEWS STABLE / NORMAL")
			VAR ActionCallColor = IF(HasVeryUrgent, "#C0392B", "#27AE60")
			VAR ActionBgColor = IF(HasVeryUrgent, "#FDEDEC", "#EAFAF1")
			
			-- Scale sub-exposure density values mathematically
			VAR UrgentExposureStr = 
			    SWITCH(
			        TRUE(),
			        UrgentExposure >= 1000000, "€" & FORMAT(UrgentExposure / 1000000, "#,0.0") & "M",
			        UrgentExposure >= 1000, "€" & FORMAT(UrgentExposure / 1000, "#,0.0") & "K",
			        "€" & FORMAT(UrgentExposure, "#,0")
			    )
			
			RETURN
			IF(
			    TotalRisks = 0,
			    "<div style='font-family:Segoe UI, Arial; padding:20px; color:#7F8C8D; font-size:13px; background-color:#F8F9FA; border-radius:6px; border:1px dashed #BDC3C7;'>✅ <strong>Portfolio Clear:</strong> No active project risks currently map to the portfolio filters.</div>",
			    
			    -- HTML Panel Container
			    "<div style='font-family:Segoe UI, Helvetica Neue, Arial; color:#2C3E50; line-height:1.35;'>" &
			        
			        -- Header Block
			        "<div style='font-size:12px; font-weight:bold; color:#34495E; text-transform:uppercase; margin-bottom:14px; letter-spacing:0.8px; border-bottom:2px solid #ECF0F1; padding-bottom:5px;'>Strategic Narratives</div>" &
			        
			        -- Row Column Grid Loop: Concentration & Triage Gap side-by-side
			        "<div style='display:flex; margin-bottom:16px;'>" &
			            "<div style='flex:1; margin-right:12px;'>" &
			                "<div style='font-size:9px; font-weight:700; color:#95A5A6; text-transform:uppercase; margin-bottom:2px; letter-spacing:0.3px;'>Zone Concentration</div>" &
			                "<div style='font-size:24px; font-weight:bold; color:#1A202C; line-height:1;'>" & ConcentrationStr & "</div>" &
			                "<div style='font-size:10px; color:#7F8C8D; margin-top:3px;'>Financial weight in High/Critical sectors.</div>" &
			            "</div>" &
			            "<div style='flex:1; border-left:1px solid #ECF0F1; padding-left:12px;'>" &
			                "<div style='font-size:9px; font-weight:700; color:#95A5A6; text-transform:uppercase; margin-bottom:2px; letter-spacing:0.3px;'>Triage Gap</div>" &
			                "<div style='font-size:24px; font-weight:bold; color:#D35400; line-height:1;'>" & TriageGapStr & "</div>" &
			                "<div style='font-size:10px; color:#7F8C8D; margin-top:3px;'>Active risks missing urgency classifications.</div>" &
			            "</div>" &
			        "</div>" &
			        
			        -- Section 2: Threat Profile Density Metric
			        "<div style='margin-bottom:16px;'>" &
			            "<div style='font-size:9px; font-weight:700; color:#95A5A6; text-transform:uppercase; margin-bottom:5px; letter-spacing:0.3px;'>Threat Profile Density</div>" &
			            "<div style='display:flex; font-size:11px; color:#2C3E50;'>" &
			                "<div style='flex:1; border-left:3px solid #E74C3C; padding-left:8px; margin-right:10px;'>" &
			                    "<span style='font-weight:bold; color:#C0392B;'>" & UrgentCount & " Active Threats</span><br/>" &
			                    "<span style='color:#7F8C8D; font-size:10px;'>" & UrgentExposureStr & " Scoped</span>" &
			                "</div>" &
			                "<div style='flex:1; border-left:3px solid #BDC3C7; padding-left:8px;'>" &
			                    "<span style='font-weight:bold; color:#34495E;'>" & NormalCount & " Monitored</span><br/>" &
			                    "<span style='color:#7F8C8D; font-size:10px;'>Across " & TotalUniquePlans & " Active Plans</span>" &
			                "</div>" &
			            "</div>" &
			        "</div>" &
			        
			        -- NEW Section 3: Project-Level Threat Vectors & Ranking Card
			        "<div style='margin-bottom:16px; background-color:#F8F9FA; padding:10px; border-radius:4px; border:1px solid #EAECEE;'>" &
			            "<div style='font-size:9px; font-weight:700; color:#7F8C8D; text-transform:uppercase; margin-bottom:4px; letter-spacing:0.3px;'>Top Impact Project Tracks</div>" &
			            "<div style='font-size:11px; color:#2C3E50; margin-bottom:6px;'><strong>" & VolatileProjectsCount & "</strong> plan(s) hold over 20% of global portfolio risk volume individually.</div>" &
			            "<ol style='margin:0; padding-left:14px; font-size:11px; color:#2C3E50; line-height:1.4;'>" &
			                Top1Str & Top2Str & Top3Str &
			            "</ol>" &
			        "</div>" &
			        
			        -- Section 4: Action State Card Box
			        "<div style='background-color:" & ActionBgColor & "; border: 1px solid " & ActionCallColor & "; padding:8px 10px; border-radius:4px;'>" &
			            "<div style='font-size:8px; font-weight:700; color:" & ActionCallColor & "; text-transform:uppercase; margin-bottom:2px; letter-spacing:0.5px;'>Portfolio Operational Call</div>" &
			            "<div style='font-size:11px; font-weight:bold; color:" & ActionCallColor & ";'>" & ActionCallText & "</div>" &
			        "</div>" &
			        
			    "</div>"
			)
			```
		displayFolder: Risk & Issue
		lineageTag: b886e06b-a99a-483d-af12-163bc8893ef4

		changedProperty = IsHidden

	/// Source: Tasks[Plan].
	measure 'Project | Plan Health Dashboard' = ```
			
			// =======================================================================
			// BFUSION Plan Health Dashboard — for HTML Content Visual
			// -----------------------------------------------------------------------
			// Columns referenced (adjust to match your model):
			//   DimTask[Plan], DimTask[Title], DimTask[StartDate], DimTask[EndDate],
			//   DimTask[PercentDone] (0-100), DimTask[Milestone] (TRUE/FALSE),
			//   DimTask[BaselineStart], DimTask[BaselineEnd], DimTask[Slack (days)],
			//   DimTask[Resource]
			// =======================================================================
			
			// ─── Core counts ─────────────────────────────────────────────────────
			VAR _total        = COUNTROWS(DimTask)
			VAR _complete     = CALCULATE(COUNTROWS(DimTask), DimTask[PercentDone] >= 100)
			VAR _behind       = COUNTROWS(
			                        FILTER(DimTask,
			                            VAR _pct = DimTask[PercentDone] / 100
			                            VAR _exp = MIN(1, MAX(0, DIVIDE(
			                                DATEDIFF(DimTask[StartDate], TODAY(), DAY),
			                                MAX(1, DATEDIFF(DimTask[StartDate], DimTask[EndDate], DAY)))))
			                            RETURN _pct < 1 && (_pct - _exp) < -0.15))
			VAR _atRisk       = COUNTROWS(
			                        FILTER(DimTask,
			                            VAR _pct = DimTask[PercentDone] / 100
			                            VAR _exp = MIN(1, MAX(0, DIVIDE(
			                                DATEDIFF(DimTask[StartDate], TODAY(), DAY),
			                                MAX(1, DATEDIFF(DimTask[StartDate], DimTask[EndDate], DAY)))))
			                            VAR _d   = _pct - _exp
			                            RETURN _pct < 1 && _d >= -0.15 && _d < 0))
			VAR _onTrack      = _total - _complete - _behind - _atRisk
			
			// ─── Risk metrics ────────────────────────────────────────────────────
			VAR _overdue      = COUNTROWS(FILTER(DimTask, DimTask[PercentDone] < 100 && DimTask[EndDate] < TODAY()))
			VAR _critical     = COUNTROWS(FILTER(DimTask, DimTask[Slack (days)] = 0))
			VAR _avgPct       = DIVIDE(SUM(DimTask[PercentDone]), _total, 0)
			
			// ─── SPI (Schedule Performance Index) ────────────────────────────────
			VAR _totalPV      = SUMX(DimTask,
			                        MIN(1, MAX(0, DIVIDE(
			                            DATEDIFF(DimTask[StartDate], TODAY(), DAY),
			                            MAX(1, DATEDIFF(DimTask[StartDate], DimTask[EndDate], DAY))))))
			VAR _totalEV      = SUMX(DimTask, DimTask[PercentDone] / 100)
			VAR _spi          = DIVIDE(_totalEV, _totalPV, 1)
			
			// ─── Milestones ──────────────────────────────────────────────────────
			VAR _msTotal      = COUNTROWS(FILTER(DimTask, DimTask[Milestone] = TRUE))
			VAR _msDone       = COUNTROWS(FILTER(DimTask, DimTask[Milestone] = TRUE && DimTask[PercentDone] >= 100))
			VAR _msOverdue    = COUNTROWS(FILTER(DimTask, DimTask[Milestone] = TRUE && DimTask[PercentDone] < 100 && DimTask[EndDate] < TODAY()))
			VAR _msUpcoming   = _msTotal - _msDone - _msOverdue
			
			VAR _nextMs       = TOPN(1,
			                        FILTER(DimTask, DimTask[Milestone] = TRUE && DimTask[PercentDone] < 100 && DimTask[StartDate] >= TODAY()),
			                        DimTask[StartDate], ASC)
			VAR _nextMsName   = MAXX(_nextMs, DimTask[Name])
			VAR _nextMsDate   = MAXX(_nextMs, DimTask[StartDate])
			VAR _daysToNextMs = IF(NOT(ISBLANK(_nextMsDate)), DATEDIFF(TODAY(), _nextMsDate, DAY), BLANK())
			
			// ─── Baseline variance ───────────────────────────────────────────────
			VAR _blTotal      = COUNTROWS(FILTER(DimTask, NOT(ISBLANK(DimTask[BaselineEndDate]))))
			VAR _blSlipped    = COUNTROWS(FILTER(DimTask, NOT(ISBLANK(DimTask[BaselineEndDate])) && DimTask[EndDate] > DimTask[BaselineEndDate]))
			VAR _blAvgSlip    = IF(_blTotal > 0,
			                        AVERAGEX(
			                            FILTER(DimTask, NOT(ISBLANK(DimTask[BaselineEndDate]))),
			                            DATEDIFF(DimTask[BaselineEndDate], DimTask[EndDate], DAY)), 0)
			
			// ─── DimResource ───────────────────────────────────────────────────────
			VAR _resCount     = DISTINCTCOUNT(DimTask[Name])
			VAR _avgTasksPerRes = DIVIDE(_total, MAX(1, _resCount), 0)
			
			// ─── Plan info ───────────────────────────────────────────────────────
			VAR _planName     = SELECTEDVALUE(DimProject[Name], "All Plans")
			VAR _planStart    = MIN(DimTask[StartDate])
			VAR _planEnd      = MAX(DimTask[EndDate])
			VAR _planDuration = DATEDIFF(_planStart, _planEnd, DAY)
			VAR _planDaysLeft = MAX(0, DATEDIFF(TODAY(), _planEnd, DAY))
			
			// ─── Health score (0-100) ────────────────────────────────────────────
			VAR _hCompletion  = DIVIDE(_complete, MAX(1, _total)) * 30
			VAR _hOnTime      = DIVIDE(_complete + _onTrack, MAX(1, _total)) * 30
			VAR _hOverdue     = (1 - DIVIDE(_overdue, MAX(1, _total))) * 20
			VAR _hMilestone   = IF(_msTotal > 0, DIVIDE(_msDone, _msTotal) * 20, 20)
			VAR _healthScore  = ROUND(_hCompletion + _hOnTime + _hOverdue + _hMilestone, 0)
			VAR _healthLabel  = SWITCH(TRUE(),
			                        _healthScore >= 75, "Healthy",
			                        _healthScore >= 55, "Fair",
			                        _healthScore >= 35, "At Risk",
			                        "Critical")
			VAR _healthColor  = SWITCH(TRUE(),
			                        _healthScore >= 75, "#4CAF50",
			                        _healthScore >= 55, "#2196F3",
			                        _healthScore >= 35, "#FF9800",
			                        "#F44336")
			VAR _healthIcon   = SWITCH(TRUE(),
			                        _healthScore >= 75, UNICHAR(9989),
			                        _healthScore >= 55, UNICHAR(8505),
			                        _healthScore >= 35, UNICHAR(9888),
			                        UNICHAR(128308))
			
			// ─── Percentages for status bar ──────────────────────────────────────
			VAR _pctComplete  = ROUND(DIVIDE(_complete, MAX(1, _total)) * 100, 0)
			VAR _pctOnTrack   = ROUND(DIVIDE(_onTrack, MAX(1, _total)) * 100, 0)
			VAR _pctAtRisk    = ROUND(DIVIDE(_atRisk, MAX(1, _total)) * 100, 0)
			VAR _pctBehind    = 100 - _pctComplete - _pctOnTrack - _pctAtRisk
			
			// ─── SPI label / color ───────────────────────────────────────────────
			VAR _spiColor     = IF(_spi >= 0.95, "#4CAF50", IF(_spi >= 0.85, "#FF9800", "#F44336"))
			VAR _spiLabel     = IF(_spi >= 0.95, "On track", IF(_spi >= 0.85, "Slight delay", "Behind schedule"))
			
			// ─── Top Risks (up to 5 overdue tasks) ──────────────────────────────
			VAR _topRisks     = CONCATENATEX(
			                        TOPN(5,
			                            FILTER(DimTask, DimTask[PercentDone] < 100 && DimTask[EndDate] < TODAY() && DimTask[Milestone] = FALSE),
			                            DATEDIFF(DimTask[EndDate], TODAY(), DAY), DESC),
			                        "<div style='padding:3px 0; font-size:12px;'>" &
			                        "<span style='color:#F44336; font-size:8px;'>" & UNICHAR(9679) & "</span>&nbsp; " &
			                        DimTask[Name] &
			                        " <span style='color:#999; font-size:10px;'>" & UNICHAR(8212) & " " &
			                        FORMAT(DATEDIFF(DimTask[EndDate], TODAY(), DAY), "#,0") &
			                        "d overdue (" & FORMAT(DimTask[PercentDone], "0") & "% done)</span></div>",
			                        "")
			
			// ─── Upcoming milestones (next 3) ────────────────────────────────────
			VAR _upcomingMs   = CONCATENATEX(
			                        TOPN(3,
			                            FILTER(DimTask, DimTask[Milestone] = TRUE && DimTask[PercentDone] < 100 && DimTask[StartDate] >= TODAY()),
			                            DimTask[StartDate], ASC),
			                        "<div style='padding:3px 0; font-size:12px;'>" &
			                        "<span style='color:#FF9800;'>" & UNICHAR(9670) & "</span>&nbsp; " &
			                        DimTask[Name] &
			                        " <span style='color:#999; font-size:10px;'>" & UNICHAR(8212) & " " &
			                        FORMAT(DimTask[StartDate], "dd MMM yyyy") &
			                        " (" & FORMAT(DATEDIFF(TODAY(), DimTask[StartDate], DAY), "#,0") & "d)</span></div>",
			                        "")
			
			// ─── Overdue milestones ──────────────────────────────────────────────
			VAR _overdueMs    = CONCATENATEX(
			                        TOPN(3,
			                            FILTER(DimTask, DimTask[Milestone] = TRUE && DimTask[PercentDone] < 100 && DimTask[EndDate] < TODAY()),
			                            DATEDIFF(DimTask[EndDate], TODAY(), DAY), DESC),
			                        "<div style='padding:3px 0; font-size:12px;'>" &
			                        "<span style='color:#F44336;'>" & UNICHAR(9670) & "</span>&nbsp; " &
			                        DimTask[Name] &
			                        " <span style='color:#F44336; font-size:10px;'>" & UNICHAR(8212) & " " &
			                        FORMAT(DATEDIFF(DimTask[EndDate], TODAY(), DAY), "#,0") & "d overdue</span></div>",
			                        "")
			
			// =====================================================================
			// HTML CONSTRUCTION
			// =====================================================================
			
			VAR _css = "
			<style>
			  .bfh { font-family:'Segoe UI',Roboto,sans-serif; padding:16px; background:#f5f6f8; color:#1a1a2e; line-height:1.5; }
			  .bfh-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
			  .bfh-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 16px; border-radius:20px; color:#fff; font-weight:600; font-size:13px; }
			  .bfh-kpis { display:flex; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
			  .bfh-kpi { flex:1; min-width:120px; background:#fff; border-radius:8px; padding:12px 14px; box-shadow:0 1px 4px rgba(0,0,0,0.06); position:relative; }
			  .bfh-kpi-val { font-size:22px; font-weight:700; margin:2px 0; }
			  .bfh-kpi-lbl { font-size:11px; color:#666; font-weight:500; }
			  .bfh-kpi-sub { font-size:10px; color:#999; }
			  .bfh-section { background:#fff; border-radius:8px; padding:14px; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
			  .bfh-section-title { font-size:13px; font-weight:700; color:#1a1a2e; margin-bottom:10px; display:flex; align-items:center; gap:6px; }
			  .bfh-bar { display:flex; height:12px; border-radius:6px; overflow:hidden; margin:8px 0; }
			  .bfh-legend { display:flex; gap:14px; flex-wrap:wrap; font-size:11px; color:#555; }
			  .bfh-legend-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle; }
			  .bfh-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
			  .bfh-meter { background:#e8eaed; border-radius:4px; height:6px; overflow:hidden; margin-top:6px; }
			  .bfh-meter-fill { height:100%; border-radius:4px; transition:width 0.3s; }
			  .bfh-tag { display:inline-block; padding:2px 8px; border-radius:10px; font-size:10px; font-weight:600; }
			</style>
			"
			
			// ─── Header ──────────────────────────────────────────────────────────
			VAR _header = "
			<div class='bfh'>
			<div class='bfh-header'>
			  <div>
			    <div style='font-size:18px; font-weight:700;'>" & UNICHAR(128203) & " " & _planName & "</div>
			    <div style='font-size:11px; color:#888; margin-top:2px;'>
			      " & FORMAT(_planStart, "dd MMM yyyy") & " " & UNICHAR(8594) & " " & FORMAT(_planEnd, "dd MMM yyyy") &
			      " &nbsp;" & UNICHAR(183) & "&nbsp; " & FORMAT(_planDuration, "#,0") & " days total" &
			      IF(_planDaysLeft > 0, " &nbsp;" & UNICHAR(183) & "&nbsp; " & FORMAT(_planDaysLeft, "#,0") & " days remaining", " &nbsp;" & UNICHAR(183) & "&nbsp; <span style='color:#F44336;'>Past due</span>") &
			    "</div>
			  </div>
			  <div class='bfh-badge' style='background:" & _healthColor & ";' title='Health score based on: completion (30%), on-time rate (30%), overdue ratio (20%), milestone progress (20%)'>
			    " & _healthIcon & " " & _healthLabel & " &nbsp;" & FORMAT(_healthScore, "0") & "/100
			  </div>
			</div>
			"
			
			// ─── Health score bar ────────────────────────────────────────────────
			VAR _healthBar = "
			<div style='margin-bottom:16px;' title='Weighted score: completion " & FORMAT(_hCompletion, "0.0") & "/30 + on-time " & FORMAT(_hOnTime, "0.0") & "/30 + overdue " & FORMAT(_hOverdue, "0.0") & "/20 + milestones " & FORMAT(_hMilestone, "0.0") & "/20'>
			  <div style='display:flex; justify-content:space-between; font-size:10px; color:#888; margin-bottom:3px;'>
			    <span>Overall Health</span><span>" & FORMAT(_healthScore, "0") & "%</span>
			  </div>
			  <div class='bfh-meter' style='height:8px;'>
			    <div class='bfh-meter-fill' style='width:" & FORMAT(_healthScore, "0") & "%; background:" & _healthColor & ";'></div>
			  </div>
			</div>
			"
			
			// ─── KPI Cards ───────────────────────────────────────────────────────
			VAR _kpiCards = "
			<div class='bfh-kpis'>
			  <div class='bfh-kpi' title='Average completion across all tasks in the plan. " & FORMAT(_complete, "#,0") & " of " & FORMAT(_total, "#,0") & " tasks are 100% done.'>
			    <div class='bfh-kpi-lbl'>" & UNICHAR(128202) & " Completion</div>
			    <div class='bfh-kpi-val' style='color:" & IF(_avgPct >= 70, "#4CAF50", IF(_avgPct >= 40, "#FF9800", "#F44336")) & ";'>" & FORMAT(_avgPct, "0") & "%</div>
			    <div class='bfh-kpi-sub'>" & FORMAT(_complete, "#,0") & " of " & FORMAT(_total, "#,0") & " tasks done</div>
			    <div class='bfh-meter'><div class='bfh-meter-fill' style='width:" & FORMAT(_avgPct, "0") & "%; background:" & IF(_avgPct >= 70, "#4CAF50", IF(_avgPct >= 40, "#FF9800", "#F44336")) & ";'></div></div>
			  </div>
			
			  <div class='bfh-kpi' title='Schedule Performance Index: ratio of earned value to planned value. SPI " & UNICHAR(8805) & " 0.95 is on track, 0.85-0.95 is slightly delayed, < 0.85 is behind schedule.'>
			    <div class='bfh-kpi-lbl'>" & UNICHAR(128337) & " SPI</div>
			    <div class='bfh-kpi-val' style='color:" & _spiColor & ";'>" & FORMAT(_spi, "0.00") & "</div>
			    <div class='bfh-kpi-sub'>" & _spiLabel & "</div>
			    <div class='bfh-meter'><div class='bfh-meter-fill' style='width:" & FORMAT(MIN(100, _spi * 100), "0") & "%; background:" & _spiColor & ";'></div></div>
			  </div>
			
			  <div class='bfh-kpi' title='Tasks past their end date that are not yet 100% complete. High overdue count signals execution risk.'>
			    <div class='bfh-kpi-lbl'>" & UNICHAR(9200) & " Overdue</div>
			    <div class='bfh-kpi-val' style='color:" & IF(_overdue = 0, "#4CAF50", "#F44336") & ";'>" & FORMAT(_overdue, "#,0") & "</div>
			    <div class='bfh-kpi-sub'>" & IF(_overdue = 0, "No overdue tasks", FORMAT(_overdue, "#,0") & " of " & FORMAT(_total, "#,0") & " tasks") & "</div>
			  </div>
			
			  <div class='bfh-kpi' title='Critical path tasks have zero slack/float. Any delay on these tasks will directly delay the project end date.'>
			    <div class='bfh-kpi-lbl'>" & UNICHAR(9889) & " Critical Path</div>
			    <div class='bfh-kpi-val' style='color:" & IF(_critical = 0, "#999", "#E91E63") & ";'>" & FORMAT(_critical, "#,0") & "</div>
			    <div class='bfh-kpi-sub'>" & IF(_critical = 0, "No data / not mapped", FORMAT(_critical, "#,0") & " tasks with 0 slack") & "</div>
			  </div>
			</div>
			"
			
			// ─── Status Distribution ─────────────────────────────────────────────
			VAR _statusBar = "
			<div class='bfh-section' title='Distribution of tasks by schedule status. Complete = 100% done. On Track = progress matches or exceeds expected. At Risk = within 15% of expected. Behind = more than 15% below expected.'>
			  <div class='bfh-section-title'>" & UNICHAR(128200) & " Task Status Distribution</div>
			  <div class='bfh-bar'>" &
			    IF(_pctComplete > 0, "<div style='width:" & FORMAT(_pctComplete, "0") & "%; background:#4CAF50;' title='Complete: " & FORMAT(_complete, "#,0") & " tasks (" & FORMAT(_pctComplete, "0") & "%)'></div>", "") &
			    IF(_pctOnTrack > 0, "<div style='width:" & FORMAT(_pctOnTrack, "0") & "%; background:#2196F3;' title='On Track: " & FORMAT(_onTrack, "#,0") & " tasks (" & FORMAT(_pctOnTrack, "0") & "%)'></div>", "") &
			    IF(_pctAtRisk > 0, "<div style='width:" & FORMAT(_pctAtRisk, "0") & "%; background:#FF9800;' title='At Risk: " & FORMAT(_atRisk, "#,0") & " tasks (" & FORMAT(_pctAtRisk, "0") & "%)'></div>", "") &
			    IF(_pctBehind > 0, "<div style='width:" & FORMAT(_pctBehind, "0") & "%; background:#F44336;' title='Behind: " & FORMAT(_behind, "#,0") & " tasks (" & FORMAT(_pctBehind, "0") & "%)'></div>", "") &
			  "</div>
			  <div class='bfh-legend'>
			    <span><span class='bfh-legend-dot' style='background:#4CAF50;'></span>Complete " & FORMAT(_pctComplete, "0") & "%</span>
			    <span><span class='bfh-legend-dot' style='background:#2196F3;'></span>On Track " & FORMAT(_pctOnTrack, "0") & "%</span>
			    <span><span class='bfh-legend-dot' style='background:#FF9800;'></span>At Risk " & FORMAT(_pctAtRisk, "0") & "%</span>
			    <span><span class='bfh-legend-dot' style='background:#F44336;'></span>Behind " & FORMAT(_pctBehind, "0") & "%</span>
			  </div>
			</div>
			"
			
			// ─── Milestones & Baseline (2-column grid) ──────────────────────────
			VAR _detailGrid = "
			<div class='bfh-grid'>
			  <div class='bfh-section' title='Milestone tracking: diamonds in the Gantt. Overdue milestones are past their target date and not yet achieved.'>
			    <div class='bfh-section-title'>" & UNICHAR(128142) & " Milestones</div>
			    <div style='display:flex; gap:10px; margin-bottom:10px;'>
			      <div style='text-align:center; flex:1;'>
			        <div style='font-size:18px; font-weight:700; color:#4CAF50;'>" & FORMAT(_msDone, "#,0") & "</div>
			        <div style='font-size:10px; color:#888;'>Done</div>
			      </div>
			      <div style='text-align:center; flex:1;'>
			        <div style='font-size:18px; font-weight:700; color:#2196F3;'>" & FORMAT(_msUpcoming, "#,0") & "</div>
			        <div style='font-size:10px; color:#888;'>Upcoming</div>
			      </div>
			      <div style='text-align:center; flex:1;'>
			        <div style='font-size:18px; font-weight:700; color:" & IF(_msOverdue > 0, "#F44336", "#999") & ";'>" & FORMAT(_msOverdue, "#,0") & "</div>
			        <div style='font-size:10px; color:#888;'>Overdue</div>
			      </div>
			    </div>" &
			    IF(_msTotal > 0,
			      "<div class='bfh-meter'><div class='bfh-meter-fill' style='width:" & FORMAT(DIVIDE(_msDone, _msTotal) * 100, "0") & "%; background:#4CAF50;'></div></div>
			       <div style='font-size:10px; color:#999; margin-top:4px;'>" & FORMAT(_msDone, "#,0") & " of " & FORMAT(_msTotal, "#,0") & " milestones achieved</div>",
			      "<div style='font-size:11px; color:#999;'>No milestones defined</div>") &
			    IF(NOT(ISBLANK(_nextMsName)),
			      "<div style='margin-top:10px; padding:8px; background:#f5f6f8; border-radius:6px; font-size:11px;' title='Next upcoming milestone by date'>
			        <div style='color:#888; font-size:10px; margin-bottom:2px;'>NEXT MILESTONE</div>
			        <div style='font-weight:600;'>" & UNICHAR(9670) & " " & _nextMsName & "</div>
			        <div style='color:#888;'>" & FORMAT(_nextMsDate, "dd MMM yyyy") & " &nbsp;" & UNICHAR(183) & "&nbsp; " & FORMAT(_daysToNextMs, "#,0") & " days away</div>
			      </div>", "") & "
			  </div>
			
			  <div class='bfh-section' title='Baseline comparison: how current schedule compares to original plan. Positive variance = schedule slippage. Requires BaselineStart and BaselineEnd data.'>
			    <div class='bfh-section-title'>" & UNICHAR(128197) & " Baseline Variance</div>" &
			    IF(_blTotal > 0,
			      "<div style='display:flex; gap:10px; margin-bottom:10px;'>
			        <div style='text-align:center; flex:1;'>
			          <div style='font-size:18px; font-weight:700; color:#2196F3;'>" & FORMAT(_blTotal, "#,0") & "</div>
			          <div style='font-size:10px; color:#888;'>With baseline</div>
			        </div>
			        <div style='text-align:center; flex:1;'>
			          <div style='font-size:18px; font-weight:700; color:" & IF(_blSlipped > 0, "#F44336", "#4CAF50") & ";'>" & FORMAT(_blSlipped, "#,0") & "</div>
			          <div style='font-size:10px; color:#888;'>Slipped</div>
			        </div>
			        <div style='text-align:center; flex:1;'>
			          <div style='font-size:18px; font-weight:700; color:" & IF(_blAvgSlip > 3, "#F44336", IF(_blAvgSlip > 0, "#FF9800", "#4CAF50")) & ";'>" & IF(_blAvgSlip > 0, "+", "") & FORMAT(_blAvgSlip, "0.0") & "d</div>
			          <div style='font-size:10px; color:#888;'>Avg. variance</div>
			        </div>
			      </div>
			      <div class='bfh-meter'><div class='bfh-meter-fill' style='width:" & FORMAT(DIVIDE(_blTotal - _blSlipped, _blTotal) * 100, "0") & "%; background:#4CAF50;'></div></div>
			      <div style='font-size:10px; color:#999; margin-top:4px;'>" & FORMAT(_blTotal - _blSlipped, "#,0") & " of " & FORMAT(_blTotal, "#,0") & " tasks on or ahead of baseline</div>",
			      "<div style='font-size:11px; color:#999; padding:8px 0;'>No baseline data mapped. Add BaselineStart and BaselineEnd fields to enable variance tracking.</div>") & "
			  </div>
			</div>
			"
			
			// ─── Top Risks & Upcoming Milestones (2-column grid) ─────────────────
			VAR _risksSection = "
			<div class='bfh-grid'>
			  <div class='bfh-section' title='Most overdue tasks ranked by days past their end date. These need immediate attention to prevent further schedule slippage.'>
			    <div class='bfh-section-title'><span style='color:#F44336;'>" & UNICHAR(128680) & "</span> Top Risks</div>" &
			    IF(_overdue > 0, _topRisks,
			      "<div style='font-size:12px; color:#4CAF50; padding:4px 0;'>" & UNICHAR(9989) & " No overdue tasks — all on track!</div>") & "
			  </div>
			
			  <div class='bfh-section' title='Next milestones coming up, sorted by nearest date. Plan ahead to ensure these are delivered on time.'>
			    <div class='bfh-section-title'><span style='color:#FF9800;'>" & UNICHAR(128142) & "</span> Upcoming Milestones</div>" &
			    IF(LEN(_upcomingMs) > 0, _upcomingMs,
			      "<div style='font-size:12px; color:#999; padding:4px 0;'>No upcoming milestones</div>") &
			    IF(_msOverdue > 0,
			      "<div style='margin-top:8px; border-top:1px solid #f0f0f0; padding-top:8px;'>
			        <div style='font-size:11px; font-weight:600; color:#F44336; margin-bottom:4px;'>" & UNICHAR(9888) & " Overdue Milestones</div>" &
			        _overdueMs & "</div>", "") & "
			  </div>
			</div>
			"
			
			// ─── DimResource footer ────────────────────────────────────────────────
			VAR _resSection = "
			<div class='bfh-section' title='Resource overview: distinct people/resources assigned to tasks in this plan. Average load = tasks per resource.'>
			  <div style='display:flex; justify-content:space-between; align-items:center;'>
			    <div class='bfh-section-title' style='margin-bottom:0;'>" & UNICHAR(128101) & " Resources</div>
			    <div style='display:flex; gap:20px; font-size:12px;'>
			      <span title='Number of distinct resources assigned'><strong>" & FORMAT(_resCount, "#,0") & "</strong> resources assigned</span>
			      <span title='Average number of tasks per resource'><strong>" & FORMAT(_avgTasksPerRes, "0.0") & "</strong> tasks/resource avg.</span>
			      <span title='Total tasks in plan'><strong>" & FORMAT(_total, "#,0") & "</strong> total tasks</span>
			    </div>
			  </div>
			</div>
			"
			
			// ─── Footer ──────────────────────────────────────────────────────────
			VAR _footer = "
			<div style='text-align:right; font-size:9px; color:#bbb; margin-top:8px;'>
			  BFUSION Insight &nbsp;" & UNICHAR(183) & "&nbsp; " & FORMAT(TODAY(), "dd MMM yyyy") & " &nbsp;" & UNICHAR(183) & "&nbsp; Auto-generated health assessment
			</div>
			</div>
			"
			
			// ─── Empty state ─────────────────────────────────────────────────────
			VAR _empty = "
			<div class='bfh' style='text-align:center; padding:60px 20px;'>
			  <div style='font-size:36px; margin-bottom:12px;'>" & UNICHAR(128203) & "</div>
			  <div style='font-size:16px; font-weight:600; color:#555;'>No task data available</div>
			  <div style='font-size:12px; color:#999; margin-top:6px;'>Select a plan or verify that task data is loaded</div>
			</div>
			"
			
			RETURN
			IF(_total = 0, _css & _empty,
			    _css & _header & _healthBar & _kpiCards & _statusBar & _detailGrid & _risksSection & _resSection & _footer)
			
			```
		displayFolder: Project
		lineageTag: d970c4dd-3621-43e2-bd44-89ff29ff0179

		changedProperty = IsHidden

	/// Subject area: Capacity.
	measure 'Capacity | Committed FTE' = [Capacity | Total Hours Committed]/1720
		displayFolder: Capacity
		lineageTag: 24250a48-b4ac-4b6d-8809-de56057aeba0

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Source: Calendar[Date].
	measure 'Finance | Actual Cost Cost LY' = CALCULATE( [Finance | Actual Cost], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: 78a907ef-ad03-4008-b280-03626ca22ae6

	/// Source: Calendar[Date].
	measure 'Finance | Budget Cost LY' = CALCULATE( [Finance | Budget Cost], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: c76bbe4d-0efe-4963-8b28-c6b58572991f

	/// Source: Calendar[Date].
	measure 'Finance | Extern Budget LY' = CALCULATE( [Finance | Extern Budget], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: 68c31882-977a-4ab0-b909-b137c61c9c2f

	/// Source: Calendar[Date].
	measure 'Finance | Forecast Cost Cost LY' = CALCULATE( [Finance | Forecast Cost], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: 4bc624bd-f7f5-41c6-9fa9-ee73f3bead78

	/// Source: Calendar[Date].
	measure 'Finance | Initial Budget Cost LY' = CALCULATE( [Finance | Initial Budget Cost], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: b7f5120a-ffe6-4f02-85b9-7a3b722a29c8

	/// Source: Calendar[Date].
	measure 'Finance | Labor Budget LY' = CALCULATE( [Finance | Labor Budget], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: 4b43d495-a21d-40dd-afc0-b66c579b8c81

	/// Source: Calendar[Date].
	measure 'Finance | Program Budget Cost LY' = CALCULATE( [Program | Total Budget], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: 95a69598-c0ec-410c-9ec4-ce27d9e5efba

	/// Source: Calendar[Date].
	measure 'Finance | Total Budget LY' = CALCULATE( [Finance | Total Budget], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: cef29a34-9f57-4d1b-a9b1-17b95897ddb3

	/// Source: Calendar[Date].
	measure 'Finance | Total Cost LY' = CALCULATE( [Finance | Total Cost], SAMEPERIODLASTYEAR(DimDate[Date]) )
		formatString: #,##0.00
		displayFolder: Finance
		lineageTag: b6c6df5e-478c-4484-8073-a3e351545491

	/// Subject area: Finance.
	measure 'Finance | Budget Remaining' = [Finance | Budget Cost] - [Project | Total Actuals]
		displayFolder: Finance
		lineageTag: ae68c817-0173-4883-8375-5db704230416

		annotation PBI_FormatHint = {"isGeneralNumber":true}

