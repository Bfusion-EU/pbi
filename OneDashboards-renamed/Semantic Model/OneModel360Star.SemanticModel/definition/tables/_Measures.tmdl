	/// Source: calendar[Date].
	measure 'Capacity | Plan Volatility Index' =
			
			//This measures how much the schedule has shifted compared to last month. High volatility often precedes project delays.
			VAR CurrentSched = [Capacity | Total Hours Scheduled]
			VAR PreviousSched = CALCULATE([Capacity | Total Hours Scheduled], DATEADD(DimDate[Date], -1, MONTH))
			VAR Delta = ABS(CurrentSched - PreviousSched)
			RETURN
			IF(ISBLANK(PreviousSched), 0, DIVIDE(Delta, PreviousSched))
		displayFolder: Capacity
		lineageTag: a35ea444-69fc-487d-98c9-8e6c61ee41f9

