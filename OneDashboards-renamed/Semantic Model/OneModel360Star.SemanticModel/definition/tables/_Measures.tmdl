	/// Source: Resources[UserId].
	measure 'Resource KPI | Total Resources' =
			CALCULATE(
			    DISTINCTCOUNT(DimResource[UserId]),
			    DimResource[Inactive] = FALSE()
			)
		formatString: #,##0
		displayFolder: Resource KPI
		lineageTag: 6b8818fb-559c-4504-9bcd-8421a28cc4de

	/// Source: ResPlan[ResourceId].
	measure 'Resource KPI | Allocated Resources' =
			CALCULATE(
			    DISTINCTCOUNT(FactResourcePlan[ResourceId]),
			    FactResourcePlan[CostType] = "Scheduled"
			)
		formatString: #,##0
		displayFolder: Resource KPI
		lineageTag: 1293aecd-f8a1-46e8-b975-916b5af73d23

	/// Source: Resources[UserId].
	measure 'Resource KPI | Under-utilized Resources' =
			VAR _ResAllocTable =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(DimResource[UserId]),
			            CALCULATE(COUNTROWS(FactCapacity)) > 0
			        ),
			        "@MaxAlloc",
			            CALCULATE(
			                MAXX(
			                    SUMMARIZE(DimDate, DimDate[Period]),
			                    CALCULATE([Capacity | Resource Utilization%])
			                )
			            ),
			        "@HasAnyAlloc",
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        SUMMARIZE(DimDate, DimDate[Period]),
			                        CALCULATE([Capacity | Resource Utilization%]) > 0
			                    )
			                )
			            )
			    )
			RETURN
			    COUNTROWS(
			        FILTER(
			            _ResAllocTable,
			            [@HasAnyAlloc] > 0 && [@MaxAlloc] < 0.25
			        )
			    )
		formatString: #,##0
		displayFolder: Resource KPI
		lineageTag: c5417bb3-05b7-49c4-bb91-144f5ca5e37a

	/// Source: Resources[UserId].
