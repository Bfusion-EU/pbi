	/// Source: Plans[BusinessUnit_Value].
	measure 'Portfolio 360 | Top Segment Budget' = ```
			
			VAR _vals = ADDCOLUMNS (
			        VALUES ( DimProject[BusinessUnit_Value] ),
			        "@b", CALCULATE ( [Finance | Total Budget] )
			    )
			RETURN
			    MAXX ( _vals, [@b] )
			
			```
		formatString: #,##0
		displayFolder: Portfolio 360
		lineageTag: fb1e7f2b-f0ec-4293-9d22-236a0f2826f7

	/// Source: Plans[BusinessUnit_Value].
	measure 'Portfolio 360 | Top Segment % of Total' = ```
			
