	/// Source: Plans[Name].
	measure 'Portfolio 360 | Top Project Budget' = ```
			
			VAR _vals = ADDCOLUMNS (
			        VALUES ( DimProject[Name] ),
			        "@b", CALCULATE ( [Finance | Total Budget] )
