		displayFolder: Portfolio 360
		lineageTag: d4f18783-a070-4c07-a90a-c4d83804b45d

	/// Subject area: Portfolio 360.
	measure 'Portfolio 360 | Avg Budget per Project' = ```
			
			DIVIDE ( [Finance | Total Budget], [Portfolio 360 | Active Projects] )
			
			```
		formatString: #,##0
		displayFolder: Portfolio 360
		lineageTag: 78ab37c7-dfae-40d1-b8b8-29565b26be11

	/// Source: Plans[Forecast].
	measure 'Portfolio 360 | Avg Forecast Overrun per Project' = ```
			
			VAR _overrun = SUMX ( DimProject, MAX ( DimProject[Forecast] - DimProject[Budget], 0 ) )
			VAR _n       = [Portfolio 360 | Active Projects]
			RETURN
			    DIVIDE ( _overrun, _n )
			
