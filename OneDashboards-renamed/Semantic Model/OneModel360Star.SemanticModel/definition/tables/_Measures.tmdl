	/// Subject area: Capacity.
	measure 'Capacity | Planning Confidence Score' =
			//compares your past forecasts to what actually happened. A score of 100% means the forecast was perfect.
			VAR Forecasted = [Capacity | Allocation % (Forecast)]
			VAR Actual = [Capacity | Avg Utilization Across Resources]
			// Ensure we are working with decimals, even if the measures are empty
			VAR Var_Forecast = IF(ISBLANK(Forecasted), 0, Forecasted)
			VAR Var_Actual = IF(ISBLANK(Actual), 0, Actual)
			VAR VarianceValue = ABS(Var_Forecast - Var_Actual)
			VAR Result = 1 - VarianceValue
			RETURN
			// Ensure the score doesn't drop below 0 if the variance is > 100%
			IF(Result < 0, 0, Result)
		displayFolder: Capacity
		lineageTag: b819300f-ba45-44bf-a9f6-8e58e436bef1

