	/// Source: Plans[ScheduleHealth_Value].
	measure 'Portfolio 360 | On-Time Flag' = ```
			
			// 1 when the current row's ScheduleHealth is healthy, 0 otherwise.
			// The visual averages this to derive On-Time % per Segment / Period.
			VAR _h = LOWER ( SELECTEDVALUE ( DimProject[ScheduleHealth_Value] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        _h IN { "on track", "green", "ontrack" },               1,
			        _h IN { "at risk", "yellow", "caution", "cautious" }, 0,
			        _h IN { "late", "behind", "red", "behind schedule" }, 0,
			        BLANK ()
			    )
			
