	/// Source: Calendar[Date].
	measure 'Portfolio 360 | Budget MoM %' = ```
			
			// Uses the DimDate[Date] date table. Falls back to BLANK when no period
			// column is in context.
			VAR _cur  = [Finance | Total Budget]
			VAR _prev = CALCULATE ( [Finance | Total Budget], DATEADD ( DimDate[Date], -1, MONTH ) )
			RETURN
			    DIVIDE ( _cur - _prev, _prev )
			
			```
		formatString: 0.0%
		displayFolder: Portfolio 360
		lineageTag: b72c5c4e-372a-48a4-bfbb-43c62f0d7eae

	/// Source: Calendar[Date].
	measure 'Portfolio 360 | On-Time Delivery MoM (pts)' = ```
			
			VAR _cur  = [Portfolio 360 | On-Time Delivery %]
			VAR _prev = CALCULATE ( [Portfolio 360 | On-Time Delivery %], DATEADD ( DimDate[Date], -1, MONTH ) )
			RETURN
			    ( _cur - _prev ) * 100
			
			```
		formatString: +0.0;-0.0;0
		displayFolder: Portfolio 360
		lineageTag: 816d6ddd-025c-45dd-a813-a6ae0c587551

	/// Source: ModelerScenario[TargetBudget].
	measure 'Portfolio 360 | Budget Target' = ```
			
