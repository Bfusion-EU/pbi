	/// Period-level Committed demand restricted to plans checked in picker A's scenario. Bind to the Period Demand role.
	measure 'ScenarioCompare | Committed (A)' =
			VAR _s = SELECTEDVALUE ( ModelerScenario_A[Name] )
			VAR _checkedNames =
			    CALCULATETABLE (
			        VALUES ( FactModelerScenarioPlan[Name] ),
			        ALL ( DimScenario ),
			        TREATAS ( { _s }, DimScenario[Name] ),
			        FactModelerScenarioPlan[Checked] = TRUE ()
			    )
			RETURN
			    IF (
			        ISBLANK ( _s ),
			        [Capacity | Committed],
			        CALCULATE (
			            [Capacity | Committed],
			            TREATAS ( _checkedNames, DimProject[Name] )
			        )
			    )
		formatString: #,##0
		displayFolder: ScenarioCompare
		lineageTag: ebf17d8e-0599-47f7-95b3-454616d3569b

	/// Period-level Committed demand restricted to plans checked in picker B's scenario. Bind to the Compare — Period Demand role.
	measure 'ScenarioCompare | Committed (B)' =
			VAR _s = SELECTEDVALUE ( ModelerScenario_B[Name] )
			VAR _checkedNames =
			    CALCULATETABLE (
			        VALUES ( FactModelerScenarioPlan[Name] ),
			        ALL ( DimScenario ),
			        TREATAS ( { _s }, DimScenario[Name] ),
			        FactModelerScenarioPlan[Checked] = TRUE ()
			    )
			RETURN
			    IF (
			        ISBLANK ( _s ),
			        [Capacity | Committed],
			        CALCULATE (
			            [Capacity | Committed],
			            TREATAS ( _checkedNames, DimProject[Name] )
			        )
			    )
		formatString: #,##0
		displayFolder: ScenarioCompare
		lineageTag: 8a93f02c-f8d2-4f5f-9160-bdbda0d77797

	/// Per-project CommittedEffort hours for the scenario picked via ModelerScenario_A. Returns 0 when the project is not checked in that scenario. Bind to the Committed Effort role.
	measure 'ScenarioCompare | Committed Effort (A)' =
			VAR _s    = SELECTEDVALUE ( ModelerScenario_A[Name] )
			VAR _proj = SELECTEDVALUE ( DimProject[Name] )
			VAR _eff  = SUM ( DimProject[CommittedEffort] )
			RETURN
			    IF (
			        ISBLANK ( _proj ),
			        BLANK (),
			        IF (
			            ISBLANK ( _s ),
			            _eff,
			            VAR _checked =
			                CALCULATE (
			                    COUNTROWS ( FactModelerScenarioPlan ),
			                    ALL ( DimScenario ),
			                    TREATAS ( { _s }, DimScenario[Name] ),
			                    FactModelerScenarioPlan[Name]    = _proj,
			                    FactModelerScenarioPlan[Checked] = TRUE ()
			                )
			            RETURN IF ( _checked > 0, _eff, 0 )
			        )
			    )
		formatString: #,##0
		displayFolder: ScenarioCompare
		lineageTag: 81d48f1b-565f-4f7b-a35a-10b4a347a454

	/// Per-project CommittedEffort hours for the scenario picked via ModelerScenario_B.
	measure 'ScenarioCompare | Committed Effort (B)' =
			VAR _s    = SELECTEDVALUE ( ModelerScenario_B[Name] )
			VAR _proj = SELECTEDVALUE ( DimProject[Name] )
			VAR _eff  = SUM ( DimProject[CommittedEffort] )
			RETURN
			    IF (
			        ISBLANK ( _proj ),
			        BLANK (),
			        IF (
			            ISBLANK ( _s ),
			            _eff,
			            VAR _checked =
			                CALCULATE (
			                    COUNTROWS ( FactModelerScenarioPlan ),
			                    ALL ( DimScenario ),
			                    TREATAS ( { _s }, DimScenario[Name] ),
			                    FactModelerScenarioPlan[Name]    = _proj,
			                    FactModelerScenarioPlan[Checked] = TRUE ()
			                )
			            RETURN IF ( _checked > 0, _eff, 0 )
			        )
			    )
		formatString: #,##0
		displayFolder: ScenarioCompare
		lineageTag: 7b7f626b-bce3-4119-b072-b1e68b252e78

	/// Plan membership flag for picker A. 1 when Plans[Name] is checked in the picked scenario, else 0. Bind to the In Scenario role.
	measure 'ScenarioCompare | Membership (A)' =
			VAR _s    = SELECTEDVALUE ( ModelerScenario_A[Name] )
			VAR _proj = SELECTEDVALUE ( DimProject[Name] )
			RETURN
			    IF (
			        ISBLANK ( _proj ),
			        0,
			        IF (
			            ISBLANK ( _s ),
			            IF (
			                CALCULATE (
			                    COUNTROWS ( FactModelerScenarioPlan ),
			                    FactModelerScenarioPlan[Name]    = _proj,
			                    FactModelerScenarioPlan[Checked] = TRUE ()
			                ) > 0, 1, 0
			            ),
			            IF (
			                CALCULATE (
			                    COUNTROWS ( FactModelerScenarioPlan ),
			                    ALL ( DimScenario ),
			                    TREATAS ( { _s }, DimScenario[Name] ),
			                    FactModelerScenarioPlan[Name]    = _proj,
			                    FactModelerScenarioPlan[Checked] = TRUE ()
			                ) > 0, 1, 0
			            )
			        )
			    )
		formatString: 0
		displayFolder: ScenarioCompare
		lineageTag: 87c948ee-5f65-4961-a037-b7aab29e69b7

	/// Plan membership flag for picker B. Bind to the Compare — In Scenario role.
	measure 'ScenarioCompare | Membership (B)' =
			VAR _s    = SELECTEDVALUE ( ModelerScenario_B[Name] )
			VAR _proj = SELECTEDVALUE ( DimProject[Name] )
			RETURN
			    IF (
			        ISBLANK ( _proj ),
