	/// Source: Plans[ScheduleHealth_Value].
	measure 'Portfolio 360 | On-Time Delivery %' = ```
			
			VAR _total = CALCULATE ( COUNTROWS ( DimProject ), NOT ISBLANK ( DimProject[ScheduleHealth_Value] ) )
			VAR _ok    = CALCULATE (
			        COUNTROWS ( DimProject ),
			        LOWER ( DimProject[ScheduleHealth_Value] ) IN { "on track", "green", "ontrack" }
			    )
			RETURN
			    DIVIDE ( _ok, _total )
			
			```
