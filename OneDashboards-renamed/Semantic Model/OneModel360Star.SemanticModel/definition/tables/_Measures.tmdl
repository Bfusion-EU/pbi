		displayFolder: Portfolio 360
		lineageTag: 55060c83-c0b9-46b4-95b4-06902f8b607a

	/// Source: Plans[BusinessUnit_Value].
	measure 'Portfolio 360 | Top Segment Name' = ```
			
			// Picks the highest-budget Business Unit in the current filter context.
			VAR _top =
			    TOPN (
			        1,
			        ADDCOLUMNS (
			            VALUES ( DimProject[BusinessUnit_Value] ),
			            "@b", CALCULATE ( [Finance | Total Budget] )
			        ),
			        [@b], DESC
			    )
			RETURN
			    CONCATENATEX ( _top, DimProject[BusinessUnit_Value], ", " )
			
			```
