	/// Subject area: Capacity.
	measure 'Capacity | Capacity per FTE' =
			VAR _HC = [Resource | Headcount]
			RETURN
			    IF( _HC > 0, DIVIDE( [Capacity | Resource Capacity], _HC ), BLANK() )
		formatString: #,##0
		displayFolder: Capacity
		lineageTag: 949951c5-8351-4f2f-9313-de1632b31106

	/// Subject area: Capacity.
	measure 'Capacity | Demand per FTE' =
			VAR _HC = [Resource | Headcount]
			RETURN
			    IF( _HC > 0, DIVIDE( [Capacity | Demand], _HC ), BLANK() )
		formatString: #,##0
		displayFolder: Capacity
		lineageTag: 6ba22122-fff3-4f8c-ba8c-b86c72cfeb9d

	/// Source: Calendar[Year].
	measure 'Capacity | Prev Capacity' =
			VAR _CurYear  = SELECTEDVALUE( DimDate[Year] )
			VAR _CurMonth = SELECTEDVALUE( DimDate[Month] )
			VAR _PrevYear  = IF( _CurMonth = 1, _CurYear - 1, _CurYear )
			VAR _PrevMonth = IF( _CurMonth = 1, 12, _CurMonth - 1 )
			RETURN
			    IF(
			        NOT ISBLANK( _CurYear ) && NOT ISBLANK( _CurMonth ),
			        CALCULATE(
			            SUM( FactCapacity[Capacity] ),
			            REMOVEFILTERS( DimDate ),
			            DimDate[Year]  = _PrevYear,
			            DimDate[Month] = _PrevMonth
			        ),
			        // Multi-month context: shift each date back ~30 days
			        CALCULATE(
			            SUM( FactCapacity[Capacity] ),
			            DATEADD( DimDate[Date], -1, MONTH )
			        )
			    )
		formatString: #,##0
		displayFolder: Capacity
		lineageTag: 40d1d949-ef39-4862-b885-855275e22888

	/// Source: Calendar[Year].
	measure 'Capacity | Prev Demand' =
			VAR _CurYear  = SELECTEDVALUE( DimDate[Year] )
			VAR _CurMonth = SELECTEDVALUE( DimDate[Month] )
			VAR _PrevYear  = IF( _CurMonth = 1, _CurYear - 1, _CurYear )
			VAR _PrevMonth = IF( _CurMonth = 1, 12, _CurMonth - 1 )
			RETURN
			    IF(
			        NOT ISBLANK( _CurYear ) && NOT ISBLANK( _CurMonth ),
			        CALCULATE(
			            SUM( FactResourcePlan[Hours] ),
			            REMOVEFILTERS( DimDate ),
			            DimDate[Year]  = _PrevYear,
			            DimDate[Month] = _PrevMonth
			        ),
			        CALCULATE(
			            SUM( FactResourcePlan[Hours] ),
			            DATEADD( DimDate[Date], -1, MONTH )
			        )
			    )
		formatString: #,##0
		displayFolder: Capacity
		lineageTag: f7ed37be-345a-4a2a-995c-d4f600d90e19

	/// Subject area: Capacity.
	measure 'Capacity | Capacity Change %' =
			VAR _Prev = [Capacity | Prev Capacity]
			RETURN
			    IF( _Prev > 0, DIVIDE( [Capacity | Resource Capacity] - _Prev, _Prev ) * 100, BLANK() )
		formatString: +0.0"%";-0.0"%";"0.0%"
		displayFolder: Capacity
		lineageTag: 0dd5e036-d24e-4cf9-9c9e-ca983e45cc16

	/// Subject area: Capacity.
	measure 'Capacity | Demand Change %' =
