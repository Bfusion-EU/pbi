		lineageTag: 9a855cdd-bc5d-4a45-a8f1-8f8a1d018a1c

	/// Selection Waterfall. Source: ModelerScenario[TargetBudget].
	measure 'Modeler | Portfolio Budget' = ```
			
			// Uses Modeler scenario TargetBudget when a scenario is in context,
			// otherwise falls back to the sum of portfolio-level budgets.
			VAR _scenarioBudget  = SUM ( DimScenario[TargetBudget] )
			VAR _portfolioBudget = SUM ( DimPortfolio[Budget] )
			RETURN
			    IF ( _scenarioBudget <> 0, _scenarioBudget, _portfolioBudget )
			
			```
		formatString: #,##0
