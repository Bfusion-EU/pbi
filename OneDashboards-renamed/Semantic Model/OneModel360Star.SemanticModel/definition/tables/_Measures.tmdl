	/// Selection Waterfall. Source: Plan_Projects[PrioritizationScore].
	measure 'Modeler | Priority Score' = ```
			
			// Cascading priority: PrioritizationScore → WSJF → CostofDelay → Strategic Alignment numeric
			VAR _ps   = MAX ( DimProject[PrioritizationScore] )
			VAR _wsjf = MAX ( DimProject[WSJF] )
			VAR _cod  = MAX ( DimProject[CostofDelay] )
			VAR _sa   =
			    SWITCH (
			        MAX ( DimProject[StrategicAlignment_Value] ),
			        "Extreme", 100,
			        "Strong",   80,
			        "Moderate",  60,
			        "Low",       40,
			        "Not Rated", 20,
			        0
			    )
			RETURN
			    IF ( _ps <> 0,   _ps,
			    IF ( _wsjf <> 0, _wsjf,
			    IF ( _cod <> 0,  _cod,
			        _sa
			    )))
			
			```
		formatString: #,##0.00
		displayFolder: Modeler
		lineageTag: c5c65d6a-ae4f-43b2-8647-652569fa0a0c

	/// Estimated cost per project — determines bar height in the waterfall.
	measure 'Modeler | Project Estimated Cost' = ```
			
			SUM ( DimProject[EstimatedCost] )
			
