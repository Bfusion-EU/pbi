	/// Source: Plans[ScheduleHealth_Value].
	measure 'Portfolio 360 | Slipping Count' = ```
			
			CALCULATE (
			    COUNTROWS ( DimProject ),
			    LOWER ( DimProject[ScheduleHealth_Value] ) IN { "late", "behind", "red", "behind schedule" }
			)
			
			```
