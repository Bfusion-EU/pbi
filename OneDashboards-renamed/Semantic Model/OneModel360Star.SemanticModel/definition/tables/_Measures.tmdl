			        IF (
			            ISBLANK ( _s ),
			            IF (
			                CALCULATE (
			                    COUNTROWS ( FactModelerScenarioPlan ),
			                    FactModelerScenarioPlan[Name]    = _proj,
			                    FactModelerScenarioPlan[Checked] = TRUE ()
			                ) > 0, 1, 0
			            ),
			            IF (
			                CALCULATE (
