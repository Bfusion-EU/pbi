	/// Source: Tasks[Impact].
	measure 'Risk & Issue | Impact Score' = ```
			AVERAGEX(
			    DimTask,
			    SWITCH(
			        TRUE(),
			        DimTask[Impact] = "(1) Critical", 5,
			        DimTask[Impact] = "(2) High",     4,
			        DimTask[Impact] = "(3) Medium",   3,
			        DimTask[Impact] = "(4) Low",      2,
			        LEFT( DimTask[Impact], 1 ) = "(",
			            6 - VALUE( MID( DimTask[Impact], 2, 1 ) ),
			        3
			    )
			)
			
