		displayFolder: Capacity
		lineageTag: 706ceeda-2e46-485b-b01e-f968fb838339

	/// Source: ResPlan[Hours].
	measure 'Resource | Scheduled' =
			CALCULATE(
			    SUM( FactResourcePlan[Hours] ),
			    FactResourcePlan[CostType] = "Scheduled"
			)
		formatString: #,##0
		displayFolder: Resource
		lineageTag: 6b7d8888-f586-46af-8a73-e0bd28e59680

	/// Source: Capacity[Capacity].
	measure 'Resource | Utilization' =
			VAR _Cap = SUM( FactCapacity[Capacity] )
			VAR _Dem = SUM( FactResourcePlan[Hours] )
			RETURN
			    IF( _Cap > 0, DIVIDE( _Dem, _Cap ) * 100, BLANK() )
		formatString: 0.0
		displayFolder: Resource
		lineageTag: 81a0fa95-2875-4c5d-b385-260c043f609c

	/// Subject area: Capacity.
	measure 'Capacity | Available Capacity' =
			VAR _Avail = [Capacity | Resource Capacity] - [Capacity | Committed] - [Resource | Scheduled]
			RETURN
			    MAX( _Avail, 0 )
		formatString: #,##0
		displayFolder: Capacity
		lineageTag: f6efe924-2a0c-458d-b5a0-9c6a6c8e3fb6

	/// Subject area: Capacity.
	measure 'Capacity | Demand Coverage %' =
			VAR _Dem = [Capacity | Demand]
			VAR _Covered = [Capacity | Committed] + [Resource | Scheduled]
			RETURN
			    IF( _Dem > 0, MIN( DIVIDE( _Covered, _Dem ) * 100, 100 ), BLANK() )
		formatString: 0.0"%"
		displayFolder: Capacity
		lineageTag: 7aca6207-fc66-49b1-9994-4a46c6ee6d8f

	/// Subject area: Resource.
	measure 'Resource | Supply-Demand Ratio' =
			VAR _Dem = [Capacity | Demand]
			RETURN
			    IF( _Dem > 0, DIVIDE( [Capacity | Resource Capacity], _Dem ), BLANK() )
		formatString: 0.00
		displayFolder: Resource
		lineageTag: 50768ab1-50f9-4d2e-b11f-68433fb9a50c

	/// Subject area: Capacity.
	measure 'Capacity | Demand Firmness %' =
			VAR _Total = [Capacity | Committed] + [Capacity | Forecast] + [Resource | Scheduled]
			RETURN
			    IF( _Total > 0, DIVIDE( [Capacity | Committed], _Total ) * 100, BLANK() )
		formatString: 0.0"%"
		displayFolder: Capacity
		lineageTag: 4a8d89bf-00dd-41be-be39-45fac4b0cf4f

	/// Subject area: Resource.
	measure 'Resource | Slack %' =
			VAR _Cap = [Capacity | Resource Capacity]
			RETURN
			    IF( _Cap > 0, DIVIDE( [Capacity | Available Capacity], _Cap ) * 100, BLANK() )
		formatString: 0.0"%"
		displayFolder: Resource
		lineageTag: 1899e209-b789-4ed1-84ed-da572eac313a

	/// Subject area: Capacity.
	measure 'Capacity | Forecast Exposure %' =
			VAR _Dem = [Capacity | Demand]
			RETURN
			    IF( _Dem > 0, DIVIDE( [Capacity | Forecast], _Dem ) * 100, BLANK() )
		formatString: 0.0"%"
		displayFolder: Capacity
		lineageTag: dfbd3611-44ac-4ca3-bdd0-d5645127af88

	/// Subject area: Resource.
	measure 'Resource | Pipeline Health Score' =
			VAR _Firmness  = [Capacity | Demand Firmness %]
			VAR _Coverage  = [Capacity | Demand Coverage %]
			VAR _FctExp    = [Capacity | Forecast Exposure %]
			VAR _Score = _Firmness * 0.4 + _Coverage * 0.3 + ( 100 - _FctExp ) * 0.3
			RETURN
			    IF( NOT ISBLANK( _Firmness ), MIN( ROUND( _Score, 0 ), 100 ), BLANK() )
		formatString: 0
		displayFolder: Resource
		lineageTag: b284289b-f162-4f49-9c52-7328551f8797

	/// Subject area: Resource.
	measure 'Resource | Utilization Band' =
			VAR _Util = [Resource | Utilization]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( _Util ),  "N/A",
			        _Util >= 120,      "Critical (120%+)",
			        _Util >= 100,      "Over-allocated (100-120%)",
			        _Util >= 80,       "Optimal (80-100%)",
			        _Util >= 50,       "Under-utilized (50-80%)",
			                           "Low (<50%)"
			    )
		displayFolder: Resource
		lineageTag: 9b199c52-b0f1-4fe9-9bec-65fdd719658f

	/// Source: Resources[Quantity].
	measure 'Resource | Headcount' = SUM( DimResource[Quantity] )
