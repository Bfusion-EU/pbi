	/// Source: Plan_Projects[PlansEstimatedCost].
	measure 'Project | Total PlansEstimatedCost' = SUM(DimProject[PlansEstimatedCost])
		formatString: #,##0.00
		displayFolder: Project
		lineageTag: 91c4caab-887b-4776-ac71-a44ac93850a4

		changedProperty = IsHidden

	/// Subject area: Resource KPI.
	measure 'Resource KPI | Task KPI HTML' =
			
			VAR _Tasks = [Task | Task Count]
			VAR _InProgress = [Task | In Progress]
			VAR _Late = [Task | Active Late Tasks]
			VAR _Overdue = [Task | Overdue Tasks]
			VAR _OffTrack = [Task | Off Track Tasks]
			VAR _Effort = [Task | Scheduled Effort]
			VAR _OnTrack = _Tasks - _InProgress - _Late - _Overdue - _OffTrack
			VAR _NeedAttention = _Late + _Overdue + _OffTrack
			VAR _PctInProgress = ROUND(DIVIDE(_InProgress, _Tasks, 0) * 100, 2)
			VAR _PctLate = ROUND(DIVIDE(_Late, _Tasks, 0) * 100, 2)
			VAR _PctOverdue = ROUND(DIVIDE(_Overdue, _Tasks, 0) * 100, 2)
			VAR _PctOffTrack = ROUND(DIVIDE(_OffTrack, _Tasks, 0) * 100, 2)
			VAR _PctOnTrack = ROUND(DIVIDE(_OnTrack, _Tasks, 0) * 100, 2)
			VAR _PctAttention = ROUND(DIVIDE(_NeedAttention, _Tasks, 0) * 100, 2)
			VAR _AvgEffort = ROUND(DIVIDE(_Effort, _Tasks, 0), 2)
			VAR _EffortFmt = FORMAT(_Effort, "#,##0.00")
			VAR _AvgFmt = FORMAT(_AvgEffort, "#,##0.00")
			VAR _RingIP = ROUND(_PctInProgress / 100 * 113.1, 2)
			VAR _RingEff = ROUND(DIVIDE(_Effort, _Effort * 1.2, 0) * 113.1, 2)
			VAR _HealthColor =
			    SWITCH(TRUE(),
			        _PctAttention >= 40, "#dc2626",
			        _PctAttention >= 20, "#d97706",
			        "#059669"
			    )
			VAR _BarOnTrack = FORMAT(_PctOnTrack, "0.00")
			VAR _BarIP = FORMAT(_PctInProgress, "0.00")
			VAR _BarLate = FORMAT(_PctLate, "0.00")
			VAR _BarOverdue = FORMAT(_PctOverdue, "0.00")
			VAR _BarOffTrack = FORMAT(_PctOffTrack, "0.00")
			
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;padding:8px;'>
			
			<!-- ROW 1: 4 columns — Task Count | In Progress | Scheduled Effort | Health Bar -->
			<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1.4fr;gap:10px;margin-bottom:10px;'>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #185FA5;position:relative;'>
			    <div style='font-size:12px;color:#6b7280;'>Task count</div>
			    <div style='font-size:26px;font-weight:600;color:#185FA5;'>" & FORMAT(_Tasks, "#,##0") & "</div>
			    <div style='font-size:11px;color:#6b7280;'>Across all projects</div>
			    <svg style='position:absolute;top:10px;right:12px;' width='40' height='40' viewBox='0 0 44 44'>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#E6F1FB' stroke-width='4'/>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#378ADD' stroke-width='4' stroke-dasharray='" & _RingIP & " 113.1' stroke-linecap='round' transform='rotate(-90 22 22)'/>
			      <text x='22' y='24' text-anchor='middle' font-size='10' font-weight='600' fill='#0C447C'>" & FORMAT(_PctInProgress, "0") & "%</text>
			    </svg>
			  </div>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #059669;'>
			    <div style='font-size:12px;color:#6b7280;'>In progress</div>
			    <div style='font-size:26px;font-weight:600;color:#059669;'>" & FORMAT(_InProgress, "#,##0") & "</div>
			    <div style='font-size:11px;color:#6b7280;'>" & FORMAT(_PctInProgress, "0.00") & "% of total</div>
			  </div>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #854F0B;position:relative;'>
			    <div style='font-size:12px;color:#6b7280;'>Scheduled effort</div>
			    <div style='font-size:26px;font-weight:600;color:#854F0B;'>" & _EffortFmt & "<span style='font-size:11px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:11px;color:#6b7280;'>Avg " & _AvgFmt & " hrs/task</div>
			    <svg style='position:absolute;top:10px;right:12px;' width='40' height='40' viewBox='0 0 44 44'>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#FAEEDA' stroke-width='4'/>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#EF9F27' stroke-width='4' stroke-dasharray='" & _RingEff & " 113.1' stroke-linecap='round' transform='rotate(-90 22 22)'/>
			    </svg>
			  </div>
			
			  <!-- HEALTH BAR in row 1 -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #6b7280;display:flex;flex-direction:column;justify-content:space-between;'>
			    <div>
			      <div style='font-size:12px;color:#6b7280;font-weight:600;'>Task health</div>
			      <div style='font-size:11px;color:#6b7280;margin-bottom:6px;'>" & FORMAT(_Tasks, "#,##0") & " tasks &bull; " & FORMAT(_PctAttention, "0.00") & "% need attention</div>
			      <div style='width:100%;height:10px;background:#f1f3f5;border-radius:5px;overflow:hidden;display:flex;'>
			        <div style='width:" & _BarOnTrack & "%;background:#059669;'></div>
			        <div style='width:" & _BarIP & "%;background:#0891b2;'></div>
			        <div style='width:" & _BarLate & "%;background:#d97706;'></div>
			        <div style='width:" & _BarOverdue & "%;background:#ea580c;'></div>
			        <div style='width:" & _BarOffTrack & "%;background:#dc2626;'></div>
			      </div>
			    </div>
			    <div style='display:flex;gap:8px;margin-top:6px;flex-wrap:wrap;'>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#059669;display:inline-block;'></span>" & FORMAT(_OnTrack, "#,##0") & "</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#0891b2;display:inline-block;'></span>" & FORMAT(_InProgress, "#,##0") & "</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#d97706;display:inline-block;'></span>" & FORMAT(_Late, "#,##0") & "</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#ea580c;display:inline-block;'></span>" & FORMAT(_Overdue, "#,##0") & "</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#dc2626;display:inline-block;'></span>" & FORMAT(_OffTrack, "#,##0") & "</span>
			    </div>
			  </div>
			
			</div>
			
			<!-- ROW 2: 4 columns — Active Late | Overdue | Off Track | Insight -->
			<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1.4fr;gap:10px;'>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #A32D2D;'>
			    <div style='font-size:12px;color:#6b7280;'>Active late tasks</div>
			    <div style='font-size:26px;font-weight:600;color:#A32D2D;'>" & FORMAT(_Late, "#,##0") & "</div>
			    <div style='font-size:11px;color:#6b7280;'>" & FORMAT(_PctLate, "0.00") & "% &bull; In progress past due</div>
			  </div>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #993C1D;'>
			    <div style='font-size:12px;color:#6b7280;'>Overdue tasks</div>
			    <div style='font-size:26px;font-weight:600;color:#993C1D;'>" & FORMAT(_Overdue, "#,##0") & "</div>
			    <div style='font-size:11px;color:#6b7280;'>" & FORMAT(_PctOverdue, "0.00") & "% &bull; Past due &amp; incomplete</div>
			  </div>
			
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid #791F1F;'>
			    <div style='font-size:12px;color:#6b7280;'>Off track tasks</div>
			    <div style='font-size:26px;font-weight:600;color:#791F1F;'>" & FORMAT(_OffTrack, "#,##0") & "</div>
			    <div style='font-size:11px;color:#6b7280;'>" & FORMAT(_PctOffTrack, "0.00") & "% &bull; Status: Off Track</div>
			  </div>
			
			  <!-- INSIGHT in row 2 -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;border-top:3px solid " & _HealthColor & ";display:flex;flex-direction:column;justify-content:center;'>
			    <div style='display:flex;align-items:center;gap:8px;padding:8px 10px;background:" & IF(_PctAttention >= 40, "#FCEBEB", IF(_PctAttention >= 20, "#FAEEDA", "#E1F5EE")) & ";border-radius:8px;'>
			      <div style='font-size:22px;color:" & _HealthColor & ";'>" & IF(_PctAttention >= 40, "&#9888;", IF(_PctAttention >= 20, "&#9888;", "&#10003;")) & "</div>
			      <div>
			        <div style='font-size:12px;font-weight:600;color:" & _HealthColor & ";'>" & FORMAT(_PctAttention, "0.00") & "% need attention</div>
			        <div style='font-size:10px;color:#6b7280;'>" & FORMAT(_NeedAttention, "#,##0") & " of " & FORMAT(_Tasks, "#,##0") & " tasks are late, overdue, or off track</div>
			      </div>
			    </div>
			  </div>
			
			</div>
			</div>"
		displayFolder: Resource KPI
		lineageTag: 7d731e2b-7369-4cc7-866b-cb60d57f7344

		changedProperty = IsHidden

	/// Subject area: Capacity.
	measure 'Capacity | Allocation % (Forecast)' =
			
			DIVIDE(
			    [Capacity | Total Hours Forecast],
			    [Capacity | Resource Capacity],
			    0
			)
		displayFolder: Capacity
		lineageTag: b23c679f-8b8e-41ca-99f1-491ca0dd639e

		changedProperty = IsHidden

	/// Source: Capacity[Capacity].
	measure 'Resource KPI | Resource KPI HTML' = ```
			// ============================================================================
			// MEASURE: Resource KPI HTML
			// TABLE:   _Measures
			// FOLDER:  Metrics
			// VISUAL:  HTML Content (Power BI custom visual)
			// ============================================================================
			// DEPENDENCIES (existing measures):
			//   [Capacity | Resource Capacity]               = SUM(FactCapacity[Capacity])
			//   [Capacity | Total Hours Committed]  = CALCULATE([Capacity | Demand], FactResourcePlan[CostType]="Scheduled")
			//   [Capacity | Total Hours Forecast]   = CALCULATE([Capacity | Demand], FactResourcePlan[CostType]="Forecast")
			//   [Capacity | Resource Utilization%]                     = DIVIDE([Capacity | Total Hours Committed],[Capacity | Resource Capacity],0)
			//   [Capacity | Allocation % (Forecast)]          = DIVIDE([Capacity | Total Hours Forecast],[Capacity | Resource Capacity],0)
			//   [Capacity | Availability]                     = SUM(FactCapacity[Capacity])-SUM(FactResourcePlan[Hours])
			//   [Availability %]                   = DIVIDE([Capacity | Availability],[Capacity | Resource Capacity],0)
			//   [Capacity | Netto Capacity]                   = [Capacity | Resource Capacity]-[Capacity | Total Hours Committed]-[Resource | TimeOff Hours]
			//   [Resources - Total FTE]            = SUM(FactCapacity[Capacity])/1720
			//   [Resource | TimeOff Hours]                    = SUM(FactTimeOff[HoursPerDay])
			// ============================================================================
			// FIX v2: Overallocation, under-utilization and bucket distribution now
			//         evaluated at MONTHLY grain (max alloc per resource across months)
			//         to align with the Deneb heatmap cell-level view.
			// ============================================================================
			
			
			
			// ─── Core Aggregates ───
			VAR _Cap         = [Capacity | Resource Capacity]
			VAR _CapDays     = DIVIDE(_Cap, 8, 0)
			VAR _Committed   = [Capacity | Total Hours Committed]
			VAR _CommDays    = DIVIDE(_Committed, 8, 0)
			VAR _Forecast    = [Capacity | Total Hours Forecast]
			VAR _FcstDays    = DIVIDE(_Forecast, 8, 0)
			VAR _TimeOff     = [Resource | TimeOff Hours]
			VAR _TimeOffDays = DIVIDE(_TimeOff, 8, 0)
			VAR _Avail       = [Capacity | Availability]
			VAR _AvailDays   = DIVIDE(_Avail, 8, 0)
			VAR _Netto       = [Capacity | Netto Capacity]
			VAR _NettoDays   = DIVIDE(_Netto, 8, 0)
			VAR _FTE         = [Resource | Capacity FTE]
			
			// ─── Allocation & Availability Rates (aggregate) ───
			VAR _AllocPct    = [Capacity | Resource Utilization%]
			VAR _AllocFcst   = [Capacity | Allocation % (Forecast)]
			VAR _AvailPct    = [Capacity | Availability %]
			VAR _NettoPct    = DIVIDE(_Netto, _Cap, 0)
			
			// ─── Resource Counts ───
			VAR _TotalRes    = CALCULATE(
			                       DISTINCTCOUNT(DimResource[UserId]),
			                       DimResource[Inactive] = FALSE()
			                   )
			VAR _AllocatedRes = CALCULATE(
			                        DISTINCTCOUNT(FactResourcePlan[ResourceId]),
			                        FactResourcePlan[CostType] = "Scheduled"
			                    )
			VAR _UnallocRes  = _TotalRes - _AllocatedRes
			
			// ─── Monthly-Grain Peak Allocation Per Resource ───
			// Single shared table: for each active resource compute the MAX monthly
			// allocation across all periods in the current filter context.
			// This matches the Deneb heatmap cell-level evaluation exactly.
			VAR _ResAllocTable =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(DimResource[UserId]),
			            CALCULATE(COUNTROWS(FactCapacity)) > 0
			        ),
			        "@MaxAlloc",
			            CALCULATE(
			                MAXX(
			                    SUMMARIZE(DimDate, DimDate[Period]),
			                    CALCULATE([Capacity | Resource Utilization%])
			                )
			            ),
			        "@MaxAllocFcst",
			            CALCULATE(
			                MAXX(
			                    SUMMARIZE(DimDate, DimDate[Period]),
			                    CALCULATE([Capacity | Allocation % (Forecast)])
			                )
			            ),
			        "@HasAnyAlloc",
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        SUMMARIZE(DimDate, DimDate[Period]),
			                        CALCULATE([Capacity | Resource Utilization%]) > 0
			                    )
			                )
			            )
			    )
			
			// ─── Overallocation: any month >100% ───
			VAR _OverallocRes = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 1))
			VAR _OverallocPct = DIVIDE(_OverallocRes, _TotalRes, 0)
			
			// ─── Under-utilized: has allocation but peak never reaches 25% ───
			VAR _UnderutilRes = COUNTROWS(
			                        FILTER(
			                            _ResAllocTable,
			                            [@HasAnyAlloc] > 0 && [@MaxAlloc] < 0.25
			                        )
			                    )
			
			// ─── Allocation Bucket Distribution (based on peak monthly allocation) ───
			VAR _Bkt0    = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] = 0))
			VAR _Bkt25   = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 0 && [@MaxAlloc] < 0.25))
			VAR _Bkt50   = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] >= 0.25 && [@MaxAlloc] < 0.50))
			VAR _Bkt75   = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] >= 0.50 && [@MaxAlloc] < 0.75))
			VAR _Bkt100  = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] >= 0.75 && [@MaxAlloc] <= 1))
			VAR _BktOver = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 1))
			
			// ─── Bar widths (% of total resources) ───
			VAR _B0w   = FORMAT(DIVIDE(_Bkt0,   _TotalRes, 0) * 100, "0.0")
			VAR _B25w  = FORMAT(DIVIDE(_Bkt25,  _TotalRes, 0) * 100, "0.0")
			VAR _B50w  = FORMAT(DIVIDE(_Bkt50,  _TotalRes, 0) * 100, "0.0")
			VAR _B75w  = FORMAT(DIVIDE(_Bkt75,  _TotalRes, 0) * 100, "0.0")
			VAR _B100w = FORMAT(DIVIDE(_Bkt100, _TotalRes, 0) * 100, "0.0")
			VAR _BOverw= FORMAT(DIVIDE(_BktOver,_TotalRes, 0) * 100, "0.0")
			
			// ─── Demand vs FactCapacity Rings ───
			VAR _DemandPct   = DIVIDE(_Committed, _Cap, 0)
			VAR _RingDemand  = ROUND(MIN(_DemandPct, 1) * 113.1, 2)
			VAR _RingFcst    = ROUND(MIN(_AllocFcst, 1) * 113.1, 2)
			
			// ─── Health color logic ───
			VAR _HealthColor = SWITCH(TRUE(),
			                       _OverallocPct >= 0.3, "#dc2626",
			                       _OverallocPct >= 0.1, "#d97706",
			                       "#059669"
			                   )
			
			// ─── Formatted values ───
			VAR _fCap       = FORMAT(_Cap, "#,##0")
			VAR _fCapD      = FORMAT(_CapDays, "#,##0")
			VAR _fComm      = FORMAT(_Committed, "#,##0")
			VAR _fCommD     = FORMAT(_CommDays, "#,##0")
			VAR _fFcst      = FORMAT(_Forecast, "#,##0")
			VAR _fFcstD     = FORMAT(_FcstDays, "#,##0")
			VAR _fTimeOff   = FORMAT(_TimeOff, "#,##0")
			VAR _fTimeOffD  = FORMAT(_TimeOffDays, "#,##0")
			VAR _fAvail     = FORMAT(_Avail, "#,##0")
			VAR _fAvailD    = FORMAT(_AvailDays, "#,##0")
			VAR _fNetto     = FORMAT(_Netto, "#,##0")
			VAR _fNettoD    = FORMAT(_NettoDays, "#,##0")
			VAR _fFTE       = FORMAT(_FTE, "#,##0.0")
			VAR _fAllocPct  = FORMAT(_AllocPct * 100, "0.0")
			VAR _fAllocFcst = FORMAT(_AllocFcst * 100, "0.0")
			VAR _fAvailPct  = FORMAT(_AvailPct * 100, "0.0")
			VAR _fNettoPct  = FORMAT(_NettoPct * 100, "0.0")
			VAR _fOverPct   = FORMAT(_OverallocPct * 100, "0.0")
			
			// ─── Insight text: top overallocated resource ───
			VAR _TopOveralloc =
			    TOPN(
			        1,
			        FILTER(_ResAllocTable, [@MaxAlloc] > 1),
			        [@MaxAlloc], DESC
			    )
			VAR _TopOverName =
			    MAXX(
			        _TopOveralloc,
			        CALCULATE(SELECTEDVALUE(DimResource[Name]))
			    )
			VAR _TopOverPeak =
			    FORMAT(MAXX(_TopOveralloc, [@MaxAlloc]) * 100, "0")
			
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;padding:8px;'>
			
			<!-- ═══════════ ROW 1: Capacity | Committed | Forecast | FTE ═══════════ -->
			<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:8px;'>
			
			  <!-- Total Capacity -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #185FA5;position:relative;'>
			    <div style='font-size:11px;color:#6b7280;'>Total Capacity</div>
			    <div style='font-size:24px;font-weight:600;color:#185FA5;'>" & _fCap & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fCapD & " days</div>
			    <svg style='position:absolute;top:8px;right:10px;' width='36' height='36' viewBox='0 0 44 44'>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#E6F1FB' stroke-width='4'/>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#378ADD' stroke-width='4' stroke-dasharray='" & _RingDemand & " 113.1' stroke-linecap='round' transform='rotate(-90 22 22)'/>
			      <text x='22' y='24' text-anchor='middle' font-size='9' font-weight='600' fill='#0C447C'>" & _fAllocPct & "%</text>
			    </svg>
			  </div>
			
			  <!-- Committed Demand -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #854F0B;'>
			    <div style='font-size:11px;color:#6b7280;'>Committed Demand</div>
			    <div style='font-size:24px;font-weight:600;color:#854F0B;'>" & _fComm & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fCommD & " days &bull; " & _fAllocPct & "% allocated</div>
			  </div>
			
			  <!-- Forecast Demand -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #7C3AED;position:relative;'>
			    <div style='font-size:11px;color:#6b7280;'>Forecast Demand</div>
			    <div style='font-size:24px;font-weight:600;color:#7C3AED;'>" & _fFcst & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fFcstD & " days &bull; " & _fAllocFcst & "% of cap</div>
			    <svg style='position:absolute;top:8px;right:10px;' width='36' height='36' viewBox='0 0 44 44'>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#EDE9FE' stroke-width='4'/>
			      <circle cx='22' cy='22' r='18' fill='none' stroke='#8B5CF6' stroke-width='4' stroke-dasharray='" & _RingFcst & " 113.1' stroke-linecap='round' transform='rotate(-90 22 22)'/>
			      <text x='22' y='24' text-anchor='middle' font-size='9' font-weight='600' fill='#5B21B6'>" & _fAllocFcst & "%</text>
			    </svg>
			  </div>
			
			  <!-- FTE -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #0891b2;'>
			    <div style='font-size:11px;color:#6b7280;'>FTE Equivalent</div>
			    <div style='font-size:24px;font-weight:600;color:#0891b2;'>" & _fFTE & "</div>
			    <div style='font-size:10px;color:#6b7280;'>" & FORMAT(_TotalRes, "#,##0") & " active resources</div>
			  </div>
			
			</div>
			
			<!-- ═══════════ ROW 2: Availability | Netto Capacity | Time Off | Overallocation ═══════════ -->
			<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:8px;'>
			
			  <!-- Availability -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #059669;'>
			    <div style='font-size:11px;color:#6b7280;'>Availability</div>
			    <div style='font-size:24px;font-weight:600;color:#059669;'>" & _fAvail & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fAvailD & " days &bull; " & _fAvailPct & "% available</div>
			  </div>
			
			  <!-- Netto Capacity -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #047857;'>
			    <div style='font-size:11px;color:#6b7280;'>Netto Capacity</div>
			    <div style='font-size:24px;font-weight:600;color:#047857;'>" & _fNetto & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fNettoD & " days &bull; " & _fNettoPct & "% of gross</div>
			  </div>
			
			  <!-- Time Off -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #6366f1;'>
			    <div style='font-size:11px;color:#6b7280;'>Time Off</div>
			    <div style='font-size:24px;font-weight:600;color:#6366f1;'>" & _fTimeOff & "<span style='font-size:10px;color:#6b7280;'> hrs</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fTimeOffD & " days booked</div>
			  </div>
			
			  <!-- Overallocated -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #dc2626;'>
			    <div style='font-size:11px;color:#6b7280;'>Overallocated</div>
			    <div style='font-size:24px;font-weight:600;color:#dc2626;'>" & FORMAT(_OverallocRes, "#,##0") & "<span style='font-size:10px;color:#6b7280;'> resources</span></div>
			    <div style='font-size:10px;color:#6b7280;'>" & _fOverPct & "% of pool &gt;100% in any month</div>
			  </div>
			
			</div>
			
			<!-- ═══════════ ROW 3: Allocation Distribution Bar | Insight ═══════════ -->
			<div style='display:grid;grid-template-columns:1.6fr 1fr;gap:8px;'>
			
			  <!-- Allocation Distribution -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid #6b7280;'>
			    <div style='font-size:11px;color:#6b7280;font-weight:600;margin-bottom:4px;'>Allocation Distribution (peak monthly)</div>
			    <div style='font-size:10px;color:#6b7280;margin-bottom:6px;'>" & FORMAT(_TotalRes, "#,##0") & " resources &bull; bucketed by highest monthly allocation</div>
			    <div style='width:100%;height:14px;background:#f1f3f5;border-radius:7px;overflow:hidden;display:flex;'>
			      <div style='width:" & _B0w & "%;background:#d1d5db;' title='0%: " & FORMAT(_Bkt0,"#,##0") & "'></div>
			      <div style='width:" & _B25w & "%;background:#fbbf24;' title='<25%: " & FORMAT(_Bkt25,"#,##0") & "'></div>
			      <div style='width:" & _B50w & "%;background:#f59e0b;' title='25-50%: " & FORMAT(_Bkt50,"#,##0") & "'></div>
			      <div style='width:" & _B75w & "%;background:#fb923c;' title='50-75%: " & FORMAT(_Bkt75,"#,##0") & "'></div>
			      <div style='width:" & _B100w & "%;background:#22c55e;' title='75-100%: " & FORMAT(_Bkt100,"#,##0") & "'></div>
			      <div style='width:" & _BOverw & "%;background:#ef4444;' title='>100%: " & FORMAT(_BktOver,"#,##0") & "'></div>
			    </div>
			    <div style='display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;'>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#d1d5db;display:inline-block;'></span>0% (" & FORMAT(_Bkt0,"#,##0") & ")</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#fbbf24;display:inline-block;'></span>&lt;25% (" & FORMAT(_Bkt25,"#,##0") & ")</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#f59e0b;display:inline-block;'></span>25-50% (" & FORMAT(_Bkt50,"#,##0") & ")</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#fb923c;display:inline-block;'></span>50-75% (" & FORMAT(_Bkt75,"#,##0") & ")</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#22c55e;display:inline-block;'></span>75-100% (" & FORMAT(_Bkt100,"#,##0") & ")</span>
			      <span style='font-size:9px;color:#6b7280;display:flex;align-items:center;gap:2px;'><span style='width:6px;height:6px;border-radius:2px;background:#ef4444;display:inline-block;'></span>&gt;100% (" & FORMAT(_BktOver,"#,##0") & ")</span>
			    </div>
			  </div>
			
			  <!-- Insight Panel -->
			  <div style='background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:10px 12px;border-top:3px solid " & _HealthColor & ";display:flex;flex-direction:column;justify-content:center;gap:6px;'>
			
			    <!-- Overallocation insight -->
			    <div style='display:flex;align-items:center;gap:6px;padding:6px 8px;background:" & IF(_OverallocPct >= 0.3, "#FCEBEB", IF(_OverallocPct >= 0.1, "#FAEEDA", "#E1F5EE")) & ";border-radius:8px;'>
			      <div style='font-size:20px;color:" & _HealthColor & ";'>" & IF(_OverallocPct >= 0.3, "&#9888;", IF(_OverallocPct >= 0.1, "&#9888;", "&#10003;")) & "</div>
			      <div>
			        <div style='font-size:11px;font-weight:600;color:" & _HealthColor & ";'>" & IF(_OverallocPct >= 0.3, "Critical: ", IF(_OverallocPct >= 0.1, "Warning: ", "Healthy: ")) & FORMAT(_OverallocRes, "#,##0") & " overallocated (" & _fOverPct & "%)</div>
			        <div style='font-size:9px;color:#6b7280;'>" & IF(_OverallocRes > 0, "Peak: " & _TopOverName & " at " & _TopOverPeak & "% in a single month", "No resource exceeds 100% in any month") & "</div>
			      </div>
			    </div>
			
			    <!-- Unallocated / under-utilized insight -->
			    <div style='display:flex;align-items:center;gap:6px;padding:6px 8px;background:" & IF(_UnallocRes > 0, "#FEF3C7", "#E1F5EE") & ";border-radius:8px;'>
			      <div style='font-size:20px;color:" & IF(_UnallocRes > 0, "#d97706", "#059669") & ";'>" & IF(_UnallocRes > 0, "&#9679;", "&#10003;") & "</div>
			      <div>
			        <div style='font-size:11px;font-weight:600;color:" & IF(_UnallocRes > 0, "#d97706", "#059669") & ";'>" & FORMAT(_UnallocRes, "#,##0") & " unallocated resources</div>
			        <div style='font-size:9px;color:#6b7280;'>" & FORMAT(_UnderutilRes, "#,##0") & " under-utilized (peak &lt;25% across all months)</div>
			      </div>
			    </div>
			
			  </div>
			
			</div>
			</div>"
			
			```
		displayFolder: Resource KPI
		lineageTag: 806b4d59-e0fb-45e0-a540-b8b58e21e8f5

		changedProperty = IsHidden

	/// Source: Resources[UserId].
	measure 'Resource KPI | Resource KPI Narrative HTML' = ```
			// ============================================================================
			// MEASURE: Resource KPI Narrative HTML
			// TABLE:   _Measures
			// FOLDER:  Metrics
			// VISUAL:  HTML Content (Power BI custom visual)
			// ============================================================================
			// PURPOSE: Generates dynamic narratives, insights, advice and recommended
			//          actions based on resource capacity & allocation KPIs.
			//          Reacts to current filter context (Year, Resource, Role slicers).
			// ============================================================================
			// DEPENDENCIES (existing measures):
			//   [Capacity | Resource Capacity], [Capacity | Total Hours Committed],
			//   [Capacity | Total Hours Forecast], [Capacity | Resource Utilization%],
			//   [Capacity | Allocation % (Forecast)], [Capacity | Availability], [Availability %],
			//   [Capacity | Netto Capacity], [Resources - Total FTE], [Resource | TimeOff Hours]
			// ============================================================================
			
			
			
			// ─── Core Metrics ───
			VAR _Cap         = [Capacity | Resource Capacity]
			VAR _Committed   = [Capacity | Total Hours Committed]
			VAR _Forecast    = [Capacity | Total Hours Forecast]
			VAR _TimeOff     = [Resource | TimeOff Hours]
			VAR _Avail       = [Capacity | Availability]
			VAR _Netto       = [Capacity | Netto Capacity]
			VAR _AllocPct    = [Capacity | Resource Utilization%]
			VAR _AllocFcst   = [Capacity | Allocation % (Forecast)]
			VAR _AvailPct    = [Capacity | Availability %]
			VAR _NettoPct    = DIVIDE(_Netto, _Cap, 0)
			
			// ─── Resource Counts ───
			VAR _TotalRes = CALCULATE(
			                    DISTINCTCOUNT(DimResource[UserId]),
			                    DimResource[Inactive] = FALSE()
			                )
			VAR _AllocatedRes = CALCULATE(
			                        DISTINCTCOUNT(FactResourcePlan[ResourceId]),
			                        FactResourcePlan[CostType] = "Scheduled"
			                    )
			VAR _UnallocRes = _TotalRes - _AllocatedRes
			
			// ─── Monthly-Grain Peak Allocation Table ───
			VAR _ResAllocTable =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES(DimResource[UserId]),
			            CALCULATE(COUNTROWS(FactCapacity)) > 0
			        ),
			        "@MaxAlloc",
			            CALCULATE(
			                MAXX(
			                    SUMMARIZE(DimDate, DimDate[Period]),
			                    CALCULATE([Capacity | Resource Utilization%])
			                )
			            ),
			        "@AvgAlloc",
			            CALCULATE(
			                AVERAGEX(
			                    FILTER(
			                        SUMMARIZE(DimDate, DimDate[Period]),
			                        CALCULATE([Capacity | Resource Utilization%]) > 0
			                    ),
			                    CALCULATE([Capacity | Resource Utilization%])
			                )
			            ),
			        "@MonthsOver100",
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        SUMMARIZE(DimDate, DimDate[Period]),
			                        CALCULATE([Capacity | Resource Utilization%]) > 1
			                    )
			                )
			            ),
			        "@HasAnyAlloc",
			            CALCULATE(
			                COUNTROWS(
			                    FILTER(
			                        SUMMARIZE(DimDate, DimDate[Period]),
			                        CALCULATE([Capacity | Resource Utilization%]) > 0
			                    )
			                )
			            ),
			        "@ResName", CALCULATE(SELECTEDVALUE(DimResource[Name])),
			        "@ResRole", CALCULATE(SELECTEDVALUE(DimResource[Role_Value]))
			    )
			
			// ─── Derived Counts ───
			VAR _OverallocRes   = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 1))
			VAR _OverallocPct   = DIVIDE(_OverallocRes, _TotalRes, 0)
			VAR _SevereOverRes  = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] > 1.5))
			VAR _UnderutilRes   = COUNTROWS(FILTER(_ResAllocTable, [@HasAnyAlloc] > 0 && [@MaxAlloc] < 0.25))
			VAR _IdleRes        = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] = 0))
			VAR _OptimalRes     = COUNTROWS(FILTER(_ResAllocTable, [@MaxAlloc] >= 0.75 && [@MaxAlloc] <= 1))
			VAR _OptimalPct     = DIVIDE(_OptimalRes, _TotalRes, 0)
			VAR _ChronicOver    = COUNTROWS(FILTER(_ResAllocTable, [@MonthsOver100] >= 3))
			
			// ─── Top Offenders (up to 3) ───
			VAR _Top3Over =
			    TOPN(3, FILTER(_ResAllocTable, [@MaxAlloc] > 1), [@MaxAlloc], DESC)
			VAR _Top1Name  = MAXX(TOPN(1, _Top3Over, [@MaxAlloc], DESC), [@ResName])
			VAR _Top1Peak  = FORMAT(MAXX(TOPN(1, _Top3Over, [@MaxAlloc], DESC), [@MaxAlloc]) * 100, "0")
			VAR _Top1Months= MAXX(TOPN(1, _Top3Over, [@MaxAlloc], DESC), [@MonthsOver100])
			VAR _Top2Name  = MINX(TOPN(2, _Top3Over, [@MaxAlloc], DESC), [@ResName])
			VAR _Top2Peak  = FORMAT(MINX(TOPN(2, _Top3Over, [@MaxAlloc], DESC), [@MaxAlloc]) * 100, "0")
			VAR _Top3Name  = MINX(_Top3Over, [@ResName])
			VAR _Top3Peak  = FORMAT(MINX(_Top3Over, [@MaxAlloc]) * 100, "0")
			
			// ─── Top Idle (most capacity wasted) ───
			VAR _TopIdle =
			    TOPN(3, FILTER(_ResAllocTable, [@MaxAlloc] = 0), [@HasAnyAlloc], ASC)
			VAR _TopIdleName = MAXX(_TopIdle, [@ResName])
			
			// ─── Demand Gap Analysis ───
			VAR _DemandGapHrs    = _Cap - _Committed
			VAR _DemandGapDays   = DIVIDE(_DemandGapHrs, 8, 0)
			VAR _FcstVsCommitted = _Forecast - _Committed
			VAR _FcstGapPct      = DIVIDE(_FcstVsCommitted, _Committed, 0)
			
			// ─── Efficiency Score (0-100) ───
			// Composite: 40% optimal band ratio + 30% inverse overalloc + 30% inverse idle
			VAR _EffScore = ROUND(
			                    _OptimalPct * 40
			                    + (1 - MIN(_OverallocPct, 1)) * 30
			                    + (1 - DIVIDE(_IdleRes, _TotalRes, 0)) * 30,
			                    0
			                )
			VAR _EffColor = SWITCH(TRUE(),
			                    _EffScore >= 70, "#059669",
			                    _EffScore >= 40, "#d97706",
			                    "#dc2626"
			                )
			VAR _EffLabel = SWITCH(TRUE(),
			                    _EffScore >= 70, "Well Balanced",
			                    _EffScore >= 40, "Needs Attention",
			                    "Critical Imbalance"
			                )
			
			// ─── Severity Levels for Conditional Sections ───
			VAR _HasOveralloc    = _OverallocRes > 0
			VAR _HasSevere       = _SevereOverRes > 0
			VAR _HasChronic      = _ChronicOver > 0
			VAR _HasIdle         = _IdleRes > 5
			VAR _HasUnderutilized= _UnderutilRes > 0
			VAR _HasUnallocated  = _UnallocRes > 0
			VAR _HasFcstGap      = ABS(_FcstGapPct) > 0.2
			VAR _LowNetto        = _NettoPct < 0.3
			VAR _HighTimeOff     = DIVIDE(_TimeOff, _Cap, 0) > 0.05
			
			// ─── HTML GENERATION ───
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;padding:8px;'>
			
			<!-- ═══════ HEADER: Efficiency Score ═══════ -->
			<div style='display:flex;align-items:center;gap:12px;margin-bottom:10px;padding:10px 14px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-radius:10px;border-left:4px solid " & _EffColor & ";'>
			  <div style='min-width:48px;height:48px;border-radius:50%;background:" & _EffColor & ";display:flex;align-items:center;justify-content:center;'>
			    <span style='font-size:18px;font-weight:700;color:#fff;'>" & FORMAT(_EffScore, "0") & "</span>
			  </div>
			  <div>
			    <div style='font-size:13px;font-weight:700;color:#111827;'>Resource Efficiency: " & _EffLabel & "</div>
			    <div style='font-size:11px;color:#6b7280;'>" & FORMAT(_TotalRes,"#,##0") & " resources &bull; " & FORMAT(_OptimalRes,"#,##0") & " in optimal band (75-100%) &bull; " & FORMAT(_AllocPct*100,"0.0") & "% aggregate allocation</div>
			  </div>
			</div>
			
			<!-- ═══════ SECTION 1: Executive Summary ═══════ -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:6px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#128202;</span> Executive Summary
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			    // ─── Opening narrative ───
			    & "The resource pool of <b>" & FORMAT(_TotalRes,"#,##0") & "</b> active resources holds <b>" & FORMAT(_Cap,"#,##0") & " hours</b> of total capacity. "
			    & "Committed demand consumes <b>" & FORMAT(_AllocPct*100,"0.0") & "%</b> of this capacity (" & FORMAT(_Committed,"#,##0") & " hrs), "
			    & "leaving <b>" & FORMAT(_Avail,"#,##0") & " hours</b> of gross availability. "
			
			    // ─── Netto narrative ───
			    & "After deducting committed hours and <b>" & FORMAT(_TimeOff,"#,##0") & " hours</b> of time-off, "
			    & "net effective capacity is <b>" & FORMAT(_Netto,"#,##0") & " hours</b> (" & FORMAT(_NettoPct*100,"0.0") & "% of gross). "
			
			    // ─── Forecast gap ───
			    & IF(_Forecast > 0,
			        "Forecast demand stands at <b>" & FORMAT(_Forecast,"#,##0") & " hours</b> (" & FORMAT(_AllocFcst*100,"0.0") & "% of capacity)"
			        & IF(_FcstVsCommitted > 0,
			            ", which is <b>" & FORMAT(_FcstVsCommitted,"#,##0") & " hours above</b> committed — indicating upcoming demand pressure. ",
			            IF(_FcstVsCommitted < 0,
			                ", which is <b>" & FORMAT(ABS(_FcstVsCommitted),"#,##0") & " hours below</b> committed — suggesting demand may ease. ",
			                ". "
			            )
			        ),
			        ""
			    )
			
			& "  </div>
			</div>
			
			<!-- ═══════ SECTION 2: Alerts ═══════ -->"
			
			    // ─── Overallocation Alert ───
			    & IF(_HasOveralloc,
			"
			<div style='padding:8px 12px;margin-bottom:8px;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#991B1B;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9888;</span> Overallocation Alert
			  </div>
			  <div style='font-size:11px;color:#7F1D1D;line-height:1.6;'>"
			        & "<b>" & FORMAT(_OverallocRes,"#,##0") & " resource" & IF(_OverallocRes>1,"s","") & "</b> exceed" & IF(_OverallocRes=1,"s","") & " 100% allocation in at least one month. "
			        & IF(_HasSevere,
			            "<b>" & FORMAT(_SevereOverRes,"#,##0") & "</b> of these are in <span style='color:#dc2626;font-weight:700;'>severe overallocation (&gt;150%)</span>. ", "")
			        & IF(_HasChronic,
			            "<b>" & FORMAT(_ChronicOver,"#,##0") & "</b> resource" & IF(_ChronicOver>1,"s are","is") & " chronically overallocated (3+ months &gt;100%), risking burnout. ", "")
			        & "<br/><b>Top concern" & IF(_OverallocRes>1,"s","") & ":</b> "
			        & _Top1Name & " (peak " & _Top1Peak & "%, " & FORMAT(_Top1Months,"0") & " month" & IF(_Top1Months>1,"s","") & " over)"
			        & IF(_OverallocRes >= 2, " &bull; " & _Top2Name & " (peak " & _Top2Peak & "%)", "")
			        & IF(_OverallocRes >= 3, " &bull; " & _Top3Name & " (peak " & _Top3Peak & "%)", "")
			& "  </div>
			</div>",
			    ""
			    )
			
			    // ─── Under-utilization Alert ───
			    & IF(_HasIdle || _HasUnderutilized,
			"
			<div style='padding:8px 12px;margin-bottom:8px;background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#92400E;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9679;</span> Utilization Gap
			  </div>
			  <div style='font-size:11px;color:#78350F;line-height:1.6;'>"
			        & IF(_HasIdle,
			            "<b>" & FORMAT(_IdleRes,"#,##0") & " resources</b> have zero allocation across all months — representing idle capacity. ", "")
			        & IF(_HasUnderutilized,
			            "<b>" & FORMAT(_UnderutilRes,"#,##0") & " resources</b> are under-utilized (peak allocation &lt;25% in every month). ", "")
			        & IF(_HasUnallocated,
			            "In total, <b>" & FORMAT(_UnallocRes,"#,##0") & "</b> of " & FORMAT(_TotalRes,"#,##0") & " resources have no committed demand at all. ", "")
			        & "This represents <b>" & FORMAT(DIVIDE(_IdleRes + _UnderutilRes, _TotalRes, 0)*100,"0.0") & "%</b> of the pool operating well below capacity."
			& "  </div>
			</div>",
			    ""
			    )
			
			    // ─── Time Off / Low Netto Alert ───
			    & IF(_HighTimeOff || _LowNetto,
			"
			<div style='padding:8px 12px;margin-bottom:8px;background:#EEF2FF;border:1px solid #C7D2FE;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#3730A3;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#128197;</span> Capacity Erosion
			  </div>
			  <div style='font-size:11px;color:#312E81;line-height:1.6;'>"
			        & IF(_HighTimeOff,
			            "Time-off accounts for <b>" & FORMAT(DIVIDE(_TimeOff,_Cap,0)*100,"0.0") & "%</b> of gross capacity (" & FORMAT(_TimeOff,"#,##0") & " hrs). This is above the 5% threshold and may impact delivery timelines. ", "")
			        & IF(_LowNetto,
			            "Net effective capacity is only <b>" & FORMAT(_NettoPct*100,"0.0") & "%</b> of gross — less than 30% remains for additional demand. Consider reviewing commitments or expanding the resource pool.", "")
			& "  </div>
			</div>",
			    ""
			    )
			
			// ─── SECTION 3: Recommendations ───
			& "
			<!-- ═══════ SECTION 3: Recommendations & Actions ═══════ -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:6px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9889;</span> Recommended Actions
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.7;'>"
			
			    // ─── Action 1: Overallocation ───
			    & IF(_HasOveralloc,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#dc2626;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>HIGH</span>"
			        & "<span><b>Redistribute overallocated demand</b> — Review resource plans for " & _Top1Name
			        & IF(_OverallocRes >= 2, " and " & FORMAT(_OverallocRes - 1, "#,##0") & " other" & IF(_OverallocRes>2,"s",""), "")
			        & ". Shift committed hours to resources in the 50-75% band or engage contractors for peak months."
			        & IF(_HasChronic, " <i>Priority:</i> Address chronic cases (" & FORMAT(_ChronicOver,"#,##0") & " with 3+ months over) first to prevent burnout risk.", "")
			        & "</span></div>", "")
			
			    // ─── Action 2: Idle resources ───
			    & IF(_HasIdle,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#d97706;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>MED</span>"
			        & "<span><b>Activate idle resources</b> — " & FORMAT(_IdleRes,"#,##0") & " resources have zero demand. Validate if these are active team members or stale records. Assign to projects with overallocated resources or upcoming forecast demand.</span></div>", "")
			
			    // ─── Action 3: Under-utilized ───
			    & IF(_HasUnderutilized,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#d97706;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>MED</span>"
			        & "<span><b>Increase utilization for under-used resources</b> — " & FORMAT(_UnderutilRes,"#,##0") & " resources never exceed 25% in any month. Review role assignments and cross-train for roles experiencing overallocation.</span></div>", "")
			
			    // ─── Action 4: Forecast gap ───
			    & IF(_HasFcstGap && _FcstVsCommitted > 0,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#7C3AED;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>PLAN</span>"
			        & "<span><b>Prepare for forecast demand surge</b> — Forecast exceeds committed by " & FORMAT(_FcstVsCommitted,"#,##0") & " hrs (+" & FORMAT(_FcstGapPct*100,"0") & "%). Begin resource sourcing or capacity planning now to avoid bottlenecks when forecast converts to committed.</span></div>", "")
			
			    & IF(_HasFcstGap && _FcstVsCommitted < 0,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#0891b2;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>INFO</span>"
			        & "<span><b>Forecast signals demand reduction</b> — Forecast is " & FORMAT(ABS(_FcstVsCommitted),"#,##0") & " hrs below committed (" & FORMAT(ABS(_FcstGapPct)*100,"0") & "% drop). Evaluate if committed plans should be adjusted or if resources can be redeployed.</span></div>", "")
			
			    // ─── Action 5: Time Off impact ───
			    & IF(_HighTimeOff,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#6366f1;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>INFO</span>"
			        & "<span><b>Factor time-off into sprint/project planning</b> — " & FORMAT(DIVIDE(_TimeOff,_Cap,0)*100,"0.0") & "% capacity lost to time-off. Cross-check peak leave periods against critical project milestones to avoid delivery gaps.</span></div>", "")
			
			    // ─── Action 6: Optimal band ───
			    & IF(_OptimalPct < 0.5,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#059669;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>GOAL</span>"
			        & "<span><b>Target 75-100% allocation band</b> — Only " & FORMAT(_OptimalPct*100,"0") & "% of resources are in the optimal band. Aim for &gt;50% to balance utilization with buffer for unplanned work. Current distribution suggests demand is either too concentrated or too sparse.</span></div>", "")
			
			    // ─── All clear state ───
			    & IF(NOT(_HasOveralloc) && NOT(_HasIdle) && NOT(_HasUnderutilized) && NOT(_HasFcstGap) && NOT(_HighTimeOff) && _OptimalPct >= 0.5,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#059669;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>OK</span>"
			        & "<span><b>Resource pool is well balanced.</b> No critical alerts. Continue monitoring for seasonal demand shifts and review forecast pipeline quarterly.</span></div>", "")
			
			& "  </div>
			</div>
			
			</div>"
			
			```
		displayFolder: Resource KPI
		lineageTag: d41a0009-288a-4b24-8217-ee2d0e4198d0

		changedProperty = IsHidden

	/// Source: Plans[Name].
	measure 'Resource KPI | Gantt Narrative HTML' = ```
			
			// ─── Guard: no project selected ───
			VAR _PlanName = SELECTEDVALUE(DimProject[Name])
			VAR _HasPlan  = NOT ISBLANK(_PlanName)
			
			// ─── Project Attributes ───
			VAR _Manager    = SELECTEDVALUE(DimProject[Manager_Value], "–")
			VAR _State      = SELECTEDVALUE(DimProject[State_Value], "–")
			VAR _Priority   = SELECTEDVALUE(DimProject[Priority_Value], "–")
			VAR _ProjType   = SELECTEDVALUE(DimProject[ProjectType_Value], "–")
			VAR _BizUnit    = SELECTEDVALUE(DimProject[BusinessUnit_Value], "–")
			VAR _EstStart   = SELECTEDVALUE(DimProject[EstimatedStart])
			VAR _EstEnd     = SELECTEDVALUE(DimProject[EstimatedEnd])
			VAR _PctDone    = SELECTEDVALUE(DimProject[Summary_PercentDone], 0) / 100
			VAR _Duration   = SELECTEDVALUE(DimProject[Summary_Duration], 0)
			
			// ─── Health Indicators ───
			VAR _OverallH   = SELECTEDVALUE(DimProject[OverallHealth_Value], "–")
			VAR _ScheduleH  = SELECTEDVALUE(DimProject[ScheduleHealth_Value], "–")
			VAR _FinanceH   = SELECTEDVALUE(DimProject[FinancialHealth_Value], "–")
			VAR _EffortH    = SELECTEDVALUE(DimProject[EffortHealth_Value], "–")
			VAR _IssueH     = SELECTEDVALUE(DimProject[IssueHealth_Value], "–")
			VAR _ScopeH     = SELECTEDVALUE(DimProject[ScopeHealth_Value], "–")
			
			// ─── Pre-compute health pill styles (avoids nested IF in strings) ───
			VAR _PillOverall =
			    IF(CONTAINSSTRING(_OverallH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_OverallH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_OverallH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			VAR _PillSchedule =
			    IF(CONTAINSSTRING(_ScheduleH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_ScheduleH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_ScheduleH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			VAR _PillFinance =
			    IF(CONTAINSSTRING(_FinanceH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_FinanceH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_FinanceH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			VAR _PillEffort =
			    IF(CONTAINSSTRING(_EffortH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_EffortH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_EffortH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			VAR _PillIssue =
			    IF(CONTAINSSTRING(_IssueH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_IssueH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_IssueH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			VAR _PillScope =
			    IF(CONTAINSSTRING(_ScopeH, "On Track"), "#DCFCE7;color:#166534",
			    IF(CONTAINSSTRING(_ScopeH, "At Risk"),  "#FEF3C7;color:#92400E",
			    IF(CONTAINSSTRING(_ScopeH, "Off Track"),"#FEE2E2;color:#991B1B",
			    "#F3F4F6;color:#6b7280")))
			
			// ─── Task Metrics ───
			VAR _Tasks       = [Task | Task Count]
			VAR _InProgress  = [Task | In Progress]
			VAR _Late        = [Task | Active Late Tasks]
			VAR _Overdue     = [Task | Overdue Tasks]
			VAR _OffTrack    = [Task | Off Track Tasks]
			VAR _NeedAttent  = _Late + _Overdue + _OffTrack
			VAR _PctAttent   = DIVIDE(_NeedAttent, _Tasks, 0)
			VAR _NotStarted  = SELECTEDVALUE(DimProject[NoofNotStartedTasks], 0)
			VAR _Milestones  = CALCULATE(COUNTROWS(DimTask), DimTask[Milestone] = TRUE())
			VAR _CritTasks   = CALCULATE(COUNTROWS(DimTask), DimTask[critical] = TRUE())
			
			// ─── Effort Metrics ───
			VAR _SchedEffort = [Task | Scheduled Effort]
			VAR _CommEffort  = [Task | Committed Effort]
			VAR _RemEffort   = [Project | Total RemainingEffort]
			VAR _EffortVar   = [Task | Effort Variance]
			
			// ─── Budget & Cost Metrics ───
			VAR _Budget      = [Project | Total Budget]
			VAR _Actuals     = [Project | Total ActualCost]
			VAR _BudgetVar   = [Project | Total BudgetVariance]
			VAR _BudgetUsed  = [Project | Total BudgetUsed]
			VAR _Forecast    = SELECTEDVALUE(DimProject[Forecast], 0)
			VAR _ETC         = [Project | ETC (€)]
			VAR _BudgetPct   = DIVIDE(_Actuals, _Budget, 0)
			VAR _BudgetRemain= _Budget - _Actuals
			
			// ─── Risks, Issues, Changes ───
			VAR _Risks       = [Project | Active Risks]
			VAR _Issues      = [Project | Active Issues]
			VAR _Changes     = [Project | Active Changes]
			VAR _TotalRIC    = _Risks + _Issues + _Changes
			
			// ─── Resource Allocation (project-level via FactResourcePlan) ───
			VAR _ProjCommHrs  = [Capacity | Total Hours Committed]
			VAR _ProjCapacity = [Capacity | Resource Capacity]
			VAR _ProjAllocPct = [Capacity | Resource Utilization%]
			VAR _AssignedRes  = CALCULATE(DISTINCTCOUNT(FactAssignment[UserId]))
			VAR _NeedsStaff   = SELECTEDVALUE(DimProject[NeedsStaffing], FALSE())
			
			// ─── Schedule Analysis ───
			VAR _DaysToEnd    = IF(NOT ISBLANK(_EstEnd), DATEDIFF(TODAY(), _EstEnd, DAY), BLANK())
			VAR _IsOverdue    = NOT ISBLANK(_DaysToEnd) && _DaysToEnd < 0
			VAR _DaysPast     = IF(_IsOverdue, ABS(_DaysToEnd), 0)
			VAR _TotalDuration= IF(NOT ISBLANK(_EstStart) && NOT ISBLANK(_EstEnd), DATEDIFF(_EstStart, _EstEnd, DAY), 0)
			VAR _Elapsed      = IF(NOT ISBLANK(_EstStart), MAX(DATEDIFF(_EstStart, TODAY(), DAY), 0), 0)
			VAR _TimePct      = DIVIDE(_Elapsed, _TotalDuration, 0)
			
			// ─── Baseline Drift ───
			VAR _BaseEffort   = SUM(DimTask[BaselineEffort])
			VAR _EffortDrift  = DIVIDE(_SchedEffort - _BaseEffort, _BaseEffort, 0)
			
			// ─── Health Color Mapping ───
			VAR _HealthColor =
			    SWITCH(TRUE(),
			        CONTAINSSTRING(_OverallH, "Off Track"), "#dc2626",
			        CONTAINSSTRING(_OverallH, "At Risk"), "#d97706",
			        CONTAINSSTRING(_OverallH, "On Track"), "#059669",
			        "#6b7280"
			    )
			
			// ─── Severity Assessment ───
			VAR _HasScheduleRisk = _IsOverdue || _Late > 0 || CONTAINSSTRING(_ScheduleH, "Off Track") || CONTAINSSTRING(_ScheduleH, "At Risk")
			VAR _HasBudgetRisk   = _BudgetPct > 0.9 || _BudgetVar < 0
			VAR _HasEffortRisk   = _EffortVar > 1.2 || _RemEffort > _SchedEffort * 0.5
			VAR _HasRICRisk      = _TotalRIC > 5
			VAR _HasStaffRisk    = _NeedsStaff || _AssignedRes = 0
			VAR _ProgressVsTime  = _PctDone - _TimePct
			VAR _BehindSchedule  = _ProgressVsTime < -0.15
			
			// ─── Task bar segment widths ───
			VAR _BarIP   = FORMAT(DIVIDE(_InProgress, _Tasks, 0) * 100, "0.0")
			VAR _BarLate = FORMAT(DIVIDE(_Late, _Tasks, 0) * 100, "0.0")
			VAR _BarOD   = FORMAT(DIVIDE(_Overdue, _Tasks, 0) * 100, "0.0")
			VAR _BarOT   = FORMAT(DIVIDE(_OffTrack, _Tasks, 0) * 100, "0.0")
			VAR _BarOK   = FORMAT(DIVIDE(_Tasks - _InProgress - _NeedAttent, _Tasks, 0) * 100, "0.0")
			
			// ─── Budget severity badge ───
			VAR _BudgetBadge = IF(_BudgetPct > 1, "CRIT", "HIGH")
			VAR _BudgetBadgeColor = IF(_BudgetPct > 1, "#dc2626", "#d97706")
			
			RETURN
			
			IF(NOT _HasPlan,
			
			"<div style='font-family:Segoe UI,sans-serif;padding:20px;text-align:center;'>
			  <div style='font-size:14px;color:#6b7280;'>Select a project to view the Gantt narrative and insights.</div>
			</div>",
			
			
			"<div style='font-family:Segoe UI,sans-serif;padding:8px;'>
			
			<!-- HEADER -->
			<div style='display:flex;align-items:center;gap:12px;margin-bottom:10px;padding:10px 14px;background:linear-gradient(135deg,#f8fafc,#f1f5f9);border-radius:10px;border-left:4px solid " & _HealthColor & ";'>
			  <div style='min-width:10px;height:10px;border-radius:50%;background:" & _HealthColor & ";'></div>
			  <div style='flex:1;'>
			    <div style='font-size:14px;font-weight:700;color:#111827;'>" & _PlanName & "</div>
			    <div style='font-size:10px;color:#6b7280;'>" & _ProjType & " &bull; " & _BizUnit & " &bull; Manager: " & _Manager & " &bull; State: " & _State & " &bull; Priority: " & _Priority & "</div>
			  </div>
			  <div style='text-align:right;'>
			    <div style='font-size:20px;font-weight:700;color:" & _HealthColor & ";'>" & FORMAT(_PctDone * 100, "0") & "%</div>
			    <div style='font-size:9px;color:#6b7280;'>complete</div>
			  </div>
			</div>
			
			<!-- HEALTH PILLS -->
			<div style='display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;'>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillOverall & ";'>Overall: " & _OverallH & "</span>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillSchedule & ";'>Schedule: " & _ScheduleH & "</span>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillFinance & ";'>Financial: " & _FinanceH & "</span>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillEffort & ";'>Effort: " & _EffortH & "</span>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillIssue & ";'>Issues: " & _IssueH & "</span>"
			  & "<span style='font-size:9px;padding:3px 8px;border-radius:12px;font-weight:600;background:" & _PillScope & ";'>Scope: " & _ScopeH & "</span>"
			& "
			</div>
			
			<!-- SCHEDULE ANALYSIS -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#128197;</span> Schedule Analysis
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			    & "The project spans from <b>" & FORMAT(_EstStart, "dd MMM yyyy") & "</b> to <b>" & FORMAT(_EstEnd, "dd MMM yyyy") & "</b>"
			    & " (" & FORMAT(_TotalDuration, "#,##0") & " days). "
			    & FORMAT(_TimePct * 100, "0") & "% of the timeline has elapsed while <b>" & FORMAT(_PctDone * 100, "0") & "%</b> of work is complete"
			    & IF(_BehindSchedule,
			        " — the project is <span style='color:#dc2626;font-weight:600;'>" & FORMAT(ABS(_ProgressVsTime) * 100, "0") & " percentage points behind schedule</span>. ",
			        IF(_ProgressVsTime > 0.1, " — the project is ahead of schedule. ", ". "))
			    & IF(_IsOverdue,
			        "<br/>&#9888; The project is <span style='color:#dc2626;font-weight:700;'>" & FORMAT(_DaysPast, "#,##0") & " days past its estimated end date</span>. ", "")
			    & IF(NOT ISBLANK(_DaysToEnd) && _DaysToEnd > 0 && _DaysToEnd <= 30,
			        "<br/>&#9888; Only <b>" & FORMAT(_DaysToEnd, "#,##0") & " days</b> remain until the estimated end date. ", "")
			
			& "  </div>
			</div>
			
			<!-- TASK BREAKDOWN -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9745;</span> Task Breakdown
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			    & "The project contains <b>" & FORMAT(_Tasks, "#,##0") & " tasks</b>"
			    & IF(_Milestones > 0, " including <b>" & FORMAT(_Milestones, "#,##0") & " milestones</b>", "") & ". "
			    & "<b>" & FORMAT(_InProgress, "#,##0") & "</b> are in progress"
			    & IF(_NotStarted > 0, ", <b>" & FORMAT(_NotStarted, "#,##0") & "</b> not yet started", "") & ". "
			
			    & IF(_NeedAttent > 0,
			        "<br/><span style='color:#dc2626;font-weight:600;'>" & FORMAT(_NeedAttent, "#,##0") & " tasks need attention</span> ("
			        & IF(_Late > 0, FORMAT(_Late, "#,##0") & " late", "")
			        & IF(_Late > 0 && _Overdue > 0, ", ", "")
			        & IF(_Overdue > 0, FORMAT(_Overdue, "#,##0") & " overdue", "")
			        & IF((_Late > 0 || _Overdue > 0) && _OffTrack > 0, ", ", "")
			        & IF(_OffTrack > 0, FORMAT(_OffTrack, "#,##0") & " off track", "")
			        & ") — representing <b>" & FORMAT(_PctAttent * 100, "0.0") & "%</b> of all tasks. ", "")
			
			    & IF(_CritTasks > 0,
			        "<b>" & FORMAT(_CritTasks, "#,##0") & " critical-path tasks</b> identified. ", "")
			
			    & "<div style='width:100%;height:8px;background:#f1f3f5;border-radius:4px;overflow:hidden;display:flex;margin-top:6px;'>"
			    & "<div style='width:" & _BarIP & "%;background:#0891b2;'></div>"
			    & "<div style='width:" & _BarLate & "%;background:#d97706;'></div>"
			    & "<div style='width:" & _BarOD & "%;background:#ea580c;'></div>"
			    & "<div style='width:" & _BarOT & "%;background:#dc2626;'></div>"
			    & "<div style='width:" & _BarOK & "%;background:#059669;'></div>"
			    & "</div>"
			
			& "  </div>
			</div>
			
			<!-- EFFORT & BUDGET -->
			<div style='display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;'>
			
			  <div style='padding:8px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			    <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			      <span style='font-size:14px;'>&#9201;</span> Effort
			    </div>
			    <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			      & "Scheduled: <b>" & FORMAT(_SchedEffort, "#,##0") & " hrs</b>. "
			      & "Committed: <b>" & FORMAT(_CommEffort, "#,##0") & " hrs</b>. "
			      & IF(_RemEffort > 0, "Remaining: <b>" & FORMAT(_RemEffort, "#,##0") & " hrs</b>. ", "")
			      & IF(_EffortVar > 1.1,
			          "<br/><span style='color:#dc2626;'>Effort variance: <b>" & FORMAT(_EffortVar * 100, "0") & "%</b> — committed exceeds scheduled by " & FORMAT((_EffortVar - 1) * 100, "0") & "%.</span>",
			          IF(_EffortVar < 0.9 && _EffortVar > 0,
			              "<br/><span style='color:#d97706;'>Committed is only <b>" & FORMAT(_EffortVar * 100, "0") & "%</b> of scheduled — potential under-resourcing.</span>",
			              ""
			          ))
			      & IF(ABS(_EffortDrift) > 0.15 && _BaseEffort > 0,
			          "<br/>Baseline drift: effort " & IF(_EffortDrift > 0, "grew", "shrank") & " by <b>" & FORMAT(ABS(_EffortDrift) * 100, "0") & "%</b> vs. baseline.", "")
			
			& "    </div>
			  </div>
			
			  <div style='padding:8px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			    <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			      <span style='font-size:14px;'>&#128176;</span> Budget
			    </div>
			    <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			      & IF(_Budget > 0,
			          "Budget: <b>" & FORMAT(_Budget, "#,##0") & "</b>. "
			          & "Actuals: <b>" & FORMAT(_Actuals, "#,##0") & "</b> (" & FORMAT(_BudgetPct * 100, "0") & "% consumed). "
			          & IF(_BudgetRemain > 0,
			              "Remaining: <b>" & FORMAT(_BudgetRemain, "#,##0") & "</b>. ",
			              "<span style='color:#dc2626;font-weight:600;'>Exceeded by " & FORMAT(ABS(_BudgetRemain), "#,##0") & ".</span> ")
			          & IF(_BudgetVar < 0,
			              "<br/><span style='color:#dc2626;'>Budget variance: <b>" & FORMAT(_BudgetVar, "#,##0") & "</b>.</span>", "")
			          & IF(_Forecast > 0,
			              "<br/>Forecast: <b>" & FORMAT(_Forecast, "#,##0") & "</b>. ETC: <b>" & FORMAT(_ETC, "#,##0") & "</b>.", ""),
			          "<span style='color:#6b7280;'>No budget defined.</span>"
			      )
			
			& "    </div>
			  </div>
			
			</div>
			
			<!-- RISKS, ISSUES & CHANGES -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9888;</span> Risks, Issues &amp; Changes
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			    & IF(_TotalRIC > 0,
			        "<b>" & FORMAT(_TotalRIC, "#,##0") & " active items</b>: "
			        & IF(_Risks > 0, "<span style='color:#dc2626;'>" & FORMAT(_Risks, "#,##0") & " risks</span>", "0 risks")
			        & " &bull; "
			        & IF(_Issues > 0, "<span style='color:#ea580c;'>" & FORMAT(_Issues, "#,##0") & " issues</span>", "0 issues")
			        & " &bull; "
			        & IF(_Changes > 0, "<span style='color:#d97706;'>" & FORMAT(_Changes, "#,##0") & " changes</span>", "0 changes")
			        & ". "
			        & IF(_TotalRIC > 10, "<br/>High volume of active items may impact delivery velocity. Consider triaging and resolving low-priority items.", ""),
			        "No active risks, issues or changes recorded."
			    )
			
			& "  </div>
			</div>
			
			<!-- PROJECT RESOURCING -->
			<div style='padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:4px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#128101;</span> Project Resourcing
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.6;'>"
			
			    & "<b>" & FORMAT(_AssignedRes, "#,##0") & " resources</b> assigned. "
			    & "Committed hours: <b>" & FORMAT(_ProjCommHrs, "#,##0") & "</b>. "
			    & IF(_ProjCapacity > 0,
			        "Allocation: <b>" & FORMAT(_ProjAllocPct * 100, "0.0") & "%</b> of available capacity. ", "")
			    & IF(_NeedsStaff,
			        "<br/><span style='color:#dc2626;font-weight:600;'>&#9888; Project flagged as needing staffing.</span> Review resource plan and assign.", "")
			    & IF(_AssignedRes = 0 && _Tasks > 0,
			        "<br/><span style='color:#d97706;'>No resources assigned despite " & FORMAT(_Tasks, "#,##0") & " tasks. Assignments may be missing.</span>", "")
			
			& "  </div>
			</div>
			
			<!-- RECOMMENDED ACTIONS -->
			<div style='padding:8px 12px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;'>
			  <div style='font-size:12px;font-weight:700;color:#111827;margin-bottom:6px;display:flex;align-items:center;gap:6px;'>
			    <span style='font-size:14px;'>&#9889;</span> Recommended Actions
			  </div>
			  <div style='font-size:11px;color:#374151;line-height:1.7;'>"
			
			    & IF(_IsOverdue,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#dc2626;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>CRIT</span>"
			        & "<span><b>Project is " & FORMAT(_DaysPast, "#,##0") & " days overdue</b> — Conduct a schedule recovery workshop. Re-baseline, reassess scope, and negotiate revised dates with stakeholders.</span></div>", "")
			
			    & IF(_BehindSchedule && NOT _IsOverdue,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#dc2626;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>HIGH</span>"
			        & "<span><b>Progress behind timeline</b> — " & FORMAT(_PctDone * 100, "0") & "% done vs " & FORMAT(_TimePct * 100, "0") & "% elapsed. Identify blockers on critical-path tasks. Consider fast-tracking or crashing.</span></div>", "")
			
			    & IF(_NeedAttent > 0,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#dc2626;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>HIGH</span>"
			        & "<span><b>Address " & FORMAT(_NeedAttent, "#,##0") & " tasks needing attention</b> — Prioritize late and off-track tasks. Reassign resources or negotiate scope reduction.</span></div>", "")
			
			    & IF(_HasBudgetRisk && _Budget > 0,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:" & _BudgetBadgeColor & ";color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>" & _BudgetBadge & "</span>"
			        & "<span><b>Budget " & IF(_BudgetPct > 1, "exceeded", "at " & FORMAT(_BudgetPct * 100, "0") & "% utilization") & "</b> — "
			        & IF(_BudgetPct > 1, "Actuals exceed budget by " & FORMAT(ABS(_BudgetRemain), "#,##0") & ". ", "Only " & FORMAT(_BudgetRemain, "#,##0") & " remains. ")
			        & "Review remaining scope or request a budget change order.</span></div>", "")
			
			    & IF(_HasEffortRisk,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#d97706;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>MED</span>"
			        & "<span><b>Effort variance detected</b> — "
			        & IF(_EffortVar > 1.1,
			            "Committed exceeds scheduled by " & FORMAT((_EffortVar - 1) * 100, "0") & "%. Validate scope additions.",
			            "Remaining effort (" & FORMAT(_RemEffort, "#,##0") & " hrs) is high. Check estimates.")
			        & "</span></div>", "")
			
			    & IF(_HasRICRisk,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#d97706;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>MED</span>"
			        & "<span><b>High RIC volume (" & FORMAT(_TotalRIC, "#,##0") & " items)</b> — Triage session needed. Close resolved items, escalate blockers, ensure risk mitigations are in place.</span></div>", "")
			
			    & IF(_HasStaffRisk,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#7C3AED;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>PLAN</span>"
			        & "<span><b>" & IF(_NeedsStaff, "Project needs staffing", "No resources assigned") & "</b> — Engage resource managers to fill open positions from the available pool.</span></div>", "")
			
			    & IF(NOT ISBLANK(_DaysToEnd) && _DaysToEnd > 0 && _DaysToEnd <= 30 && NOT _IsOverdue && NOT _BehindSchedule,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#0891b2;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>INFO</span>"
			        & "<span><b>" & FORMAT(_DaysToEnd, "#,##0") & " days to end date</b> — Ensure remaining tasks have owners and no open dependencies. Prepare closure checklist.</span></div>", "")
			
			    & IF(NOT _IsOverdue && NOT _BehindSchedule && _NeedAttent = 0 && NOT _HasBudgetRisk && NOT _HasEffortRisk && NOT _HasRICRisk && NOT _HasStaffRisk,
			        "<div style='display:flex;gap:6px;align-items:flex-start;margin-bottom:4px;'>"
			        & "<span style='background:#059669;color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;margin-top:1px;'>OK</span>"
			        & "<span><b>Project is on track.</b> No critical alerts. Continue monitoring progress and upcoming milestones.</span></div>", "")
			
			& "  </div>
			</div>
			
			</div>"
			)
			
			```
		displayFolder: Resource KPI
		lineageTag: 8f174cac-d161-48c8-8fb8-36ade3b73ca7

		changedProperty = IsHidden

	/// Subject area: Capacity.
	measure 'Capacity | Resource Utilization%' = DIVIDE([Capacity | Total Hours Scheduled],[Capacity | Resource Capacity],0)
		formatString: #,##0.00 %
		displayFolder: Capacity
		lineageTag: 4e6c0e6c-8082-4230-b4b6-281820878979

		changedProperty = IsHidden

	/// Source: Calendar[Period].
	measure 'Capacity | Resource Active Months' =
			COUNTROWS(
			        FILTER(
			            VALUES(DimDate[Period]),
			            CALCULATE( [Capacity | Total Hours Scheduled]) > 0
			        )
			    )
		displayFolder: Capacity
		lineageTag: 0358c6cc-6891-4955-9788-d70e43359eae

		changedProperty = IsHidden

	/// Source: Calendar[Period].
	measure 'Capacity | Resource Idle Months' = ```
			    COUNTROWS(
			        FILTER(
			            VALUES(DimDate[Period]),
			            CALCULATE( [Capacity | Total Hours Scheduled]) = 0
			        )
			    )
			```
		displayFolder: Capacity
		lineageTag: 1a9bf8f9-3124-4491-a3dc-a7addca38c5c

		changedProperty = IsHidden

	/// Source: Calendar[Period].
	measure 'Capacity | Peak Allocation Month' = ```
			    MAXX(
			        ADDCOLUMNS(
			            VALUES(DimDate[Period]),
			            "@Util", CALCULATE([Capacity | Resource Utilization%])
			        ),
			        [@Util]
			    )
			```
		displayFolder: Capacity
		lineageTag: 987efd0e-1618-476a-a96e-fa3f7aa03a3f

		changedProperty = IsHidden

	/// Source: Calendar[Period].
	measure 'Capacity | Peak Allocation Month Name' =
			VAR _maxUtil = [Capacity | Peak Allocation Month]
			    RETURN
			        MAXX(
			            FILTER(
