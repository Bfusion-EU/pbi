	/// Scenario Radar. Source: ModelerScenario[TotalBudget].
	measure 'Modeler | Scenario Metric Value' = ```
			
			VAR _metric = SELECTEDVALUE ( '_Modeler_Metrics'[MetricName] )
			RETURN
			    SWITCH (
			        _metric,
			        "Budget",              SUM ( DimScenario[TotalBudget] ),
			        "Benefits",            SUM ( DimScenario[TotalBenefits] ),
			        "Committed Effort",    SUM ( DimScenario[TotalCommittedEffort] ),
			        "Selected Plans",      SUM ( DimScenario[TotalCheckedPlans] ),
			        "Budget Utilization %",
			            DIVIDE (
			                SUM ( DimScenario[TotalBudget] ),
			                SUM ( DimScenario[TargetBudget] ),
			                0
			            ) * 100,
			        BLANK ()
			    )
			
