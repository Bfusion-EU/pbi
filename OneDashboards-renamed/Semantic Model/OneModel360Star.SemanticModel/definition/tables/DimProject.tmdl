	partition DimProject = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="Plans", Signature="table"]}[Data],
				    Filtered = Table.SelectRows(Raw, each
				        let pt = Text.Upper(Text.Trim([PlanType] ?? "")) in pt = "PROJECT"),
				    Keyed = Table.AddIndexColumn(Filtered, "ProjectKey", 1, 1, Int64.Type),
				    AddBK = Table.AddColumn(Keyed, "ProjectBK", each [Id], type text)
				in
				    AddBK

	annotation PBI_ResultType = Table

