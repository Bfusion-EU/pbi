	partition DimProjectsAll = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="Plans", Signature="table"]}[Data],
				    Filtered = Table.SelectRows(Raw, each
				        let pt = Text.Upper(Text.Trim([PlanType] ?? "")) in pt <> "PORTFOLIO" and pt <> "PROGRAM"),
				    Keyed = Table.AddIndexColumn(Filtered, "ProjectAllKey", 1, 1, Int64.Type),
				    AddBK = Table.AddColumn(Keyed, "ProjectAllBK", each [Id], type text)
				in
				    AddBK

