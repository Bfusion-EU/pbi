		sourceColumn: Weekday

	column 'Weekday Name'
		dataType: string
		lineageTag: c0c8a431-bbf1-449e-818d-675c7c356ecb
		sourceColumn: Weekday Name

	column 'Is Weekend'
		dataType: boolean
		lineageTag: cbb9b457-2a9d-4ec8-8287-28c8a805f9c5
		sourceColumn: Is Weekend

	column Index
		dataType: int64
		lineageTag: 15f78c56-dbc5-4bbe-ad13-4b2d469558e3
		sourceColumn: Index

	partition DimDate = m
		source =
				let
				    Today_ = Date.From(DateTime.LocalNow()),
				    Start = #date(Date.Year(Today_) - 3, 1, 1),
				    End   = #date(Date.Year(Today_) + 5, 12, 31),
				    Dates = List.Dates(Start, Number.From(End - Start) + 1, #duration(1, 0, 0, 0)),
				    T0  = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    T1  = Table.TransformColumnTypes(T0, {{"Date", type date}}),
				    T2  = Table.AddColumn(T1,  "DateKey",       each Date.Year([Date])*10000 + Date.Month([Date])*100 + Date.Day([Date]), Int64.Type),
				    T3  = Table.AddColumn(T2,  "Year",          each Date.Year([Date]), Int64.Type),
				    T4  = Table.AddColumn(T3,  "Quarter",       each Date.QuarterOfYear([Date]), Int64.Type),
				    T5  = Table.AddColumn(T4,  "Month",         each Date.Month([Date]), Int64.Type),
				    T6  = Table.AddColumn(T5,  "Day",           each Date.Day([Date]), Int64.Type),
				    T7  = Table.AddColumn(T6,  "YearMonth",     each Date.Year([Date])*100 + Date.Month([Date]), Int64.Type),
				    T8  = Table.AddColumn(T7,  "MonthName",     each Date.ToText([Date], "MMMM", "en-US"), type text),
				    T9  = Table.AddColumn(T8,  "DayName",       each Date.ToText([Date], "dddd", "en-US"), type text),
				    T10 = Table.AddColumn(T9,  "WeekOfYear",    each Date.WeekOfYear([Date]), Int64.Type),
				    T11 = Table.AddColumn(T10, "IsWeekend",     each Date.DayOfWeek([Date], Day.Monday) >= 5, type logical),
				    T12 = Table.AddColumn(T11, "IsBusinessDay", each not [IsWeekend], type logical),
				    T13 = Table.AddColumn(T12, "FiscalYear",    each Date.Year([Date]), Int64.Type),
				    T14 = Table.AddColumn(T13, "FiscalQuarter", each Date.QuarterOfYear([Date]), Int64.Type),
				    T15 = Table.AddColumn(T14, "FiscalMonth",   each Date.Month([Date]), Int64.Type),
				    T16 = Table.AddColumn(T15, "RelativeMonth", each (Date.Year([Date]) - Date.Year(Today_))*12 + (Date.Month([Date]) - Date.Month(Today_)), Int64.Type),
				    // Legacy Calendar compat
				    T17 = Table.AddColumn(T16, "Today",         each Today_, type date),
				    T18 = Table.AddColumn(T17, "MonthCounter",  each [Year]*100 + [Month], Int64.Type),
				    T19 = Table.AddColumn(T18, "Period",        each Date.ToText([Date], "MMM-yy", "en-US"), type text),
				    T20 = Table.AddColumn(T19, "Quarter Name",  each "Q" & Number.ToText([Quarter]), type text),
				    T21 = Table.AddColumn(T20, "Week Number",   each [WeekOfYear], Int64.Type),
				    T22 = Table.AddColumn(T21, "Weekday",       each Date.DayOfWeek([Date]) + 1, Int64.Type),
				    T23 = Table.AddColumn(T22, "Weekday Name",  each [DayName], type text),
				    T24 = Table.AddColumn(T23, "Is Weekend",    each [IsWeekend], type logical),
				    T25 = Table.AddIndexColumn(T24, "Index", 0, 1, Int64.Type)
				in
				    T25

