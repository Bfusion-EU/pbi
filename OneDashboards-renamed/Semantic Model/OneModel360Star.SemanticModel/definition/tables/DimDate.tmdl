table DimDate
	lineageTag: 03ec2b07-8d60-4829-8f98-130c7887e976
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 7910bd08-c29d-4ad5-87d8-7b0bdae19f4b
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column DateKey
		dataType: int64
		isHidden
		lineageTag: fb48d2ed-5e59-4fd2-87b6-afc89a83ff6c
		summarizeBy: none
		sourceColumn: DateKey

	column Year
