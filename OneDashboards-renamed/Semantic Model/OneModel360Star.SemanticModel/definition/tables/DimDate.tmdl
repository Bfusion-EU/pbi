	column Today
		dataType: dateTime
		formatString: Long Date
		lineageTag: 45520e78-78a5-46e3-89d6-c0c961399f32
		summarizeBy: none
		sourceColumn: Today

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column MonthCounter
		dataType: int64
		lineageTag: 76465238-5d5f-4a10-91ea-501e3922b7ed
		sourceColumn: MonthCounter

	column Period
		dataType: string
		lineageTag: ba30ba53-00dc-47d0-8c52-ee54941cc085
		sourceColumn: Period

	column 'Quarter Name'
		dataType: string
		lineageTag: dedb35c8-b369-4d62-8a44-2db2c27a0fcc
		sourceColumn: Quarter Name

	column 'Week Number'
		dataType: int64
		lineageTag: 71063ac3-7b15-4771-a00f-67bad7e180ee
		sourceColumn: Week Number

	column Weekday
		dataType: int64
