		annotation SummarizationSetBy = Automatic

	partition DimTask = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="Tasks", Signature="table"]}[Data],
				    Typed = Table.TransformColumnTypes(Raw,
				        {{"Created", type date},{"Modified", type date},{"StartDate", type date},{"EndDate", type date}},
				        "en-US"),
				    Cleaned = Table.RemoveColumns(Typed, {"WorkTypeId", "ModifiedBy", "CreatedBy"}, MissingField.Ignore),
				    Keyed = Table.AddIndexColumn(Cleaned, "TaskKey", 1, 1, Int64.Type),
				    AddBK = Table.AddColumn(Keyed, "TaskBK", each [Id], type text),
				    DimP = DimProject,
				    J1 = Table.NestedJoin(AddBK, {"PlanId"}, DimP, {"ProjectBK"}, "_P", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "_P", {"ProjectKey"}, {"ProjectKey"})
				in
				    E1

	annotation PBI_ResultType = Table

