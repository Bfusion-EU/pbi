	column 'Overdue Tasks' = IF(DimTask[EndDate]<TODAY(),[Task | Task Count])
		displayFolder: Values
		lineageTag: 10de9fb4-2a0f-48f9-a486-0116e5b57f82
		summarizeBy: sum

	column 'Probability Category' =
			SWITCH(
			    TRUE(),
			    DimTask[Probability] >= 75, "(1) Critical",
			    DimTask[Probability] >= 50, "(2) High",
			    DimTask[Probability] >= 25, "(3) Medium",
			    "(4) Low"
			)
		lineageTag: ae300fd7-dab7-49c0-ae60-1196c1994c01
		summarizeBy: none

	column ParentName = LOOKUPVALUE ( DimTask[Name], DimTask[Id], DimTask[ParentTaskId] )
		displayFolder: Attributes
		lineageTag: 46bb932f-1b28-48d7-9ccc-d77c18b4507e

	column Predecessors =
			CONCATENATEX(
			    FILTER( BridgeTaskDependency, BridgeTaskDependency[To] = DimTask[Id] ),
			    BridgeTaskDependency[From],
			    ","
			)
		lineageTag: 2bb0a4c0-173a-4b3f-95c3-46a77696b341

	column PredecessorTypes =
			CONCATENATEX(
			    FILTER( BridgeTaskDependency, BridgeTaskDependency[To] = DimTask[Id] ),
			    BridgeTaskDependency[From] & ":" & BridgeTaskDependency[Type],
			    ","
			)
		lineageTag: 004044be-e0c7-4d72-8ad2-5531d2d88169

	column 'Slack (days)' = ```
			VAR CurrentEnd = DimTask[EndDate]
			VAR CurrentId = DimTask[id]
			VAR SuccessorMinStart = 
			    MINX(
			        FILTER(BridgeTaskDependency, BridgeTaskDependency[From] = CurrentId),
			        VAR SuccId = BridgeTaskDependency[To]
			        RETURN LOOKUPVALUE(DimTask[StartDate], DimTask[id], SuccId)
			    )
			RETURN
			    IF(
			        ISBLANK(SuccessorMinStart),
			        BLANK(),
			        MAX(0, DATEDIFF(CurrentEnd, SuccessorMinStart, DAY))
			    )
			```
		lineageTag: cf934aa4-2f22-4ccc-bac1-6a133a30f2a5

