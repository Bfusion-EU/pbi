	partition FactStatusReport = m
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    Raw = Source{[Name="StatusReports", Signature="table"]}[Data],
				    Typed = Table.TransformColumnTypes(Raw,
				        {{"Report_ReportStart", type date},{"Report_ReportEnd", type date},{"EstimatedStart", type date},{"EstimatedEnd", type date}}, "en-US"),
				    DimP = DimProject, DimR = DimResource, DimS = DimStatusType,
				    J1 = Table.NestedJoin(Typed, {"Report_WorkPlanId"}, DimP, {"ProjectBK"}, "_P", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "_P", {"ProjectKey"}, {"ProjectKey"}),
				    J2 = Table.NestedJoin(E1, {"Manager"}, DimR, {"ResourceBK"}, "_R", JoinKind.LeftOuter),
				    E2 = Table.ExpandTableColumn(J2, "_R", {"ResourceKey"}, {"ManagerResourceKey"}),
				    J3 = Table.NestedJoin(E2, {"ScheduleHealth"}, DimS, {"StatusCode"}, "_S", JoinKind.LeftOuter),
				    E3 = Table.ExpandTableColumn(J3, "_S", {"StatusTypeKey"}, {"StatusTypeKey"}),
				    AddEnd = Table.AddColumn(E3, "ReportEndKey",   each Date.Year([Report_ReportEnd])*10000 + Date.Month([Report_ReportEnd])*100 + Date.Day([Report_ReportEnd]), Int64.Type),
				    AddSt  = Table.AddColumn(AddEnd, "ReportStartKey", each Date.Year([Report_ReportStart])*10000 + Date.Month([Report_ReportStart])*100 + Date.Day([Report_ReportStart]), Int64.Type)
				in
				    AddSt

