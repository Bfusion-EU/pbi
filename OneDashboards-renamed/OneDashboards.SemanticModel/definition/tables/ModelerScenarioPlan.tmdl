		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ModelerScenarioPlan = m
		mode: import
		queryGroup: 'Portfolio Modeler'
		source =
				let
				    Source = OData.Feed(OnePlanURL, null, [Implementation="2.0"]),
				    ModelerScenarioPlan_table = Source{[Name="ModelerScenarioPlan",Signature="table"]}[Data]
				in
				    ModelerScenarioPlan_table

	annotation PBI_NavigationStepName = Navigation

