table ModelerScenarioPlan
	lineageTag: f2a770fb-ea7a-461e-89b0-1ea4bc7b895c

	/// Returns 1 if the current project (Plans[Name] context) is part of the current scenario (ModelerScenario[Name] context), else 0. Bind to the Scenario Membership data role on the Efficient Frontier visual (project-mode).
	measure 'Modeler | Membership 1' = VAR _proj = SELECTEDVALUE ( Plans[Name] ) VAR _scn  = SELECTEDVALUE ( ModelerScenario[Name] ) RETURN     IF (         NOT ISBLANK ( _proj ) && NOT ISBLANK ( _scn )             && CALCULATE (                 COUNTROWS ( ModelerScenarioPlan ),                 ModelerScenarioPlan[Name] = _proj,                 ModelerScenarioPlan[Checked] = TRUE ()             ) > 0,         1, 0     )
		formatString: 0
		displayFolder: Modeler | Efficient Frontier
		lineageTag: c079312d-c6d2-4a41-87f2-22d0efd92919

	column id
		dataType: string
		displayFolder: Attributes\Identity
		lineageTag: 2cc43e98-53c4-4f82-8efa-c4b3356304e7
		summarizeBy: none
		sourceColumn: id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column ParentScenarioId
