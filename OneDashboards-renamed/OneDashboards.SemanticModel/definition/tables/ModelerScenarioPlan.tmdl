		sourceColumn: Checked

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Priority
		dataType: double
		displayFolder: Values\Misc
		lineageTag: 24ca2ecd-dc6c-4967-82e0-d61aa96a12f0
