	partition StatusReports = m
		mode: import
		queryGroup: Status
		source =
				let
				
				    // Connect to OData source
				    Source = OData.Feed(OnePlanURL, null, [Implementation = "2.0"]),
				
				    // Get StatusReports table
				    StatusReports_table = Source{[Name = "StatusReports", Signature = "table"]}[Data],
				    // Convert selected columns to date type
				    #"Changed Type" = Table.TransformColumnTypes(
				        StatusReports_table,
				        {
				            {"Report_ReportStart", type date},
				            {"Report_ReportEnd", type date},
				            {"EstimatedStart", type date},
				            {"EstimatedEnd", type date}
				        }
				    )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

